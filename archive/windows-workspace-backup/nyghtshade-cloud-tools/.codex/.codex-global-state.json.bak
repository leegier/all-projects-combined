"type":"number","description":"Cents per 1 credit; widget multiplies for the live credits→USD preview."},"currency":{"type":"string"},"top_up_url":{"type":"string","description":"BE-built deeplink to the fnf-web team buy-credits modal. Widget appends ?credits= / ?dollars= for preselection."},"auto_refill_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"BE-built deeplink to the fnf-web team auto-refill modal. Widget appends ?threshold= / ?refill_amount= for preselection. Null when BE signals the auto-refill subtab should be hidden (e.g. already enabled)."},"min_dollars":{"type":"number"},"max_dollars":{"type":"number"},"quick_select_credits":{"type":"array","items":{"type":"number"}},"quick_select_dollars":{"type":"array","items":{"type":"number"}},"auto_refill_threshold":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":{}},"auto_refill_amount":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":{}},"quick_select_threshold_credits":{"type":"array","items":{"type":"number"}},"quick_select_refill_credits":{"type":"array","items":{"type":"number"}},"workspace_id":{"type":"string"},"workspace_name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["price_per_credit_cents","currency","top_up_url","auto_refill_url","min_dollars","max_dollars","quick_select_credits","quick_select_dollars","auto_refill_threshold","auto_refill_amount","quick_select_threshold_credits","quick_select_refill_credits","workspace_id","workspace_name"],"additionalProperties":{}},"team_member":{"description":"Team-member context: read-only workspace metadata. Only present when workspace_kind=team_member.","type":"object","properties":{"workspace_name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["workspace_name"],"additionalProperties":{}},"unlim_trial_in_mcp_active":{"description":"Presentation-only gate derived from the trial `kind` (offer or existing trial). False/absent keeps every legacy widget branch.","type":"boolean"},"free_trial":{"description":"Free trial offer (see `kind` for what it starts). Present ⇔ the user is eligible. When absent, do NOT speculate about why — keep copy neutral (never mention eligibility, fraud, or abuse checks).","type":"object","properties":{"kind":{"description":"What the card's checkout starts: 'mcp' (legacy 3-day/100-credit trial), 'mcp_all_unlim' (1-day unlimited-generations trial), etc. Open list — unknown values render as a generic trial.","anyOf":[{"type":"string"},{"type":"null"}]},"plan_type":{"type":"string","description":"Plan the trial converts into (plus)."},"billing_period":{"type":"string","enum":["monthly","annual"],"description":"Billing period of the post-trial subscription."},"unlim_trial_in_mcp_active":{"description":"Presentation-only gate derived from the offer's `kind` — true for unlimited-generation kinds. False/absent keeps the legacy trial card.","type":"boolean"},"trial_days":{"type":"number","description":"Trial length in days — derived from `kind` on the BE; never hardcode."},"trial_credits":{"type":"number","description":"Credits granted for the trial. 0 is valid for unlimited kinds (their value is the unlim entitlement, not credits)."},"then_price_cents":{"type":"number","description":"Price auto-charged to the saved card after the trial unless cancelled."},"currency":{"description":"ISO currency code (usd/eur/gbp) for then_price_cents; absent means USD.","type":"string"},"checkout_url":{"type":"string","description":"Hosted $0 checkout URL (card required). Relay this exact link in text-only clients."},"headline":{"type":"string","description":"Trial card title, e.g. '3-Day Free Plus Trial'."},"tagline":{"type":"string"},"credits_line":{"type":"string","description":"e.g. '100 credits for 3 days'."},"credit_equivalents":{"type":"array","items":{"type":"string"},"description":"STATIC marketing approximations ('= 50 Nano Banana Pro images'), not API data."},"price_line":{"type":"string","description":"e.g. '$0 for 3 days, then renews at $49/mo'."},"cta_label":{"type":"string"},"renewal_caption":{"type":"string","description":"Caption under the CTA, e.g. 'Renews to Plus ($49/mo) after 3-day trial'."},"compliance_note":{"type":"string","description":"Full trial disclosures: MCP-only, credits never appear on higgsfield.ai, auto-charge after the trial unless cancelled, how to cancel, exclusions. Always relay in text-only clients."}},"required":["plan_type","billing_period","trial_days","trial_credits","then_price_cents","checkout_url","headline","tagline","credits_line","credit_equivalents","price_line","cta_label","renewal_caption","compliance_note"],"additionalProperties":{}},"trial_status":{"description":"Current MCP free-trial state, when the status endpoint responded.","type":"object","properties":{"eligible":{"type":"boolean","description":"True when the user can still start the trial."},"status":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Trial lifecycle state, e.g. 'active'. Null when the user never interacted with the trial."},"kind":{"description":"Kind of the trial the user ALREADY has ('mcp', 'mcp_all_unlim', …). Null when there is no trial.","anyOf":[{"type":"string"},{"type":"null"}]},"offered_kind":{"description":"Kind the user WOULD get by starting the offered trial. Non-null only while eligible.","anyOf":[{"type":"string"},{"type":"null"}]},"trial_ends_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"ISO timestamp when the trial ends / the saved card is auto-charged."},"trial_credits":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Remaining MCP-only trial credits. Null when no trial was ever started."}},"required":["eligible","status","trial_ends_at","trial_credits"],"additionalProperties":{}},"initial_view":{"description":"Layout the widget opens with: plans (Plus/Ultra grid, plus the trial section when free_trial is present), trial (standalone trial card), trial_upgrade (trial credits exhausted — upgrade view).","type":"string","enum":["plans","trial","trial_upgrade"]},"plan_comparison":{"description":"STATIC Free/Plus/Ultra comparison table for the trial-exhausted view.","type":"object","properties":{"columns":{"type":"array","items":{"type":"string"}},"recommended_plan":{"type":"string","enum":["plus","ultra"],"description":"Column visually highlighted in the widget."},"rows":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"free":{"anyOf":[{"type":"string"},{"type":"boolean"}]},"plus":{"anyOf":[{"type":"string"},{"type":"boolean"}]},"ultra":{"anyOf":[{"type":"string"},{"type":"boolean"}]}},"required":["label","free","plus","ultra"],"additionalProperties":{}},"description":"true renders as a checkmark, false as a dash, strings verbatim."},"static_content":{"type":"boolean","const":true,"description":"Marker: rows are hardcoded marketing content mirroring the approved designs, NOT served by the pricing API."}},"required":["columns","recommended_plan","rows","static_content"],"additionalProperties":{}},"trial_purchase_link":{"description":"Direct $0 trial checkout link, when the user is eligible.","type":"object","properties":{"kind":{"type":"string","enum":["plan_monthly","plan_annual","credit_topup","auto_refill","team_top_up","team_auto_refill","free_trial"],"description":"Purchase path this link completes. team_top_up / team_auto_refill deeplink to the team-plan modals on fnf-web (only present when workspace_kind=team_owner). free_trial opens the $0 hosted checkout for the 3-day MCP Plus trial (card required; auto-renews unless cancelled)."},"label":{"type":"string","description":"Human-readable link label to show to the user."},"url":{"type":"string","description":"Direct checkout/setup URL. If present, show this exact link to users in clients that do not render widgets."},"price_cents":{"description":"Final checkout price in cents, when known.","type":"number"},"original_price_cents":{"description":"Original price in cents before discount, when known.","anyOf":[{"type":"number"},{"type":"null"}]},"currency":{"description":"ISO currency code (usd/eur/gbp) for the *_cents fields; absent means USD. Format displayed prices with the matching symbol ($/€/£).","type":"string"},"credits":{"description":"Credits included by this purchase, when applicable.","type":"number"},"discount_percent":{"description":"Displayed discount percent, when applicable.","anyOf":[{"type":"number"},{"type":"null"}]},"recommended":{"description":"True when this is the preferred or most popular checkout option.","type":"boolean"},"description":{"description":"Short promotional/context text for the purchase option.","type":"string"}},"required":["kind","label","url"],"additionalProperties":{}},"sales_headline":{"description":"Personalized seller-style headline that explains the recommended purchase path.","type":"string"},"recommendation_reason":{"description":"Short rationale for why this offer is being shown for the user's current plan/eligibility.","type":"string"},"primary_cta_text":{"description":"Action-oriented CTA label for the primary purchase link.","type":"string"},"assistant_response":{"description":"Ready-to-send promoter-style purchase response with checkout URLs formatted as action-specific Markdown links, e.g. [Go to Checkout](url), [Higgsfield Upgrade](url), [Higgsfield Credit Top-up](url), or [Higgsfield Auto-refill](url). Agents should relay this in text-only clients or when the widget location is unclear.","type":"string"},"error":{"type":"string"},"request_id":{"description":"MCP server HTTP request ID for support/debugging.","type":"string"}},"additionalProperties":false},"analytics":{"type":"object","properties":{"token":{"type":"string"},"host":{"type":"string"},"userId":{"type":"string"},"environment":{"type":"string"},"profile":{"type":"string"}},"required":["token","host","environment","profile"],"additionalProperties":false}},"required":["queued"],"additionalProperties":false}},{"name":"higgsfield.ai_influencer_generate","title":"AI Influencer: Generate Character Sheet","description":"Generate and save one to four AI Influencer character sheets in the selected Higgsfield workspace from exact params returned by ai_influencer_prepare. Does not train a Soul or generate video. Rechecks price before submission and rejects paid prices above max_credits. Paid generation spends existing credits; it does not purchase credits or subscriptions. use_free_gens=true requires explicit user intent and backend eligibility, with max_credits=0 for free-only requests; never falls back to paid generation. Returns job_id for the first accepted job and job_ids for a batch before completion; wait for every returned job. Free generations always submit one sheet. Repeating this call can create another job and spend credits again; never automatically retry an uncertain submission. An auto-updating generation widget shows every accepted sheet and its progress. Wait with jobs_wait (timeout_seconds <= 15); do not call show_generation_by_ids or job_display again unless the user requests a separate display. After completion, offer Genjutsu animation and wait for agreement before opening motion presets. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]},"selection":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"maxItems":4,"type":"array","items":{"type":"string"}}},"brief":{"type":"string","maxLength":4000},"medias":{"maxItems":1,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}},"item_medias":{"maxItems":3,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}},"batch_size":{"type":"integer","minimum":1,"maximum":4},"seed":{"type":"integer","minimum":1,"maximum":1000000},"body_color":{"type":"string","pattern":"^#[\\dA-F]{6}$"},"animal_variant":{"oneOf":[{"type":"object","properties":{"version":{"type":"string","const":"animals-v1"},"tier":{"type":"string","enum":["insects","frogs","cats","dogs","capybaras","birds"]},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"look":{"type":"null"}},"required":["version","tier","id"],"additionalProperties":false},{"type":"object","properties":{"version":{"type":"string","const":"animals-v3"},"tier":{"type":"string","enum":["insects","frogs","cats","dogs","capybaras","birds"]},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"look":{"type":"object","properties":{"form":{"type":"string","minLength":1,"maxLength":20000},"hair":{"type":"string","minLength":1,"maxLength":20000},"build":{"type":"string","minLength":1,"maxLength":20000},"height":{"type":"string","minLength":1,"maxLength":20000},"proportions":{"type":"string","minLength":1,"maxLength":20000},"gender":{"type":"string","enum":["male","female","non_binary"]},"aesthetic":{"type":"string","enum":["casual","sporty","streetstyle","y2k","retro","goth","theatrical","suits"]}},"required":["form","hair","build","height","proportions","gender","aesthetic"],"additionalProperties":false}},"required":["version","tier","id","look"],"additionalProperties":false}]},"trait_variants":{"type":"object","properties":{"version":{"type":"string","const":"appearance-v2"},"choices":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string","enum":["original","v1","v2","v3","v4","v5"]},{"type":"string","enum":["v1","v2","v3","v4","v5","v6","v7","v8","v9","v10"]}]}},"animal_choices":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"integer","minimum":0,"maximum":4}},{"type":"null"}]}},"required":["version","choices"],"additionalProperties":false}},"required":["tier","selection","brief","medias"]},"max_credits":{"type":"number","minimum":0},"use_free_gens":{"type":"boolean"}},"required":["params","max_credits"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-v2.html","ui":{"resourceUri":"ui://higgsfield/generation-v2.html"},"resource_name":"higgsfield.ai_influencer_generate","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_generate","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"type":"object","properties":{"submitted":{"type":"boolean","const":false},"credits":{"t