e":"object","properties":{"version":{"type":"string","const":"appearance-v2"},"choices":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string","enum":["original","v1","v2","v3","v4","v5"]},{"type":"string","enum":["v1","v2","v3","v4","v5","v6","v7","v8","v9","v10"]}]}},"animal_choices":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"integer","minimum":0,"maximum":4}},{"type":"null"}]}},"required":["version","choices"],"additionalProperties":false}},"required":["tier","selection","brief","medias"],"additionalProperties":false},"credits":{"type":"number","minimum":0},"submitted":{"type":"boolean","const":false},"free_gens_remaining":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["params","credits","submitted"],"additionalProperties":false}},{"name":"higgsfield.marketing_list_webproducts","title":"List Marketing Webproducts","description":"Read-only list of Marketing Studio webproducts. Does not fetch websites, create webproducts, or modify webproducts. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"limit":{"default":20,"type":"integer","minimum":1,"maximum":100},"offset":{"default":0,"type":"integer","minimum":0,"maximum":9007199254740991}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_webproducts","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_webproducts","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"user_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"preset_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"has_more":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_katana_result","title":"Show Katana result","description":"Display the final completed Katana video in its result widget with preview and download. Retained for backward compatibility; prefer show_result with action for new calls. Call after verifying the final export. Pass exactly one of media_id (a confirmed owned video UUID) or url (a public HTTPS video URL, up to 50 MB). URL input imports and confirms the video in your media library before displaying it. Prefer media_id for an already uploaded video to avoid duplicate uploads. Never pass a job ID, local path or unfinished render. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"media_id":{"description":"Confirmed owned video UUID; omit when using url.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"url":{"description":"Public HTTPS video URL, up to 50 MB; omit when using media_id.","type":"string","format":"uri"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/katana.html","ui":{"resourceUri":"ui://higgsfield/katana.html"},"resource_name":"higgsfield.show_katana_result","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_katana_result","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"mode":{"type":"string","const":"result"},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"video_url":{"type":"string","format":"uri"},"thumbnail_url":{"type":"string","format":"uri"}},"required":["mode","media_id","video_url"],"additionalProperties":false}},{"name":"higgsfield.generate_video_batch","title":"Generate Video Batch","description":"Submit 1-6 independent video generations in parallel without opening a widget. Each requests[] item accepts generation params with count fixed to 1 and no get_cost, creates one job on successful submission, and keeps its caller-provided index in the response. Use for multiple distinct prompts or inputs; use generate_video for one user-facing generation. Poll returned job IDs with jobs_wait in agent-chosen groups of at most 8. For larger sets, collect indexed jobs across submission batches. After every job in the user's set is terminal, pass the collected jobs to exactly one show_generation_by_ids call for up to 24 jobs; never use show_generations or call job_display once per job. A partial failure or timeout does not make the whole batch safe to retry: keep returned job IDs and resolve unknown submission outcomes before retrying affected items. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"requests":{"minItems":1,"maxItems":6,"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Caller-provided stable index, such as the scene number."},"params":{"type":"object","properties":{"model":{"type":"string","description":"Model ID from the model catalog (required)."},"prompt":{"description":"Text description of what to generate.","type":"string"},"count":{"default":1,"description":"Each successfully submitted batch item creates one job; rejected items or choices create none. Add another requests[] item for another generation.","type":"number","const":1},"aspect_ratio":{"description":"Output aspect ratio: 'auto' or positive width:height, for example '1:1', '9:16', or '16:9'. Omit for the selected model's default. Use models_get to inspect that model's supported values; the server coerces unsupported well-formed ratios when a safe model fallback exists.","type":"string","pattern":"^(?:auto|[1-9]\\d*:[1-9]\\d*)$"},"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"},"use_free_gens":{"description":"Spend one of the user's free generations instead of credits. Higgsfield Genjutsu only (hf_mult_motion_control, hf_mult_replace_object) — any other model is rejected. Pass true only when the user asks to use their free generation; balance and models_list report how many they hold under free_gens. A free run covers 480p/720p, one output, up to 30s; anything outside that is refused rather than silently billed. true caps count to 1.","type":"boolean"},"duration":{"description":"Requested duration in whole seconds (minimum 1). Omit for the selected model's default. Use models_get for model-specific allowed durations or ranges; unsupported values are moved to the nearest safe value.","type":"integer","minimum":1,"maximum":9007199254740991},"get_cost":{"description":"Cost preflight is not supported inside a batch submission.","not":{}}},"required":["model"],"additionalProperties":{}}},"required":["index","params"],"additionalProperties":false},"description":"Ordered video generation requests. Response jobs keep the provided indices."},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["requests"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.generate_video_batch","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_video_batch","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"jobs":{"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"anyOf":[{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},{"type":"string","const":"submission_failed"}]},"error":{"type":"string"},"warning":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"preset_recommendation":{"description":"Full-profile preset recommendation. Retry the same indexed request with declined_preset_id=preset_id to generate literally.","type":"object","properties":{"preset_id":{"type":"string"},"name":{"type":"string"},"preview_url":{"type":"string"}},"required":["preset_id","name"],"additionalProperties":false}},"required":["index","status"],"additionalProperties":false}},"submitted_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"failed_count":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["jobs","submitted_count","failed_count"],"additionalProperties":false}},{"name":"higgsfield.ad_multiplier_video_upload","title":"Upload trimmed Ad Multiplier source","description":"Prepare a user-selected video upload or confirm its chosen 4–30 second segment after the presigned PUT succeeds. Uses the web video upload pipeline; does not generate a video. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"action":{"type":"string","const":"prepare"},"mime_type":{"type":"string","enum":["video/mp4","video/quicktime","video/webm"]},"size_bytes":{"type":"integer","exclusiveMinimum":0,"maximum":1073741824}},"required":["action","mime_type","size_bytes"],"additionalProperties":false},{"type":"object","properties":{"action":{"type":"string","const":"confirm"},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"filename":{"type":"string","minLength":1,"maxLength":255},"start_seconds":{"type":"number","minimum":0},"end_seconds":{"type":"number","exclusiveMinimum":0}},"required":["action","media_id","filename","start_seconds","end_seconds"],"additionalProperties":false}]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ad_multiplier_video_upload","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ad_multiplier_video_upload","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.publish_website","title":"Publish Website","description":"Publish the website: lists the website's CURRENT LIVE production deploy on the Higgsfield community feed ('show in feed'), where other users can discover it. This does NOT deploy — deploy_website (which every build flow already runs) must have shipped the latest changes first; publishing with undeployed changes lists the OLD live build, and re-publishing does not re-deploy. BEFORE publishing, the page metadata in app/src/app-meta.json MUST be filled with real values — og_title, og_description, favicon_url, og_image_url — the feed card renders from them (read fresh from the pushed repo at publish time) and a website with an empty og_title is INVISIBLE on the feed; the live page's own head tags are baked at build time, so deploy AFTER changing them. Also OFFER the user a cover video for the card (og_video_url) — ask their permission first (video generation costs credits), never generate it unprompted. Commit and git push the metadata (and all other changes), then deploy, BEFORE calling this. Publish when the user asks to publish / share / go live on the feed, OR when they opted in to publishing at the start of the build — in that case publish automatically once the site is deployed with its metadata filled, without waiting to be asked again. For a plain deploy without a feed listing use deploy_website instead. EXCEPTION: a website whose production was never deployed (or was taken down by unpublish) falls back to deploying first — that returns status 'pending' while CI runs and the website is listed automatically once the deploy succeeds (check with website_status). This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","description":"The website's id (returned by create_website)."}},"required":["website_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/website-deploy.html","ui":{"resourceUri":"ui://higgsfield/website-deploy.html"},"resource_name":"higgsfield.publish_website","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/publish_website","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"status":{"description":"deployed / failed / pending (CI still running).","type":"string"},"url":{"description":"The live production URL when the deploy succeeded.","anyOf":[{"type":"string"},{"type":"null"}]},"listed_in_community":{"description":"Whether the website is now on the community feed.","type":"boolean"},"marketplace_url":{"description":"The website's community-feed listing page on Higgsfield — show it to the user.","anyOf":[{"type":"string"},{"type":"null"}]},"error":{"description":"Build log when the deploy failed.","anyOf":[{"type":"string"},{"type":"null"}]},"name":{"description":"The published site's title (from its og:title / <title>).","anyOf":[{"type":"string"},{"type":"null"}]},"favicon_url":{"description":"The published site's favicon URL.","anyOf":[{"type":"string"},{"type":"null"}]},"og_image_url":{"description":"The published site's OG banner image URL.","anyOf":[{"type":"string"},{"type":"null"}]},"website_id":{"description":"Echo of the input id — the widget's publish/contest buttons need it.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_medias","title":"Show Uploaded Media","description":"Show the user's latest uploaded media files of one type in the widget. Returns media IDs, URLs, and creation timestamps. Call once with the single type the user asked for (default image); do not enumerate other types unless requested. The widget handles pagination. Do not call show_medias again merely because next_cursor is present; use cursor only when the user explicitly asks for more items. Pass media IDs as value in the medias array of generation tools. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"type":{"default":"image","description":"Media type to list. Defaults to image.","type":"string","enum":["image","video","audio"]},"cursor":{"description":"Use a previous next_cursor only when the user explicitly asks for more items; otherwise omit.","type":"number"},"size":{"default":24,"description":"Number of results per page","type":"integer","minimum":1,"maximum":100}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/job-list.html","ui":{"resourceUri":"ui://higgsfield/job-list.html"},"resource_name":"higgsfield.show_medias","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_medias","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"description":"Array of uploaded media files. Absent on error.","type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string","enum":["image","video","audio"]},"url":{"type":"string"},"created_at":{"type":"number"}},"required":["id","type","url","created_at"],"additionalProperties":false}},"media_type":{"description":"The media type this listing is for (echoes the request's type).","type":"string","enum":["image","video","audio"]},"next_cursor":{"description":"Opaque cursor for widget pagination. Do not automatically call show_medias again when present.","anyOf":[{"type":"number"},{"type":"null"}]},"er