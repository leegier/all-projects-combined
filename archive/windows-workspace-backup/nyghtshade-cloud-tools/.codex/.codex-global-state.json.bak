ype":"null"}]}},"required":["id","status","result_url"],"additionalProperties":false}},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"jobSetType":{"type":"string","const":"3d_jutsu_angles"},"resolution":{"type":"string","enum":["1k","1.5k","2k"]},"referenceMediaId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["id","projectId","generationSequence","actorId","revision","sceneSequence","operationId","artifactId","prompt","aspectRatio","status","jobs","createdAt","updatedAt","jobSetType","resolution"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"generationSequence":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"actorId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"artifactId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"prompt":{"type":"string","minLength":1,"maxLength":60000},"aspectRatio":{"type":"string"},"status":{"type":"string","enum":["submitting","running","succeeded","failed","submission_unknown"]},"jobs":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"type":"string"},"result_url":{"anyOf":[{"type":"string","format":"uri"},{"type":"null"}]}},"required":["id","status","result_url"],"additionalProperties":false}},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"resolution":{"type":"string","enum":["480p","720p","1080p"]},"duration":{"type":"integer","minimum":4,"maximum":30},"generateAudio":{"type":"boolean"},"mode":{"type":"string","enum":["t2v","omni_reference","video_edit","video_extension"]},"medias":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","enum":["image","start_image","end_image","video","audio"]},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9_]+$"}},"required":["id","type"],"additionalProperties":false}},"required":["role","data"],"additionalProperties":false}},"bitrateMode":{"type":"string","enum":["standard","high"]},"extensionMode":{"type":"string","enum":["backward","forward"]},"draft":{"type":"boolean"},"draftJobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"jobSetType":{"type":"string","const":"seedance_2_5"}},"required":["id","projectId","generationSequence","actorId","revision","sceneSequence","prompt","aspectRatio","status","jobs","createdAt","updatedAt","resolution","duration","generateAudio","jobSetType"],"additionalProperties":false}]}},"nextCursor":{"anyOf":[{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},{"type":"null"}]},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","generations","nextCursor","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_query_python","title":"3D Jutsu: query python","description":"Inspect the latest settled Blender scene without committing changes. `bpy` and the `artifacts`\nregistry are available; assign concise JSON-serializable findings to `result`. Query exact\nnames, metre-scale dimensions, transforms, parents, collections, materials, cameras, lights,\nvisibility, and animation settings as needed. Inspect Blender RNA when an API or enum is\nuncertain. Temporary scene changes are discarded, including camera changes used for inspection.\nA query can render and publish images for visual inspection: allocate a target with\n`artifacts.file(name=\"preview.png\", media_type=\"image/png\")`, write the image to `target.path`,\nand call `target.publish()`. Resolve published IDs with `scene_builder_3d_get_artifact`.\nUse the successful query's `revisionBefore` and `sceneSequenceAfter` as the guards for the next\n`scene_builder_3d_run_python` call. If still active, poll `scene_builder_3d_get_operation`.\nReuse an operation ID only to retry the identical request. Imported model bytes must enter\nthrough `scene_builder_3d_import_asset`; do not fetch URLs or embed file bytes in Python. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"code":{"type":"string","minLength":1,"description":"Use bpy and artifacts; assign JSON-serializable findings to result. Files persist only via artifacts.file(name=..., media_type=...), writing to target.path, then target.publish(). At most eight PNG/JPEG/MP4 files, 512 MiB each and 1 GiB total; images at most 16384 pixels per side and 64 MP. Invalid published files fail the operation. Set image_settings.media_type='IMAGE' before PNG/JPEG, or 'VIDEO' before FFMPEG with MPEG4/H264. No network fetches or embedded model bytes; use scene_builder_3d_import_asset."},"waitSeconds":{"default":8,"description":"Seconds to wait, capped at 8; poll scene_builder_3d_get_operation if still active.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["projectId","operationId","code"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.scene_builder_3d_query_python","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_query_python","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean"},"operation":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"access":{"type":"string","enum":["query","mutation"]},"status":{"type":"string","enum":["queued","hydrating","starting","running","checkpointing","succeeded","failed","timed_out","expired"]},"baseRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"stale":{"type":"boolean"},"sceneSequenceBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"sceneSequenceAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"createdAt":{"type":"string"},"startedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finishedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"result":{},"output":{"type":"object","properties":{"stdoutTail":{"type":"string"},"stderrTail":{"type":"string"},"truncated":{"type":"boolean"}},"required":["stdoutTail","stderrTail","truncated"],"additionalProperties":false},"error":{"anyOf":[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},{"type":"null"}]},"artifacts":{"anyOf":[{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"blend":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"glb":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"generated":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["projectId","revision","blend","glb","generated"],"additionalProperties":false},{"type":"null"}]},"generatedArtifacts":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["id","projectId","access","status","baseRevision","headRevision","headSceneSequence","stale","sceneSequenceBefore","sceneSequenceAfter","revisionBefore","revisionAfter","createdAt","startedAt","finishedAt","result","output","error","artifacts","generatedArtifacts"],"additionalProperties":false},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"terminal":{"type":"boolean","description":"False while the operation still needs polling; true includes success and failure."},"nextTool":{"type":"string","const":"scene_builder_3d_get_operation"},"nextArguments":{"type":"object","properties":{"projectId":{"type":"string"},"operationId":{"type":"string"}},"required":["projectId","operationId"],"additionalProperties":false}},"required":["ok","operation","projectUrl","terminal"],"additionalProperties":false}},{"name":"higgsfield.marketing_list_ad_formats","title":"List DTC Ads Ad Formats","description":"Read-only list of DTC Ads image ad-format presets. Does not create or modify image styles. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_ad_formats","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_ad_formats","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"user_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"preset_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"has_more":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.create_project","title":"Create Project","description":"Create a private Higgsfield media project for this conversation. Create only on an explicit user request or when get_preferences returns auto_create_project=true and this conversation has no destination. The default is no automatic project. An explicit existing destination or request to work without a project wins. Creating a project does not change the saved preference. Call once, then retain project_id, workspace_id and default_folder_id in this conversation and pass folder_id on subsequent generate_* calls. Reuse the existing project on later turns; never create one per generation or reuse another conversation's project. This does not create a chat, website or 3D scene. No starter/brief subfolder is created. Resolve workspace_id before the first call using list_workspaces (full) or workspace_list (OpenAI); use the selected workspace or ask the user when ambiguous. Repeat an uncertain request only with the original workspace_id, name, surface and idempotency_key, even if the selected workspace changes; backend replay lasts 15 minutes, not the lifetime of the chat. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":100,"description":"Project name for this conversation."},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Target workspace UUID from workspace discovery. Choose once before creation and retain unchanged on retries; never substitute the newly selected workspace."},"idempotency_key":{"type":"string","minLength":1,"maxLength":255,"description":"Unique operation key chosen once for this creation. Preserve on retries; never derive from the project name or generate a new key on retry."},"surface":{"description":"Use cinematic_studio for a Cinema project; omit for an MCP project with surface mcp. This is product classification, not creation origin.","type":"string","enum":["cinematic_studio"]}},"required":["name","workspace_id","idempotency_key"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.create_project","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/create_project","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"project_id":{"type":"string"},"default_folder_id":{"type":"string"},"workspace_id":{"type":"string"},"name":{"type":"string"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_reference_elements","title":"Show Reference Elements","description":"Elements widget — reusable characters / environments / props per workspace. Actions:\n- `list` (default; paginated by `created_at` DESC, use `cursor` from prev `next_cursor`).\n- `get` (default when `element_id` is set).\n- `create`: pass `medias[]` as `{ id, url, type: 'media_input' | 'image_job' }`. Upload first via media_upload_and_confirm. `category='auto'` lets the server classify (use explicit only on user ask). Omit `name` to auto-derive (per-workspace unique, collisions get a numeric suffix). Returns synchronously.\n\nREUSABLE CHARACTER — user wants a recurring character/face across generations: create an Element (this tool action=create) from one clear reference image.\n\nUSAGE IN GENERATION (implementation detail):\nEmbed `<<<element_id>>>` inside `params.prompt` of `generate_image` / `generate_video`. Backend auto-injects the image and rewrites to `@element_name`. Multiple placeholders per prompt OK.\nExample: `\"Cinematic portrait of <<<UUID>>> on a rooftop\"`, `\"<<<A>>> handing coffee to <<<B>>> in a Paris cafe\"`.\n\nSUPPORTED MODELS (`params.model` = machine name, friendly in parens):\n- Image: `nano_banana_pro` (Nano Banana Pro), `nano_banana_2` (Nano Banana 2), `gpt_image_2` (GPT Image 2), `seedream_v4_5` (Seedream 4.5), `seedream_v5_lite` (Seedream 5.0 lite), `cinematic_studio_2_5` (Cinema Studio Image 2.5).\n- Video: `cinematic_studio_video_v2` (Cinema Studio Video 2), `cinematic_studio_3_0` (Cinema Studio Video 3.0), `seedance_2_0` (Seedance 2.0), `kling3_0` (Kling 3.0 — REQUIRES a `start_image` in `params.medias`; element placeholder alone won't trigger reference usage).\nMap friendly names to model ids. Other models ignore the placeholder.\n\nUSER-FACING STYLE: prefer friendly model names and element names for readability.\n\nGUARDS:\n- `@name` form does NOT work in tool calls — only `<<<UUID>>>` in `params.prompt`.\n- Do NOT put element ids in `params.medias` / `params.input_images` — placeholder handles injection.\n- `kling3_0` only honors reference elements when an explicit `start_image` is provided in `params.medias`. If the user wants Kling 3.0 with an element but hasn't supplied a start frame, ask for one (upload via media_upload_and_confirm, or pick a prior generation) before calling `generate_video`. Without a start_image, pick another video model from the list.\n- Only `status: completed` elements are usable; skip `processing` / `ip_checking` / `failed` / `kling_failed` / `nsfw`. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"action":{"description":"Operation mode. Defaults to `get` if `element_id` is set, otherwise `list`.","type":"string","enum":["list","get","create"]},"cursor":{"description":"[action=list] Pass `next_cursor` from a previous response to get the next page.","type":"number"},"size":{"default":27,"description":"[action=list] Number of elements per page (1-100).","type":"integer","minimum":1,"maximum":100},"element_id":{"description":"[action=get] Fetch a single reference element by id.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"description":"[action=create] Element name, max 32 chars. Spaces are normalised to '-'. If omitted, the server derives a name from the media.","type":"string","maxLength":32},"category":{"description":"[action=create] `auto` lets the server classify from the first images. Use a specific category only if the user is explicit. Defaults to `auto`.","type":"string","enum":["auto","character","environment","prop"]},"description":{"description":"[action=create] Optional free-form description, stored as-is.","type":"string"},"medias":{"description":"[action=create] Image references. Required. URLs must be https (private/loopback hosts rejected); normally Higgsfield upload URLs returned by media_upload_and_confirm.","type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"media_input UUID returned by media_upload_and_confirm, or completed image_job UUID."},"url":{"type":"string","description":"https media URL of the asset, normally a Higgsfield upload URL (e.g. https://upload.higgsfield.ai/user_<id>/<uuid>.png). Must be https; private/loopback hosts are rejected."},"type":{"default":"media_input","description":"Source kind for `id`. Defaults to `media_input`.","type":"string","enum":["media_input","image_job"]}},"required":["id","url"]}}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/reference-elements.html","ui":{"resourceUri":"ui://higgsfield/reference-elements.html"},"resource_name":"higgsfield.show_reference_elements","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_reference_elements","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"description":"Reference elements. Single-element when `action=get`, otherwise the page from `action=list`.","type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"category":{"type":"string","description":"Reference element category. Known values: `character`, `environment`, `prop`, `character_ip_verified`, `environment_ip_verified`. Kept open-ended so new backend categories don't fail outputSchema validation."},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","description":"Element status. Known values: `processing`, `ip_checking`, `completed`, `nsfw`, `kling_failed`, `failed`. Kept open-ended so new backend statuses don't fail outputSchema validation."},"medias":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"type":{"type":"string","description":"Media kind. Known values: `media_input`, `image_job`. Kept open-ended so new backend types don't fail outputSchema validation."}},"required":["id","url","type"],"additionalProperties":false},"description":"Image medias. List view returns only the first media; fetch via `action=get` with `element_id` to get the full list."},"video_medias":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"type":{"type":"string","description":"Media kind. Known values: `media_input`, `image_job`. Kept open-ended so new backend types don't fail outputSchema validation."}},"required":["id","url","type"],"additionalProperties":false},"description":"Video medias. List view returns only the first media; fetch via `action=get` with `element_id` to get the full list."},"created_at":{"type":"number"}},"required":["id","name","category","description","status","medias","video_medias","created_at"],"additionalProperties":false}},"next_cursor":{"description":"[action=list] Pass as `cursor` to fetch the next page. Null when no more pages.","anyOf":[{"type":"number"},{"type":"null"}]},"element":{"description":"[action=create] The created reference element.","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"category":{"type":"string","description":"Reference element category. Known values: `character`, `environment`, `prop`, `character_ip_verified`, `environment_ip_verified`. Kept open-ended so new backend categories don't fail outputSchema validation."},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","description":"Element status. Known values: `processing`, `ip_checking`, `completed`, `nsfw`, `kling_failed`, `failed`. Kept open-ended so new backend statuses don't fail outputSchema validation."},"medias":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"type":{"type":"string","description":"Media kind. Known values: `media_input`, `image_job`. Kept open-ended so new backend types don't fail outputSchema validation."}},"required":["id","url","type"],"additionalProperties":false},"description":"Image medias. List view returns only the first media; fetch via `action=get` with `element_id` to get the full list."},"video_medias":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"type":{"type":"string","description":"Media kind. Known values: `media_input`, `image_job`. Kept open-ended so new backend types don't fail outputSchema validation."}},"required":["id","url","type"],"additionalProperties":false},"description":"Video medias. List view returns only the first media; fetch via `action=get` with `element_id` to get the full list."},"created_at":{"type":"number"}},"required":["id","name","category","description","status","medias","video_medias","created_at"],"additionalProperties":false},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.canvas_run","title":"Run Canvas Generations","description":"Run generation nodes on a canvas board (and the nodes they depend on). Generations cost credits: first call with confirm=false. Nothing starts, and it returns the price of each charged generation and the total. Give the user one answer with what will run, its settings and that total, and only after they agree call again with confirm=true. A generation without a price is named as such: tell the user instead of estimating it. Price board nodes here, not with estimate_image_cost or estimate_video_cost: those name board models differently. Results appear in their nodes on the board live, including an open_canvas view already shown (do not open it again); read them with canvas_read include_results=true. To generate on a board, add generation items and the connections that feed them with canvas_add and run them here: generate_image and generate_video results do not land on a board. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Canvas room_id (UUID) or the canvas URL containing it.","type":"string"},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"node_ids":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string","minLength":1},"description":"Generation nodes to run; the nodes they depend on run too."},"confirm":{"default":false,"description":"false: report what would be charged, priced, and start nothing. true: start the run — only after the user agreed to the charge.","type":"boolean"}},"required":["room_id","node_ids"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.canvas_run","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_run","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.katana_compose_message","title":"Compose Katana preset message","description":"Validate a filled Katana preset form and return the chat message that starts the preset. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"slug":{"type":"string","maxLength":128,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"inputs":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["slug","inputs"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.katana_compose_message","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/katana_compose_message","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"message":{"type":"string"},"errors":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"code":{"type":"string"},"message":{"type":"string"}},"required":["path","code","message"],"additionalProperties":false}}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_get_product","title":"Get Ads Studio Product","description":"Read one Ads Studio product and open it as a card: whether Ads Studio has finished reading its page (status queued, in_progress, completed or failed, with fail_reason when it failed) and what it knows - name, price, page, description, selling points. Use this to answer \"is the product ready?\" after ads_studio_add_product, when the user asks - not on a timer and never in a loop. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"product_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Product id from ads_studio_add_product or ads_studio_list_products."}},"required":["product_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_get_product","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_get_product","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"product_id":{"type":"string"},"name":{"type":"string"},"status":{"description":"queued | in_progress | completed | failed - the read of its page.","type":"string"},"fail_reason":{"description":"Why the page could not be read, in ai-cmo's own words.","type":"string"},"price":{"type":"string"},"page_url":{"type":"string"},"category":{"type":"string"},"description":{"type":"string"},"selling_points":{"type":"array","items":{"type":"string"}},"use_cases":{"type":"array","items":{"type":"string"}},"audience":{"type":"string"},"characteristics":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"value":{"type":"string"}},"required":["label","value"],"additionalProperties":false}},"images_count":{"type":"number"},"next_step":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_create_project","title":"3D Jutsu: create project","description":"Create a new private 3D Jutsu project for the authenticated user. Supply a descriptive name; the service assigns ownership and the project ID. Use this when the user requests a new project or a new standalone scene. For an existing scene, use scene_builder_3d_list_projects instead. Pass the returned projectId explicitly to subsequent tools; creation does not set a global active project. Call scene_builder_3d_get_project, then scene_builder_3d_query_python to inspect the initial scene and obtain guards before scene_builder_3d_run_python or scene_builder_3d_import_asset. Creation alone does not produce a committed GLB: scene_builder_3d_show_scene becomes available after the first successful edit or import. This call is not idempotent. If the response is interrupted or uncertain, use scene_builder_3d_list_projects to find the new project before retrying; repeating creation can create a duplicate.\n\nBefore building or editing a scene, load get_preset_instructions with { preset: \"/3d-jutsu\" } once for the full workflow, runtime limits and scene-building references. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":255,"description":"Name for the new private 3D Jutsu project."}},"required":["name"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_create_project","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_create_project","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"project":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"}},"required":["id","name"],"additionalProperties":false},"projectId":{"type":"string"},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"nextTool":{"type":"string","const":"scene_builder_3d_get_project"},"nextArguments":{"type":"object","properties":{"projectId":{"type":"string"}},"required":["projectId"],"additionalProperties":false}},"required":["ok","project","projectId","projectUrl","nextTool","nextArguments"],"additionalProperties":false}},{"name":"higgsfield.estimate_image_cost","title":"Estimate Image Cost","description":"Estimate image generation credit cost without submitting a job. HTTPS image references are fetched, uploaded, and confirmed in your Higgsfield media library; repeated calls can create new uploads. Requires write access. Takes the same `params` object as generate_image: `params.model` is required; `prompt` may be omitted for a cost-only estimate. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"model":{"type":"string","description":"Model ID from the model catalog (required)."},"prompt":{"description":"Text description. Optional for cost-only estimates.","type":"string"},"count":{"default":1,"description":"Number of results (1-4). Ignored with use_unlim: an unlim request is always one generation — count is capped to 1 and the cap comes back in adjustments. Send separate calls for more.","type":"integer","minimum":1,"maximum":4},"aspect_ratio":{"description":"Output aspect ratio: 'auto' or positive width:height, for example '1:1', '9:16', or '16:9'. Omit for the selected model's default. Use models_get to inspect that model's supported values; the server coerces unsupported well-formed ratios when a safe model fallback exists.","type":"string","pattern":"^(?:auto|[1-9]\\d*:[1-9]\\d*)$"},"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"}},"required":["model"],"additionalProperties":{}}},"required":["params"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.estimate_image_cost","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/estimate_image_cost","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"input_check":{"description":"Genjutsu required-media presence only. A successful price quote does not validate media existence, duration or generation readiness.","type":"object","properties":{"required_media_present":{"type":"boolean"},"image_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"video_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"missing_roles":{"type":"array","items":{"type":"string","enum":["image","video"]}},"generation_validated":{"type":"boolean","const":false}},"required":["required_media_present","image_count","video_count","missing_roles","generation_validated"],"additionalProperties":false},"prepared_params":{"description":"Genjutsu request params with resolved media UUIDs and applied adjustments. May be incomplete; inspect input_check. Reuse instead of importing the same references again. No generation has been submitted or validated.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"cost":{"description":"Estimated generation cost. No job was submitted.","type":"object","properties":{"credits":{"type":"number","description":"Whole-credit cost (max(1, exact // 1) when exact > 0)."},"credits_exact":{"type":"number","description":"Exact credit cost as a float."}},"required":["credits","credits_exact"],"additionalProperties":false},"error":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}}},"additionalProperties":false}},{"name":"higgsfield.project_metadata","title":"Project Metadata","description":"App-only project header. Read an accessible project's name and rename capability, or explicitly rename that same project. Changes only its name; no scene edits or media generation. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"action":{"type":"string","const":"get"},"project_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["action","project_id","workspace_id"],"additionalProperties":false},{"type":"object","properties":{"action":{"type":"string","const":"rename"},"project_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string","minLength":1,"maxLength":100}},"required":["action","project_id","workspace_id","name"],"additionalProperties":false}]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.project_metadata","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/project_metadata","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.list_canvases","title":"List Canvases","description":"App-only canvas browser. Lists existing canvases among the caller's accessible FNF folders; projects without a canvas are excluded. Uses FNF pagination order. Continue with cursor while has_more is true, even if items is empty; retain workspace_id, tab and search between pages. Does not create boards or issue tokens. Open a selected item with create_or_update_canvas_token using its room_id and workspace_id. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Authenticated workspace context. Shared canvases may belong to other workspaces; use each item's workspace_id when opening it."},"tab":{"default":"all","description":"All accessible canvases, owned canvases, or canvases shared via a link, matching the canvas browser.","type":"string","enum":["all","my","shared"]},"search":{"description":"Case-insensitive canvas name search.","type":"string","maxLength":100},"size":{"default":20,"description":"Maximum candidate folders per page. Filtering can return fewer canvases, including an empty page.","type":"integer","minimum":1,"maximum":50},"cursor":{"description":"Cursor from the previous page. Keep workspace, tab and search unchanged; continue while has_more is true.","type":"number","minimum":0}},"required":["workspace_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.list_canvases","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_canvases","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"room_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"},"canvas_url":{"type":"string","format":"uri"},"thumbnail_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"last_edited_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"number"},"updated_at":{"type":"number"},"shared":{"type":"boolean"},"role":{"anyOf":[{"type":"string"},{"type":"null"}]},"access_mode":{"type":"string"}},"required":["room_id","workspace_id","name","canvas_url","thumbnail_url","last_edited_at","created_at","updated_at","shared","role","access_mode"],"additionalProperties":false}},"cursor":{"anyOf":[{"typ