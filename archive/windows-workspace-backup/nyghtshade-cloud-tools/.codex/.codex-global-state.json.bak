equired":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}}},"required":["submitted","job_id","credits","use_free_gens","results"],"additionalProperties":false}]}},{"name":"higgsfield.ads_studio_add_product","title":"Add Ads Studio Product","description":"Add a product to Ads Studio - under a brand, or with no brand at all - from its page link and/or a pasted description. Answers as soon as the row is queued - Ads Studio reads the page in the background. Do not poll and do not list products to check. Read ads_studio_get_product when the user asks about it. Use this when the research missed a product or the user names a new one. To refresh an existing product from its page, pass its id in overwrite instead of adding a second row. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"description":"The brand this product belongs to, from ads_studio_list_brands. Leave it out for a product of no brand: it is still listed by ads_studio_list_products without brand_id and can be generated.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"url":{"description":"The product's own page. Give this whenever the user has it: it is what makes the ads specific.","type":"string","format":"uri"},"text":{"description":"The user's own description, when there is no page or it adds facts the page lacks.","type":"string","maxLength":4000},"images":{"description":"Product photo URLs the user supplied or uploaded. Ads Studio fetches each one, so a link it cannot reach is refused.","maxItems":8,"type":"array","items":{"type":"string","format":"uri"}},"overwrite":{"description":"Existing product ids to refresh from the page instead of creating a new row.","maxItems":10,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_add_product","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_add_product","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"brand_id":{"type":"string"},"products":{"type":"array","items":{"type":"object","properties":{"product_id":{"type":"string"},"status":{"type":"string"}},"additionalProperties":false}},"next_step":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.job_status","title":"Check Job Status","description":"Check the status and results of an async job. Returns instantly. For non-terminal jobs the response includes poll_after_seconds — wait that many seconds before calling again. Typical total times: image ~10-20s, video ~60-180s. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"jobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Job ID from a previous operation; use item_id from list_project_assets"},"folder_id":{"description":"Folder context from list_project_assets; include it when inspecting a job from a shared folder.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"sync":{"description":"If true, server polls internally for up to ~25s and returns on terminal state. Defaults to false.","type":"boolean"},"raw_data":{"description":"If true, return the raw FNF job payload instead of the normalized generation shape.","type":"boolean"},"source":{"description":"Set by the generation widget when it polls automatically.","type":"string","const":"widget"}},"required":["jobId"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.job_status","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/job_status","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"generation":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false},"raw_data":{},"error":{"type":"string"},"errorCode":{"type":"number"},"retryable":{"type":"boolean"},"poll_after_seconds":{"type":"number"}},"additionalProperties":false}},{"name":"higgsfield.generate_image_batch","title":"Generate Image Batch","description":"Submit 1-6 independent image generations in parallel without opening a widget. Each requests[] item accepts generation params with count fixed to 1 and no get_cost, creates one job on successful submission, and keeps its caller-provided index in the response. Use for multiple distinct prompts or inputs; use generate_image for one user-facing generation. Poll returned job IDs with jobs_wait in agent-chosen groups of at most 8. For larger sets, collect indexed jobs across submission batches. After every job in the user's set is terminal, pass the collected jobs to exactly one show_generation_by_ids call for up to 24 jobs; never use show_generations or call job_display once per job. A partial failure or timeout does not make the whole batch safe to retry: keep returned job IDs and resolve unknown submission outcomes before retrying affected items. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"requests":{"minItems":1,"maxItems":6,"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Caller-provided stable index, such as the scene number."},"params":{"type":"object","properties":{"model":{"type":"string","description":"Model ID from the model catalog (required)."},"prompt":{"description":"Text description of what to generate.","type":"string"},"count":{"default":1,"description":"Each successfully submitted batch item creates one job; rejected items or choices create none. Add another requests[] item for another generation.","type":"number","const":1},"aspect_ratio":{"description":"Output aspect ratio: 'auto' or positive width:height, for example '1:1', '9:16', or '16:9'. Omit for the selected model's default. Use models_get to inspect that model's supported values; the server coerces unsupported well-formed ratios when a safe model fallback exists.","type":"string","pattern":"^(?:auto|[1-9]\\d*:[1-9]\\d*)$"},"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"},"get_cost":{"description":"Cost preflight is not supported inside a batch submission.","not":{}}},"required":["model"],"additionalProperties":{}}},"required":["index","params"],"additionalProperties":false},"description":"Ordered image generation requests. Response jobs keep the provided indices."},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["requests"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.generate_image_batch","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_image_batch","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"jobs":{"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"anyOf":[{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},{"type":"string","const":"submission_failed"}]},"error":{"type":"string"},"warning":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"preset_recommendation":{"description":"Full-profile preset recommendation. Retry the same indexed request with declined_preset_id=preset_id to generate literally.","type":"object","properties":{"preset_id":{"type":"string"},"name":{"type":"string"},"preview_url":{"type":"string"}},"required":["preset_id","name"],"additionalProperties":false}},"required":["index","status"],"additionalProperties":false}},"submitted_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"failed_count":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["jobs","submitted_count","failed_count"],"additionalProperties":false}},{"name":"higgsfield.get_preset_instructions","title":"Higgsfield Preset Instructions","description":"Resolve a named Higgsfield preset or command and read its instructions without executing it. Entries include image/video recipes, explicit-only production commands /ugc-video, /faceless-video and /ad-multiplier (OpenAI), generation workflows such as /genjutsu, and setup instructions such as /use-after-effects and /use-blender. For an explicit slash invocation, resolve the exact token before selecting tools or requesting media. Katana presets resolve by /slug or explicit /katana/slug from their published CMS instructions, and bare /katana returns general Katana instructions (inspect attachments, edit source media to the user's brief, faithfully remake an explicit reference, or open the Katana catalog when nothing is supplied); for a /katana/ message with a MEDIA block, pass its entries as media to receive their file URLs. Omit preset to list recipes, commands and published Katana titles/descriptions without opening a widget. To choose a Katana preset by style or theme, match this metadata and then load its exact /katana/slug; do not use get_presets for internal Katana discovery. Use get_presets for Viral and Marketing Studio browsing (/effects, /product, /motion); a resolved gallery entry supplies its input schema and exact detail lookup. Recipes such as /hero-shot and /reel-cover supply their generation workflow. Setup commands and their references supply instructions for the required runtime; loading them does not install software, connect an editor, or submit jobs. Unqualified unknown tokens follow resolver guidance to infer the task and use ordinary tools. An unavailable /katana/slug must stop without substituting another preset. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"preset":{"description":"Preset id or slash command, e.g. /hero-shot, /genjutsu, /katana/aura-showpiece, /use-after-effects, /use-blender or a reference path returned by this tool. Omit to list recipes and commands.","type":"string","minLength":1,"maxLength":160},"media":{"description":"Katana only: the `<image|video> media_id=<uuid>` entries of the user's MEDIA block, so the result lists their file URLs.","minItems":1,"maxItems":40,"type":"array","items":{"type":"object","properties":{"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["image","video"]}},"required":["media_id","type"],"additionalProperties":false}}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.get_preset_instructions","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_preset_instructions","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"catalog"},"presets":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"output_type":{"type":"string","enum":["image","video"]}},"required":["id","title","description","output_type"],"additionalProperties":false}}},"required":["mode","presets"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"preset"},"preset":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"output_type":{"type":"string","enum":["image","video"]}},"required":["id","title","description","output_type"],"additionalProperties":false},"instructions_markdown":{"type":"string"}},"required":["mode","preset","instructions_markdown"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"gallery"},"source":{"type":"string","enum":["viral","marketing_studio"]},"preset_id":{"type":"string"},"preset_name":{"type":"string"},"instructions_markdown":{"type":"string"}},"required":["mode","source","preset_id","preset_name","instructions_markdown"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"not_found"},"requested":{"type":"string"},"presets":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"output_type":{"type":"string","enum":["image","video"]}},"required":["id","title","description","output_type"],"additionalProperties":false}}},"required":["mode","requested","presets"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"instructions"},"instructions_markdown":{"type":"string"}},"required":["mode","instructions_markdown"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"error"},"error":{"type":"string"}},"required":["mode","error"],"additionalProperties":false}]}},{"name":"higgsfield.scene_builder_3d_get_operation","title":"3D Jutsu: get operation","description":"Read or wait for a submitted Python operation in this project. Only `succeeded`, `failed`,\n`timed_out`, and `expired` are terminal; all other statuses require another poll using the same\nproject and operation IDs. An HTTP success or a wait timeout does not mean the operation\nfinished. Do not submit another mutation while one is active. On success, use the returned\nrevision and scene sequence for subsequent work; obtain published images and videos through\n`scene_builder_3d_get_artifact`. On failure, inspect the error and re-read project state before\ndeciding to retry. Do not blindly resubmit a failed operation under another ID.\n\nFinish each completed scene creation, edit, or import task by calling `scene_builder_3d_show_scene` once as the final scene inspection/edit call of that review phase, after mutations have settled and verification is complete. Pass the same `projectId` and the exact committed `revision` of the final result: `revisionAfter` from the final successful mutation, or the settled `project.revision` after an import. Do not guess the revision. Show an unchanged revision only once. Authorized generation and status calls may follow; later feedback or a verified mismatch can reopen scene editing. Verify and show the corrected revision at its next review boundary. This shows the result to the user; a text summary or download link alone does not finish scene delivery. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"waitSeconds":{"default":20,"description":"Seconds to wait, capped at 30.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["projectId","operationId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_get_operation","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_operation","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean"},"operation":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"access":{"type":"string","enum":["query","mutation"]},"status":{"type":"string","enum":["queued","hydrating","starting","running","checkpointing","succeeded","failed","timed_out","expired"]},"baseRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"stale":{"type":"boolean"},"sceneSequenceBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"sceneSequenceAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"createdAt":{"type":"string"},"startedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finishedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"result":{},"output":{"type":"object","properties":{"stdoutTail":{"type":"string"},"stderrTail":{"type":"string"},"truncated":{"type":"boolean"}},"required":["stdoutTail","stderrTail","truncated"],"additionalProperties":false},"error":{"anyOf":[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},{"type":"null"}]},"artifacts":{"anyOf":[{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"blend":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"glb":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"generated":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["projectId","revision","blend","glb","generated"],"additionalProperties":false},{"type":"null"}]},"generatedArtifacts":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["id","projectId","access","status","baseRevision","headRevision","headSceneSequence","stale","sceneSequenceBefore","sceneSequenceAfter","revisionBefore","revisionAfter","createdAt","startedAt","finishedAt","result","output","error","artifacts","generatedArtifacts"],"additionalProperties":false},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"terminal":{"type":"boolean","description":"False while the operation still needs polling; true includes success and failure."},"nextTool":{"type":"string","const":"scene_builder_3d_get_operation"},"nextArguments":{"type":"object","properties":{"projectId":{"type":"string"},"operationId":{"type":"string"}},"required":["projectId","operationId"],"additionalProperties":false}},"required":["ok","operation","projectUrl","terminal"],"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_list_projects","title":"3D Jutsu: list projects","description":"Discover the authenticated user's 3D Jutsu projects before choosing a scene to read or\nedit. Follow `nextCursor` to see more results. Use the selected project's `id` as `projectId` in\nevery project-scoped 3D Jutsu tool; no call sets a global active project. Match the user's named\nproject, and ask them to choose if the result is ambiguous. Then call\n`scene_builder_3d_get_project` for its current state. A project's presence here does not bypass\npermission checks on subsequent calls. To start a new project, use scene_builder_3d_create_project.\n\nBefore building or editing a scene, load get_preset_instructions with { preset: \"/3d-jutsu\" } once for the full workflow, runtime limits and scene-building references. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"cursor":{"type":"string","pattern":"^\\d+(?:\\.\\d+)?$"},"limit":{"default":24,"type":"integer","minimum":1,"maximum":50}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_list_projects","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_list_projects","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"projects":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"role":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","name","role","createdAt","updatedAt"],"additionalProperties":false}}},"required":["ok","nextCursor","projects"],"additionalProperties":false}},{"name":"higgsfield.marketing_create_product_from_media","title":"Create Marketing Product From Uploaded Media","description":"Create a Marketing Studio product from user-provided uploaded media IDs and manual metadata. This does not scrape external websites or fetch third-party URLs. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":255,"description":"Product title supplied by the user or inferred from uploaded media context."},"description":{"description":"Optional product description.","anyOf":[{"type":"string"},{"type":"null"}]},"media_input_ids":{"minItems":1,"maxItems":20,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"description":"Confirmed uploaded image media IDs returned by media_upload_and_confirm."}},"required":["title","media_input_ids"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_create_product_from_media","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_create_product_from_media","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"item":{},"success":{"type":"boolean"},"note":{"type":"string"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.search_reference_elements","title":"Search References","description":"Search completed reference elements and recent Soul Feed image/video generations for composer @mentions. Elements use the returned <<<UUID>>> promptToken in params.prompt; generations use the returned generation_id in params.medias[].value with a role supported by the selected model. Do not generate until the user gives instructions. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"Case-insensitive substring of the element name or generation prompt, model, or UUID. Empty string returns recent usable references; generation search covers up to 300 recent completed jobs."}},"required":["query"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.search_reference_elements","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/search_reference_elements","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.models_recommend","title":"Recommend Models","description":"Read-only recommendation of generation models for a concrete user goal and input context. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":1024,"description":"Generation goal and input context, e.g. text-only, reference image, image-to-video, product media, or character portrait."},"type":{"description":"Filter by output type (omit to include all).","type":"string","enum":["image","video","audio","3d"]},"input":{"description":"Input filter: image = accepts reference media; text = text-only.","type":"string","enum":["text","image"]},"unlim":{"description":"When true, return only models that accept free-trial unlimited generations (supports_unlim). Use it to answer \"which models can I use my unlimited generations on\" in one call — each returned item still carries its aspect_ratios, parameters, and durations. Omit to include all models; false is the same as omitting it.","type":"boolean"},"limit":{"description":"Max recommendations, default 5.","type":"integer","minimum":1,"maximum":100}},"required":["query"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.models_recommend","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/models_recommend","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"score":{"type":"number"},"match_reason":{"type":"string"},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"}},"required":["id","name","provider_name","description","output_type","parameters","medias","aspect_ratios"],"additionalProperties":false}},"next_page_token":{"type":"string"},"has_more":{"type":"boolean"},"free_gens":{"description":"Free generations the caller can spend right now, one entry per counter with the model ids that share it. Answer \"what free generations do I have\" from this; pass use_free_gens:true to generate_video for Higgsfield Genjutsu or execute_preset for Viral when the user asks to use one. For ai_influencer_sheet, prepare with ai_influencer_prepare, then use ai_influencer_generate with use_free_gens:true and max_credits:0, never generate_image.","type":"array","items":{"type":"object","properties":{"job_set_types":{"type":"array","items":{"type":"string"},"description":"Job-set types sharing this counter. viral_hub_video covers all Viral chain presets; one preset execution spends one attempt. ai_influencer_sheet is spent through ai_influencer_generate with use_free_gens:true or the AI Influencer Builder’s Use free gens toggle."},"remaining":{"type":"number","description":"Free generations left on the counter. 0 = granted and spent."},"parameters":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"description":"Allowed values per request parameter for a free run; an absent parameter is uncapped."},"max_duration":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Upper bound in seconds for a free run, or null."}},"required":["job_set_types","remaining","parameters","max_duration"],"additionalProperties":false}},"related_tools":{"description":"Standalone tools (not catalog models) relevant to the recommend query — e.g. motion_control for recast/puppeteer, upscale_image/upscale_video for enhance, outpaint_image for expand/uncrop, reframe for a video aspect-ratio change, remove_background for cutout. Call the named tool directly; it will not appear in items.","type":"array","items":{"type":"object","properties":{"tool":{"type":"string"},"use_when":{"type":"string"}},"required":["tool","use_when"],"additionalProperties":false}},"error":{"type":"string"},"status":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_get_scene_asset","title":"3D Jutsu: get scene asset","description":"Resolve a signed GET for a scene asset referenced by an object.create.from_glb journal operation from scene_builder_3d_get_collaboration. Widget-only; use the asset ID, not a catalog ID or URL. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"assetId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["projectId","assetId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.scene_builder_3d_get_scene_asset","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_scene_asset","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"artifact":{"type":"object","properties":{"assetId":{"type":"string"},"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["assetId","size","etag"],"additionalProperties":false},"download":{"type":"object","properties":{"method":{"type":"string","const":"GET"},"url":{"type":"string","format":"uri"},"headers":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"expiresAt":{"type":"string"}},"required":["method","url","headers","expiresAt"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","artifact","download","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.ads_studio_update_product","title":"Update Ads Studio Product","description":"Change one Ads Studio product, or hide it from the brand page. picked_for_ads=false hides it and true shows it again; neither deletes anything, and a generation still advertises exactly the products it names. Every other field is a merge patch: what you leave out is left alone. Use the user's own words for the copy fields; do not invent selling points they did not say. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The brand that owns this product."},"product_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Product id from ads_studio_list_products."},"picked_for_ads":{"description":"False hides the product from the brand page, true shows it. Nothing is deleted or created.","type":"boolean"},"name":{"type":"string","maxLength":200},"custom_name":{"description":"User-edited display title; empty clears the override.","type":"string","maxLength":100},"images":{"description":"Replace product pictures with up to four existing or confirmed uploaded image URLs.","maxItems":4,"type":"array","items":{"type":"string","format":"uri"}},"description":{"anyOf":[{"type":"string","maxLength":4000},{"type":"null"}]},"price":{"description":"As the user says it, e.g. \"$90\" or \"from 4 900 RUB\".","anyOf":[{"type":"string","maxLength":100},{"type":"null"}]},"page_url":{"description":"The product's own page.","anyOf":[{"type":"string","format":"uri"},{"type":"null"}]},"audience":{"description":"Who it is for, when the user says.","anyOf":[{"type":"string","maxLength":500},{"type":"null"}]},"selling_points":{"description":"Replaces the whole list.","maxItems":12,"type":"array","items":{"type":"string","maxLength":300}}},"required":["brand_id","product_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_update_product","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_update_product","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"us