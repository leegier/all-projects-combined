ties":false}},{"name":"higgsfield.ai_influencer_list_presets","title":"AI Influencer: List Presets","description":"Browse AI Influencer character-sheet presets with previews and reusable settings. Does not generate a sheet. Pass selected preset settings to ai_influencer_prepare with randomize=false. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"preset_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"cursor":{"description":"Cursor from the previous page; omit for the first page.","type":"integer","minimum":1,"maximum":1000000},"size":{"description":"Page size; defaults to 20.","type":"integer","minimum":1,"maximum":100}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.ai_influencer_list_presets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_list_presets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"total":{"type":"integer","minimum":0,"maximum":9007199254740991},"cursor":{"anyOf":[{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},{"type":"null"}]},"items":{"type":"array","items":{"type":"object","pr