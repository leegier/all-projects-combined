},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"next_cursor":{"description":"Pass as cursor to get next page. Null if no more results.","anyOf":[{"type":"number"},{"type":"null"}]},"error":{"description":"Error message if the list could not be fetched.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.website_secrets","title":"Website Secret Names","description":"List configured secret names only. Values are never returned. Configure or remove secret values through Higgsfield's website settings; do not ask the user to paste credentials into chat. Secret changes take effect on the next deploy_website. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","minLength":1}},"required":["website_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.website_secrets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/website_secrets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"names":{"type":"array","items":{"type":"string"}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.canvas_add","title":"Add to Canvas","description":"Add items to an existing Higgsfield canvas board in the authenticated user's workspace: sticky notes, text, shapes, images, image and video generation nodes, and connections between items. It does not create pages; page_id puts an item on a page that is already on the board. Use it when the user asks to put something on a board; canvas_update changes existing items and canvas_remove deletes them. Added items are saved to the board and appear live for everyone viewing it, including an open_canvas view already shown: do not call open_canvas again to refresh it. A generation item saves its model, prompt and settings only: this tool does not start generation or charge generation credits; canvas_run does. Give a generation item only the settings the user asked for: the others stay the model's defaults, and the result lists the settings each generation node got and any value the model did not take. An image item imports a Higgsfield generation or upload image URL into the user's Higgsfield media; unsupported URL origins are rejected before the board changes, and imported media may remain even if adding to the board fails. A connection into a generation node feeds it: the source (an image, a video, another generation node's result, or text for the prompt) fills the node's matching free input (an image fills reference images before a start or end frame; set the connection's input to choose, e.g. start_image for an exact first frame), and canvas_run uses it. That is how to generate from an image on a board, e.g. image to video. Between other items a connection draws an arrow. Give items a key to connect them in the same call; connect to items an earlier call added by the ids it returned. To add more than 5 items, make several calls of up to 5 items each, in the order a person would lay them out (a card or a step at a time), so everyone viewing the board sees it grow, and set final on your last change to the board. Additions can partially apply: inspect applied and rejected before retrying, since repeating an addition creates duplicates. Returns the new items' ids in order, and each connection's id and the input it fills. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Canvas room_id (UUID) or the canvas URL containing it.","type":"string"},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"items":{"description":"Items to add, in order. Positions are top-left corners in px; leave ~40px between items.","minItems":1,"maxItems":100,"type":"array","items":{"oneOf":[{"type":"object","properties":{"type":{"type":"string","const":"sticky"},"key":{"description":"Your name for the new item, so connections in this call can reference it.","type":"string","minLength":1,"maxLength":64},"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000},"page_id":{"description":"Put the item on a page that is already on the board (a page node id from canvas_read). Omit for the main board.","type":"string","minLength":1},"text":{"type":"string","maxLength":2000},"color":{"description":"CSS color; default sticky yellow.","type":"string","maxLength":32}},"required":["type","x","y","text"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"text"},"key":{"description":"Your name for the new item, so connections in this call can reference it.","type":"string","minLength":1,"maxLength":64},"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000},"page_id":{"description":"Put the item on a page that is already on the board (a page node id from canvas_read). Omit for the main board.","type":"string","minLength":1},"text":{"type":"string","maxLength":10000},"width":{"description":"Wrap width in px, default 320.","type":"number","exclusiveMinimum":0,"maximum":20000},"font_size":{"type":"integer","minimum":8,"maximum":200}},"required":["type","x","y","text"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"shape"},"key":{"description":"Your name for the new item, so connections in this call can reference it.","type":"string","minLength":1,"maxLength":64},"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000},"page_id":{"description":"Put the item on a page that is already on the board (a page node id from canvas_read). Omit for the main board.","type":"string","minLength":1},"kind":{"type":"string","enum":["rectangle","circle","oval","diamond","triangle","inverted-triangle","parallelogram","trapezoid","hexagon","pentagon","octagon","star","plus","arrow-left","arrow-right","chevron","speech-bubble","cylinder"]},"label":{"type":"string","maxLength":2000},"width":{"type":"number","exclusiveMinimum":0,"maximum":20000},"height":{"type":"number","exclusiveMinimum":0,"maximum":20000},"color":{"type":"string","maxLength":32}},"required":["type","x","y","kind"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"image"},"key":{"description":"Your name for the new item, so connections in this call can reference it.","type":"string","minLength":1,"maxLength":64},"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000},"page_id":{"description":"Put the item on a page that is already on the board (a page node id from canvas_read). Omit for the main board.","type":"string","minLength":1},"url":{"type":"string","format":"uri","pattern":"^https:\\/\\/.*","description":"Image URL from a Higgsfield generation or upload. Imports the image into your Higgsfield media before the board changes; unsupported origins are rejected."},"width":{"type":"number","exclusiveMinimum":0,"maximum":20000},"height":{"type":"number","exclusiveMinimum":0,"maximum":20000}},"required":["type","x","y","url","width","height"],"additionalProperties":false},{"type":"object","properties":{"type":{"type":"string","const":"generation"},"key":{"description":"Your name for the new item, so connections in this call can reference it.","type":"string","minLength":1,"maxLength":64},"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000},"page_id":{"description":"Put the item on a page that is already on the board (a page node id from canvas_read). Omit for the main board.","type":"string","minLength":1},"kind":{"type":"string","enum":["image","video"],"description":"What the node generates."},"prompt":{"type":"string","maxLength":10000,"description":"The generation prompt."},"model":{"description":"Model id from this board's catalog. Omit for the default image or video model; an unknown id fails and lists the board's models.","type":"string","minLength":1,"maxLength":100},"settings":{"description":"Model settings by field id (aspect_ratio, duration, resolution, …): only those the user asked for, so the others stay the model's defaults. A value the model does not accept falls back to its default, and the result says so.","type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":64},"additionalProperties":{"anyOf":[{"type":"string","maxLength":200},{"type":"number"},{"type":"boolean"}]}}},"required":["type","x","y","kind","prompt"],"additionalProperties":false}]}},"connections":{"description":"Connections to add once the items are placed.","minItems":1,"maxItems":100,"type":"array","items":{"type":"object","properties":{"source":{"type":"string","minLength":1,"description":"A node id from canvas_read or an earlier canvas_add, or the key of an item added in this call."},"target":{"type":"string","minLength":1,"description":"A node id from canvas_read or an earlier canvas_add, or the key of an item added in this call. A generation node here makes this a data link: the source fills the node's matching input. Any other target gets an arrow."},"input":{"description":"Data links only: the generation input to fill, e.g. start_image to make an image the video's first frame. Omit to fill the first free matching input; an image then goes to reference images before start or end frames.","type":"string","minLength":1,"maxLength":64},"label":{"description":"Arrow text; a data link has none.","type":"string","maxLength":200},"path":{"description":"Arrow shape; a data link has none.","type":"string","enum":["straight","curved","elbow"]}},"required":["source","target"],"additionalProperties":false}},"final":{"description":"true on your last call that changes this board before you reply to the user (a canvas_run may still follow), so people viewing it see you finish right away. Leave it out while more changes follow.","type":"boolean"}},"required":["room_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.canvas_add","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_add","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.genjutsu_restyle","title":"Genjutsu Restyle","description":"Genjutsu Apply style for the Genjutsu app: list Higgsfield and custom styles, manage custom styles, quote and submit a Restyle of the source video. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"action":{"type":"string","const":"styles"},"cursor":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"string","pattern":"^\\s*-?\\d+(\\.\\d+)?\\s*$"}]}},"required":["action"]},{"type":"object","properties":{"action":{"type":"string","const":"custom_styles"},"cursor":{"type":"string","maxLength":512}},"required":["action"]},{"type":"object","properties":{"action":{"type":"string","const":"create_custom"},"media_ids":{"minItems":1,"maxItems":8,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}}},"required":["action","media_ids"]},{"type":"object","properties":{"action":{"type":"string","const":"update_custom"},"preset_id":{"type":"string","minLength":1,"maxLength":128},"name":{"type":"string","minLength":1,"maxLength":255},"media_ids":{"minItems":1,"maxItems":8,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}}},"required":["action","preset_id"]},{"type":"object","properties":{"action":{"type":"string","const":"delete_custom"},"preset_id":{"type":"string","minLength":1,"maxLength":128}},"required":["action","preset_id"]},{"type":"object","properties":{"action":{"type":"string","const":"quote"},"preset_id":{"type":"string","minLength":1,"maxLength":128},"duration":{"type":"number","exclusiveMinimum":0,"maximum":60},"resolution":{"type":"string","enum":["480p","720p","1080p"]},"image_count":{"type":"integer","minimum":0,"maximum":5}},"required":["action","preset_id","duration","resolution","image_count"]},{"type":"object","properties":{"action":{"type":"string","const":"submit"},"preset_id":{"type":"string","minLength":1,"maxLength":128},"video":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["video_input","video_job"]}},"required":["id","type"]},"images":{"default":[],"maxItems":5,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"resolution":{"type":"string","enum":["480p","720p","1080p"]},"prompt":{"type":"string","maxLength":60000}},"required":["action","preset_id","video","resolution"]}]},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.genjutsu_restyle","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/genjutsu_restyle","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"styles":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"custom":{"type":"boolean"},"poster":{"type":"string"},"card_video":{"type":"object","properties":{"url":{"type":"string"},"poster":{"type":"string"}},"required":["url"],"additionalProperties":false},"variants":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["edit","original","generation"]},"url":{"type":"string"},"poster":{"type":"string"}},"required":["id","kind","url"],"additionalProperties":false}},"references":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"media_id":{"type":"string"}},"required":["url"],"additionalProperties":false}}},"required":["id","name","custom","variants","references"],"additionalProperties":false}},"style":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"custom":{"type":"boolean"},"poster":{"type":"string"},"card_video":{"type":"object","properties":{"url":{"type":"string"},"poster":{"type":"string"}},"required":["url"],"additionalProperties":false},"variants":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["edit","original","generation"]},"url":{"type":"string"},"poster":{"type":"string"}},"required":["id","kind","url"],"additionalProperties":false}},"references":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"media_id":{"type":"string"}},"required":["url"],"additionalProperties":false}}},"required":["id","name","custom","variants","references"],"additionalProperties":false},"next_cursor":{"anyOf":[{"anyOf":[{"type":"number"},{"type":"string"}]},{"type":"null"}]},"credits":{"type":"number"},"unpriced":{"type":"boolean"},"results":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"status":{"type":"string"},"model":{"type":"string"}},"required":["id","type","status","model"],"additionalProperties":false}},"deleted":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.genjutsu_upload","title":"Upload Genjutsu Input","description":"Prepare or confirm an image, video, audio or file chosen in the Higgsfield UI, including Genjutsu inputs and files dropped into composer references, or resolve a recreated source video's URL. Confirm only after its presigned PUT succeeds. Documents return file context and cannot be used as generation inputs. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"action":{"type":"string","const":"prepare"},"kind":{"type":"string","enum":["video","image","audio","file"]},"filename":{"type":"string","minLength":1,"maxLength":255},"size_bytes":{"type":"integer","exclusiveMinimum":0,"maximum":104857600}},"required":["action","kind","filename","size_bytes"]},{"type":"object","properties":{"action":{"type":"string","const":"confirm"},"kind":{"type":"string","enum":["video","image","audio","file"]},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["action","kind","media_id"]},{"type":"object","properties":{"action":{"type":"string","const":"resolve_video"},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["action","media_id"]},{"type":"object","properties":{"action":{"type":"string","const":"resolve_image"},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["action","media_id"]}]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.genjutsu_upload","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/genjutsu_upload","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.ai_influencer_character_sheet_presets","title":"AI Influencer Character Sheet Presets","description":"App-only: load a page of AI Influencer character sheet presets with preview media and recreate parameters. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"preset_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"cursor":{"description":"Cursor from the previous page; omit for the first page.","type":"integer","minimum":1,"maximum":1000000},"size":{"description":"Page size; defaults to 20.","type":"integer","minimum":1,"maximum":100}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ai_influencer_character_sheet_presets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_character_sheet_presets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"total":{"type":"integer","minimum":0,"maximum":9007199254740991},"cursor":{"anyOf":[{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},{"type":"null"}]},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"},"preview":{"type":"object","properties":{"url":{"type":"string"}},"required":["url"],"additionalProperties":{}},"sheet":{"type":"object","properties":{"url":{"type":"string"}},"required":["url"],"additionalProperties":{}},"priority":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"recreate":{"anyOf":[{"type":"object","properties":{"job_set_type":{"type":"string","const":"ai_influencer_sheet"},"params":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total"]},"selection":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"type":"string"}}},"brief":{"type":"string"},"seed":{"type":"integer","minimum":1,"maximum":1000000},"medias":{"type":"array","items":{"not":{}}}},"required":["tier","selection","brief","seed","medias"],"additionalProperties":false}},"required":["job_set_type","params"],"additionalProperties":false},{"type":"null"}]},"recreate_unavailable_reason":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name","preview","sheet","priority","recreate","recreate_unavailable_reason"],"additionalProperties":false}},"error":{"type":"string"},"request_id":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.list_voices","title":"List Voices","description":"List available voices for speech and voice tools. Returns built-in preset voices plus the user's own custom voices. Each voice has a voice_id and a voice_type ('preset' or 'element'); pass that exact pair to the audio models (via generate_audio — seed_audio or text2speech_v2) and to the voice_change tool to select the speaking voice. Use the preview_url to hear a sample. Paginate with the returned next_cursor. Call this as the only tool in the turn when the voice pair is missing. The picker returns the selected pair in a new user turn so the pending narration can continue immediately. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"size":{"description":"Max voices to return, default 20.","type":"integer","minimum":1,"maximum":100},"cursor":{"description":"Pagination cursor (next_cursor from a previous list_voices result).","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/voices.html","ui":{"resourceUri":"ui://higgsfield/voices.html"},"resource_name":"higgsfield.list_voices","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_voices","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"voices":{"description":"Available voices.","type":"array","items":{"type":"object","properties":{"voice_id":{"type":"string","description":"Pass as voice_id to generate_audio (seed_audio / text2speech_v2) / voice_change."},"voice_type":{"type":"string","enum":["preset","element"],"description":"Pass as voice_type alongside voice_id."},"name":{"type":"string"},"gender":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Voice gender if known, else null."},"preview_url":{"description":"Sample audio URL.","type":"string"},"logo_url":{"description":"Voice logo/orb image URL for display.","type":"string"}},"required":["voice_id","voice_type","name","gender"],"additionalProperties":false}},"next_cursor":{"description":"Pass back as cursor to fetch the next page.","type":"string"},"has_more":{"description":"Whether more voices are available.","type":"boolean"},"selection_action":{"description":"Widget selection returns the exact voice pair and requests continuation of the pending narration.","type":"string","enum":["generate_pending_audio"]},"error":{"description":"Error message if voices could not be fetched.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_get_brand","title":"Get Ads Studio Brand","description":"Read one Ads Studio brand: how far its research got through the five stages (gather, synthesis, enrichment, products, assets) and what is already usable. Use this to answer \"is the research done?\" - status done means the brand and its products are ready. Call it when the user asks, not on a timer, and never in a loop: research can take several minutes. Follow next_step: a finished research is offered for ads, never generated on its own. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Ads Studio brand id, from ads_studio_list_brands or ads_studio_create_brand."}},"required":["brand_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_get_brand","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_get_brand","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"brand_id":{"type":"string"},"name":{"type":"string"},"website":{"type":"string"},"status":{"type":"string"},"research":{"type":"object","properties":{"stages":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"status":{"type":"string"}},"required":["name","status"],"additionalProperties":false}},"done_count":{"type":"number"},"total_count":{"type":"number"},"current":{"type":"string"}},"additionalProperties":false},"profile_ready":{"type":"boolean"},"tagline":{"type":"string"},"business_overview":{"type":"string"},"target_audience":{"type":"string"},"products_in_profile":{"type":"number"},"research_error":{"description":"Why the research failed, in ai-cmo's own words.","type":"string"},"gather_error":{"type":"string"},"enrichment_error":{"type":"string"},"products_error":{"type":"string"},"updated_at":{"type":"string"},"next_step":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.open_ai_influencer","title":"AI Influencer Builder","description":"Open the main Higgsfield AI Influencer Builder. For a bare 'ai influencer' request, open the builder immediately: the user chooses the design inside the UI, so no brief or clarification is needed before opening. Also use for the OpenAI /build-ai-influencer entrypoint, or when the user asks to open the builder UI. If current user or host context explicitly says the builder is already open, continue in chat without reopening unless requested. A previous open call does not establish current visibility. For creating described characters, multiple variants or a sheet directly in chat, use ai_influencer_prepare followed by ai_influencer_generate. Opens the existing builder directly, without generating a character sheet or video. Do not use for questions asking only to explain AI influencers. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ai-influencer.html","ui":{"visibility":["model","app"],"resourceUri":"ui://higgsfield/ai-influencer.html"},"resource_name":"higgsfield.open_ai_influencer","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/open_ai_influencer","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.generate_audio","title":"Generate Audio","description":"Generate speech/voice audio (text-to-speech). A successful submission returns job IDs; cost preflight and unlim_choice submit no job. Call it directly with the default model `seed_audio` (Seed Audio 1.0 by ByteDance) unless the user or an active skill requires a different engine. `seed_audio` needs an exact `voice_id` + `voice_type` pair ('preset' for a built-in voice, 'element' for one of the user's own). If either value is missing, call `list_voices` as the only tool in that turn so the user can choose. The picker returns the selected pair in a new user turn; continue the pending narration immediately with this tool using that pair. Never invent a voice_id. Optional tuning: `format`, `sample_rate`, `speech_rate` (-50..100), `loudness_rate` (-50..100), `pitch_rate` (-12..12). To use a specific named engine instead, set `model:'text2speech_v2'` and pass `variant` (one of elevenlabs|minimax|seed_speech|vibe_voice|cozy_voice) together with voice_type + voice_id. Use `models_get` / `models_search` to inspect a model's parameters. This tool only generates speech: it cannot generate music or sound effects — decline general music or sound-effect requests rather than substituting a speech model. All arguments go inside the single `params` object; `params.model` and `params.prompt` are required. `get_cost:true` returns the credit cost without submitting a job. This tool already displays its submitted jobs in an auto-updating generation widget, including while pending or in progress. Do not follow it with job_display, show_generations, or show_generation_by_ids merely to show or refresh the same results, before or after completion. To await completion, use jobs_wait with timeout_seconds <= 15; it does not open another widget. Use a separate display only when the user explicitly requests one or the workflow requires a distinct preview or approval. Headless generate_*_batch and execute_preset workflows follow their own display instructions. Submitted audio requests can send text and reference inputs to external audio model providers through Higgsfield and consume credits. On a transport timeout the submission outcome may be unknown: do not automatically resubmit. Reuse returned job IDs and retry only after the original outcome is known. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"model":{"type":"string","description":"Audio model ID (required). Default 'seed_audio'; use models_search/models_get to inspect others."},"prompt":{"type":"string","minLength":1,"description":"Text to speak."},"count":{"default":1,"description":"Audio generation is single-sample; use 1.","type":"number","const":1},"voice_type":{"description":"Whether voice_id is a built-in preset voice ('preset') or one of the user's own voices ('element'). Take it from list_voices.","type":"string","enum":["preset","element"]},"voice_id":{"description":"Voice id from list_voices. Pass together with voice_type; never invent one.","type":"string"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"get_cost":{"description":"If true, return the cost in credits for this generation without submitting any job.","type":"boolean"},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"}},"required":["model","prompt"],"additionalProperties":{}},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["params"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-v2.html","ui":{"resourceUri":"ui://higgsfield/generation-v2.html"},"resource_name":"higgsfield.generate_audio","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_audio","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"input_check":{"description":"Genjutsu required-media presence only. A successful price quote does not validate media existence, duration or generation readiness.","type":"object","properties":{"required_media_present":{"type":"boolean"},"image_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"video_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"missing_roles":{"type":"array","items":{"type":"string","enum":["image","video"]}},"generation_validated":{"type":"boolean","const":false}},"required":["required_media_present","image_count","video_count","missing_roles","generation_validated"],"additionalProperties":false},"prepared_params":{"description":"Genjutsu request params with resolved media UUIDs and applied adjustments. May be incomplete; inspect input_check. Reuse instead of importing the same references again. No generation has been submitted or validated.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"results":{"type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"error":{"type":"string"},"warning":{"type":"string"},"notice":{"type":"object","properties":{"type":{"type":"string"},"message":{"type":"string"},"data":{}},"required":["type","message"],"additionalProperties":false},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"avatar_auto_picked":{"description":"Set when the server auto-picked an avatar because product_ids were passed without avatars/avatar_ids (Marketing Studio video).","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string","enum":["preset","custom"]}},"required":["id","type"],"additionalProperties":false},"next_step":{"description":"Suggested follow-up tool call (e.g. show_marketing_studio fetch) attached to some marketing error results.","type":"object","properties":{"tool":{"type":"string"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["tool","params"],"additionalProperties":false},"unlim_choice":{"description":"NO JOB WAS SUBMITTED. The caller has free unlimited generations that cover this model, and nobody has said whether to spend them. Ask the user, then call the same tool again with use_unlim: true (free) or use_unlim: false (credits). Do not pick for them.","type":"object","properties":{"message":{"type":"string","description":"The question to put to the user, verbatim."},"model":{"type":"string","description":"Model the choice applies to."},"remaining":{"description":"Unlimited generations left; null means unmetered.","anyOf":[{"type":"number"},{"type":"null"}]},"expires_at":{"description":"ISO timestamp when the allowance lapses.","anyOf":[{"type":"string"},{"type":"null"}]}},"required":["message","model"],"additionalProperties":false},"brand_kit_status":{"description":"Live brand kit status when a generation was rejected because the kit is not ready yet.","type":"string"},"cost":{"description":"Populated only when the tool was called with get_cost: true. No job was submitted.","type":"object","properties":{"credits":{"type":"number","description":"Whole-credit cost (max(1, exact // 1) when exact > 0)."},"credits_exact":{"type":"number","description":"Exact credit cost as a float."}},"required":["credits","credits_exact"],"additionalProperties":false}},"additionalProperties":false}},{"name":"higgsfield.report_community_preset","title":"Report Community Preset","description":"Submit the user's report of a Genjutsu community preset from the app. Requires the community CMS preset ID and a report reason; something_else requires text. This submits a moderation report and does not hide or delete the preset. Only submit after the user chooses to report it. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"preset_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Community CMS preset ID, not a generation/job ID."},"reason":{"type":"string","enum":["spam","abuse_or_harassment","hate_speech_or_violence","scam_or_impersonation","nsfw_content","something_else","uses_my_copyright"]},"text":{"type":"string","maxLength":500}},"required":["preset_id","reason"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.report_community_preset","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/report_community_preset","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.ads_studio_delete_brand","title":"Delete Ads Studio Brand","description":"Delete the brand and its research/products after the app's explicit confirmation. Requires the fresh, one-use widget token from ads_studio_prepare_delete. UUID-only calls never delete. Does not use chat. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"confirmation_token":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$","description":"Fresh one-use token from the confirmation widget's prepare-delete response."}},"required":["brand_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ads_studio_delete_brand","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_delete_brand","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.website_status","title":"Website Status","description":"Get the website's deploy status — the live URL and the status of the last deploy. Use to check a deploy that returned 'pending', or to fetch the live URL. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","description":"The website's id (returned by create_website)."}},"required":["website_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.website_status","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/website_status","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"slug":{"anyOf":[{"type":"string"},{"type":"null"}]},"production":{"type":"object","properties":{"status":{"anyOf":[{"type":"string"},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"error":{"anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false},"listed_in_community":{"description":"Whether the website is currently on the community feed.","type":"boolean"},"marketplace_url":{"description":"The website's community-feed listing page, when listed.","anyOf":[{"type":"string"},{"type":"null"}]},"submitted_to_contest":{"description":"Whether the website is currently entered in the app contest.","type":"boolean"},"contest_urls":{"description":"The social-media links submitted with the contest entry.","type":"array","items":{"type":"string"}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.list_websites","title":"List Websites","description":"List the websites you own — each with its id, name, slug, and live URL. Use this to find the id of a website you created earlier so you can edit, deploy, or check its status. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.list_websites","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_websites","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"websites":{"type":"array","items":{"type":"object","properties":{"website_id":{"type":"string"},"slug":{"anyOf":[{"type":"string"},{"type":"null"}]},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"type":{"description":"'website' (standalone) or 'app' (Higgsfield-integrated).","type":"string"},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"production_deployed":{"type":"boolean"},"created_at":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["website_id"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_generations","title":"Show Generations","description":"Browse completed non-Marketing Studio generation history by default, or include all job states for a live feed with only_completed=false. Renders one paginated page in the gallery widget. Returns generations with {id, type, status, model, params, results}. Use only when the user explicitly asks to browse regular generation history. Do not use this history tool after generate_*_batch or jobs_wait; show an exact completed batch with one show_generation_by_ids call instead. Use show_marketing_studio_generations for Marketing Studio video/image/ad history. Pass a prior generation's id as value in the medias array of a new generation to reuse it. Use job_display only to inspect one specific previous result. Paginated: if next_cursor is not null, pass it as cursor to get the next page. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"type":{"description":"Filter by media type","type":"string","enum":["image","video","audio","3d"]},"only_completed":{"description":"Defaults to true. Set false to include jobs in every state, including jobs still generating.","type":"boolean"},"cursor":{"anyOf":[{"type":"number"},{"type":"string","pattern":"^\\s*-?\\d+(\\.\\d+)?\\s*$"}],"description":"Pass next_cursor from previous response to get next page"},"size":{"anyOf":[{"default":24,"type":"integer","minimum":1,"maximum":100},{"type":"string","pattern":"^\\s*-?\\d+(\\.\\d+)?\\s*$"}],"description":"Number of results per page"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/job-list.html","ui":{"resourceUri":"ui://higgsfield/job-list.html"},"resource_name":"higgsfield.show_generations","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_generations","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"description":"Array of generations. Absent on error.","type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"next_cursor":{"description":"Pass as cursor to get next page. Null if no more results.","anyOf":[{"type":"number"},{"type":"null"}]},"error":{"description":"Error message if the list could not be fetched.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.create_website","title":"Create Website","description":"Start a new full-stack website. Creates the website and a git repo: a React 19 + TanStack Start app, server-rendered, in ONE Cloudflare Worker, with D1 / R2 / KV / Durable Objects / Containers available (all DISABLED by default). Returns a website_id — pass it to every later website tool. The 'type' param is REQUIRED and is the USER'S choice, not yours: unless the user has already made it unambiguous, ASK the user whether they want a plain website (no Higgsfield integration) or a Higgsfield-integrated app (Sign in with Higgsfield + AI image/video generation via the Higgsfield SDK) BEFORE calling this tool. Apps are scaffolded from a v2 starter template and REQUIRE the 'template' param — pick the closest of studio / preset / app-detail per the template param's guide ('custom' is ONLY for when the user explicitly says \"use custom template\" — never pick it yourself). The chosen layout ships as real code already wired as the home page; you ADAPT IT IN PLACE, never rebuild it. Websites take an OPTIONAL template: pass 'scroll-scrub' for an animated website (its scrub engine ships pre-built) and omit it for a non-animated one. App and website templates are not interchangeable — a cross-kind name is rejected. Workflow: (0) use the installed website-builder skill and its bundled references FIRST to load the stack, design contract, and hard rules (REQUIRED before building or editing); (1) create_website; (2) call website_repo_access with checkout, edit/commit using sandbox_exec, then website_repo_access with push (for apps, read app/src/layouts/AGENTS.md + app/src/components/AGENTS.md right after cloning); (3) deploy_website to ship it live — and deploy again after ANY later change (publish_website only lists what is already live; it does not deploy). This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"type":{"type":"string","enum":["website","app","game"],"description":"REQUIRED — what the user chose to build. 'website': a standalone site with NO Higgsfield integration (no Sign in with Higgsfield, no requests to Higgsfield). 'app': a product tightly integrated with Higgsfield — its users sign in with Higgsfield and generate images/videos through the Higgsfield SDK. 'game': a browser game with realtime multiplayer rooms — requires a game genre as category and takes NO template. This is the user's decision: if their request doesn't make it obvious, ask them which one they want before creating."},"category":{"type":"string","description":"REQUIRED — the content category the website is filed under, a slug from the marketplace taxonomy (e.g. 'cinematic', 'ads-marketing', 'ugc-social', 'other'). Call list_website_categories to get the exact valid slugs, then pass the closest one ('other' when nothing fits). The server rejects an unknown slug."},"template":{"description":"The starter template the repo is scaffolded from. Its code arrives already wired as the home page — you adapt it in place, not rebuild it. The valid names depend on `type`, and a mismatch is rejected. type='website' — OPTIONAL: 'scroll-scrub' = the animated website (the visitor's scroll plays a generated film); its scrub engine ships pre-built, so you generate the film and fill in scenes instead of writing a controller. Pass it for EVERY animated website (the default per the website-builder flow). OMIT `template` only for a non-animated site. Never pass an app template for a website. type='app' — REQUIRED, pick the closest to the product: 'studio' = full creative workspace (projects sidebar + floating prompt dock + edge-to-edge generations feed) for multi-project generation tools; 'preset' = pick-a-style-then-generate (persistent left creation rail beside a browsable preset grid with History tab); 'app-detail' = a single tool's landing page (two-column generator hero + how-it-works steps) — the 'simple app'. Any other request shape (before/after slider, step-by-step wizard, upload-configure-iterate) still maps to the closest of these three; the shared components in app/src/components/ cover those patterns. 'custom' (bare shell, no shipped layout) is ONLY for when the user explicitly says \"use custom template\" — never pick it yourself. ","type":"string","enum":["app-detail","preset","studio","custom","scroll-scrub"]},"subdomain":{"description":"The website's subdomain — it becomes the slug, so the live URL is <subdomain>.<host>. ALWAYS set this: pick a short, memorable subdomain from the site's name or purpose (lowercase letters, digits, and single hyphens only; DNS-safe). Only omit it — which falls back to a random subdomain — if the user explicitly asks for a random one. A few reserved labels (e.g. 'api', 'www') and already-taken subdomains are rejected; if that happens, try a close variant.","type":"string"}},"required":["type","category"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.create_website","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/create_website","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"website_id":{"description":"The new website's id. Remember it.","type":"string"},"slug":{"description":"URL slug (also the repo name).","anyOf":[{"type":"string"},{"type":"null"}]},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"type":{"description":"The product kind that was created: 'website' or 'app'.","type":"string"},"template":{"description":"The starter template the site was scaffolded from.","type":"string"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.get_account_overview","title":"Account Overview","description":"Retrieve the authenticated user's available free-trial offer and account URL for display in the app. Fetching the offer may create a checkout session, but does not start a trial or charge a payment method. Invoked only by the app. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"info":{"type":"string","const":"free_trial","description":"Account information requested by the app."}},"required":["info"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.get_account_overview","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_account_overview","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"free_trial":{"description":"Available free trial offer, or null when none is available.","anyOf":[{"type":"object","properties":{"kind":{"description":"What the card's checkout starts: 'mcp' (legacy 3-day/100-credit trial), 'mcp_all_unlim' (1-day unlimited-generations trial), etc. Open list — unknown values render as a generic trial.","anyOf":[{"type":"string"},{"type":"null"}]},"plan_type":{"type":"string","description":"Plan the trial converts into (plus)."},"billing_period":{"type":"string","enum":["monthly","annual"],"description":"Billing period of the post-trial subscription."},"unlim_trial_in_mcp_active":{"description":"Presentation-only gate derived from the offer's `kind` — true for unlimited-generation kinds. False/absent keeps the legacy trial card.","type":"boolean"},"trial_days":{"type":"number","description":"Trial length in days — derived from `kind` on the BE; never hardcode."},"trial_credits":{"type":"number","description":"Credits granted for the trial. 0 is valid for unlimited kinds (their value is the unlim entitlement, not credits)."},"then_price_cents":{"type":"number","description":"Price auto-charged to the saved card after the trial unless cancelled."},"currency":{"description":"ISO currency code (usd/eur/gbp) for then_price_cents; absent means USD.","type":"string"},"headline":{"type":"string","description":"Trial card title, e.g. '3-Day Free Plus Trial'."},"tagline":{"type":"string"},"credits_line":{"type":"string","description":"e.g. '100 credits for 3 days'."},"credit_equivalents":{"type":"array","items":{"type":"string"},"description":"STATIC marketing approximations ('= 50 Nano Banana Pro images'), not API data."},"price_line":{"type":"string","description":"e.g. '$0 for 3 days, then renews at $49/mo'."},"cta_label":{"type":"string"},"renewal_caption":{"type":"string","description":"Caption under the CTA, e.g. 'Renews to Plus ($49/mo) after 3-day trial'."},"compliance_note":{"type":"string","description":"Full trial disclosures: MCP-only, credits never appear on higgsfield.ai, auto-charge after the trial unless cancelled, how to cancel, exclusions. Always relay in text-only clients."},"url":{"type":"string","description":"Backend-provided account URL. Return unchanged."}},"required":["plan_type","billing_period","trial_days","trial_credits","then_price_cents","headline","tagline","credits_line","credit_equivalents","price_line","cta_label","renewal_caption","compliance_note","url"],"additionalProperties":false},{"type":"null"}]},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_get_artifact","title":"3D Jutsu: get artifact","description":"Resolve a short-lived download for an image or video that a successful Python operation\npublished through `artifacts`. Use the artifact ID and operation ID or revision returned by\nthat operation; do not invent IDs or filesystem paths. Query artifacts can be operation-scoped\nwithout a new committed revision. This retrieves an existing artifact and does not render one.\nTo create a preview, render and publish it with `scene_builder_3d_query_python` or\n`scene_builder_3d_run_python`. Inspect the returned image using the client's image capability\nbefore judging framing, lighting, materials, and geometry. If the client cannot inspect it,\ndescribe that limitation rather than claiming a visual check passed. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"artifactId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Exact committed revision inspected; do not guess."}},"required":["projectId","artifactId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"oneOf":[{"required":["operationId"]},{"required":["revision"]}]}]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_get_artifact","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_artifact","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"download":{"type":"object","properties":{"method":{"type":"string","enum":["GET","PUT"]},"url":{"type":"string","format":"uri"},"headers":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"expiresAt":{"type":"string"}},"required":["method","url","headers","expiresAt"],"additionalProperties":false},"artifact":{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"type":{"type":"string","enum":["glb","blend"]},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"operationId":{"type":"string"},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["projectId","revision","size","etag"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","download","artifact","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.ads_studio_list_runs","title":"List Ads Studio Generations","description":"List recent Ads Studio generation runs, newest first, optionally for one brand. Use it to find a run whose id was lost, or to check what is already in flight before starting another batch. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Ads Studio brand id, from ads_studio_list_brands or ads_studio_create_brand."},"limit":{"description":"How many runs to return; default 20.","type":"integer","minimum":1,"maximum":50}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.ads_studio_list_runs","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_list_runs","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"runs":{"type":"array","items":{"type":"object","properties":{"run_id":{"type":"string"},"status":{"type":"string"},"stage":{"type":"string"},"subject":{"type":"string"},"brand_id":{"type":"string"},"product_id":{"type":"string"},"concepts_requested":{"type":"number"},"aspect_ratio":{"type":"string"},"rendered":{"type":"number"},"rendering":{"type":"number"},"waiting":{"type":"number"},"failed":{"type":"number"},"created_at":{"type":"string"}},"additionalProperties":false}},"count":{"type":"number"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_list_products","title":"List Ads Studio Products","description":"List Ads Studio products and open them as a card the user can browse: name, price, page, how many pictures it has, whether the brand page shows it (picked_for_ads) and whether its ad copy is ready. With brand_id: that brand's products. Without it: every product the user has - of any brand or of none - a page at a time. Use product_id in ads_studio_quote and ads_studio_generate: a generation advertises exactly the products named there, whatever picked_for_ads says. texts_ready=false means the copy is still being written and ads made from it come out weaker. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Ads Studio brand id, from ads_studio_list_brands or ads_studio_create_brand."},"include_unpicked":{"description":"With brand_id: include products hidden from the brand page (default true).","type":"boolean"},"cursor":{"description":"Without brand_id: next_cursor from the previous page, unchanged.","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_list_products","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_list_products","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"brand_id":{"type":"string"},"products":{"type":"array","items":{"type":"object","properties":{"product_id":{"type":"string"},"brand_id":{"type":"string"},"name":{"type":"string"},"price":{"type":"string"},"page_url":{"type":"string"},"images_count":{"type":"number"},"picked_for_ads":{"type":"boolean"},"texts_ready":{"type":"boolean"}},"additionalProperties":false}},"count":{"type":"number"},"next_cursor":{"description":"Without brand_id: pass back as cursor for the next page.","type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.marketing_get_brand_kit","title":"Get Brand Kit","description":"Read-only fetch of one existing brand kit by id. Does not create, update, delete, or scrape websites. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_kit_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Brand kit ID."}},"required":["brand_kit_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_get_brand_kit","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_get_brand_kit","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"item":{},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_get_collaboration","title":"3D Jutsu: get collaboration","description":"Read the 3D Jutsu editor snapshot, entity versions, World settings and journal after an optional sequence. Widget-only companion to scene_builder_3d_get_project; download the checkpoint with scene_builder_3d_get_glb. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"after":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["projectId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.scene_builder_3d_get_collaboration","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_collaboration","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"collaboration":{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"appliedSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"checkpoint":{"anyOf":[{"type":"object","properties":{"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"blend":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"glb":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"createdAt":{"type":"string"}},"required":["revision","sequence","blend","glb","createdAt"],"additionalProperties":false},{"type":"null"}]},"entities":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["object","camera","light","world","timeline"]},"version":{"type":"integer","minimum":0,"maximum":9007199254740991},"deleted":{"type":"boolean"},"lastSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"state":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["id","kind","version","deleted","lastSequence","state"],"additionalProperties":false}},"operations":{"type":"array","items":{"type":"object","properties":{"sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"operationId":{"type":"string"},"actorId":{"type":"string"},"baseSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"entityId":{"type":"string"},"expectedEntityVersion":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"entityVersionAfter":{"type":"integer","minimum":0,"maximum":9007199254740991},"kind":{"type":"string"},"payload":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"status":{"type":"string","enum":["accepted","conflicted","rejected"]},"createdAt":{"type":"string"}},"required":["sequence","operationId","actorId","baseSequence","entityId","expectedEntityVersion","entityVersionAfter","kind","payload","status","createdAt"],"additionalProperties":false}}},"required":["projectId","revision","sceneSequence","appliedSequence","checkpoint","entities","operations"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","collaboration","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.canvas_update","title":"Update Canvas Items","description":"Change existing items on a Higgsfield canvas board in the authenticated user's workspace: move them, resize them, or replace the text of sticky notes, text blocks and shapes. Each change names a node id from canvas_read or canvas_add and gives a new position (x and y), a new size (width and height), new text, or several of these. Use it when the user asks to rearrange, resize or reword items; canvas_add adds items and canvas_remove deletes them. New values overwrite the old ones, are saved to the board and appear live for everyone viewing it, including an open_canvas view already shown. Changes can partially apply: inspect applied and rejected before retrying. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Canvas room_id (UUID) or the canvas URL containing it.","type":"string"},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"changes":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"object","properties":{"node":{"type":"string","minLength":1,"description":"A node id from canvas_read or canvas_add."},"x":{"description":"New left edge in px, together with y.","type":"number","minimum":-1000000,"maximum":1000000},"y":{"description":"New top edge in px, together with x.","type":"number","minimum":-1000000,"maximum":1000000},"width":{"description":"New width in px, together with height.","type":"number","exclusiveMinimum":0,"maximum":20000},"height":{"description":"New height in px, together with width.","type":"number","exclusiveMinimum":0,"maximum":20000},"text":{"description":"New text of a sticky note, text block or shape; replaces its text.","type":"string","maxLength":10000}},"required":["node"],"additionalProperties":false},"description":"One entry per item: a new position, size or text, or several of them."},"final":{"description":"true on your last call that changes this board before you reply to the user (a canvas_run may still follow), so people viewing it see you finish right away. Leave it out while more changes follow.","type":"boolean"}},"required":["room_id","changes"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.canvas_update","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_update","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.marketing_list_hooks","title":"List Marketing Hooks","description":"Read-only list of existing Marketing Studio setup hooks. Use returned ids as hook_id in generate_video. Does not create, update, or delete hooks. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"size":{"default":20,"type":"integer","minimum":1,"maximum":100},"cursor":{"type":"number"},"search":{"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_hooks","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_hooks","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"user_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"preset_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"has_more":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.marketing_list_video_presets","title":"List Marketing Video Presets","description":"Read-only list of Marketing Studio video modes (formats) and their example presets. Each format has a `slug` (pass as generate_video params.mode) plus example presets carrying ready-to-reuse `params`. Let the user pick a format before generating — or choose the best fit yourself if they asked you to decide. Does not create or modify marketing assets. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_video_presets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_video_presets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"formats":{"type":"array","items":{}},"presets":{"type":"array","items":{}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.video_analysis_jobs","title":"Video Analysis Jobs","description":"List the user's video analyses in the current workspace, newest first. Paginate by passing the previous response's cursor. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"size":{"description":"Page size.","type":"integer","minimum":1,"maximum":100},"cursor":{"description":"Pagination cursor — unix timestamp of created_at from the previous page (advances backwards in time). Omit for the first page.","anyOf":[{"type":"number"},{"type":"null"}]}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.video_analysis_jobs","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/video_analysis_jobs","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"video_input_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"youtube_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","enum":["queued","in_progress","completed","failed"]},"fail_reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"video_s3_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"scenes":{"anyOf":[{"type":"array","items":{}},{"type":"null"}]}},"required":["id","video_input_id","youtube_url","status","fail_reason","video_s3_url","scenes"],"additionalProperties":false}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]}},"required":["items","total_count","cursor"],"additionalProperties":false}},{"name":"higgsfield.generate_audio_batch","title":"Generate Audio Batch","description":"Submit 1-6 independent audio generations in parallel without opening a widget. Requests can send text and reference inputs to external audio model providers through Higgsfield and consume credits. Each requests[] item accepts generation params with count fixed to 1 and no get_cost, creates one job on successful submission, and keeps its caller-provided index in the response. Use for multiple distinct prompts or inputs; use generate_audio for one user-facing generation. Poll returned job IDs with jobs_wait in agent-chosen groups of at most 8. For larger sets, collect indexed jobs across submission batches. After every job in the user's set is terminal, pass the collected jobs to exactly one show_generation_by_ids call for up to 24 jobs; never use show_generations or call job_display once per job. A partial failure or timeout does not make the whole batch safe to retry: keep returned job IDs and resolve unknown submission outcomes before retrying affected items. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"requests":{"minItems":1,"maxItems":6,"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Caller-provided stable index, such as the scene number."},"params":{"type":"object","properties":{"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"model":{"type":"string","description":"Audio model ID (required). Default 'seed_audio'; use models_search/models_get to inspect others."},"prompt":{"type":"string","minLength":1,"description":"Text to speak."},"count":{"default":1,"description":"Each successfully submitted batch item creates one job; rejected items or choices create none. Add another requests[] item for another generation.","type":"number","const":1},"voice_type":{"description":"Whether voice_id is a built-in preset voice ('preset') or one of the user's own voices ('element'). Take it from list_voices.","type":"string","enum":["preset","element"]},"voice_id":{"description":"Voice id from list_voices. Pass together with voice_type; never invent one.","type":"string"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"get_cost":{"description":"Cost preflight is not supported inside a batch submission.","not":{}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"}},"required":["model","prompt"],"additionalProperties":{}}},"required":["index","params"],"additionalProperties":false},"description":"Ordered audio generation requests. Response jobs keep the provided indices."},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["requests"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.generate_audio_batch","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_audio_batch","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"jobs":{"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"anyOf":[{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},{"type":"string","const":"submission_failed"}]},"error":{"type":"string"},"warning":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"preset_recommendation":{"description":"Full-profile preset recommendation. Retry the same indexed request with declined_preset_id=preset_id to generate literally.","type":"object","properties":{"preset_id":{"type":"string"},"name":{"type":"string"},"preview_url":{"type":"string"}},"required":["preset_id","name"],"additionalProperties":false}},"required":["index","status"],"additionalProperties":false}},"submitted_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"failed_count":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["jobs","submitted_count","failed_count"],"additionalProperties":false}},{"name":"higgsfield.ad_multiplier_quote","title":"Ad Multiplier price","description":"Quote an Ad Multiplier v2 recreation or the maximu