rary","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"cards":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"preset_source":{"type":"string","enum":["higgsfield","community"]},"title":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"model":{"type":"string","enum":["hf_mult_motion_control","hf_mult_replace_object"]},"mode":{"type":"string","enum":["motion_transfer","objects_swap"]},"aspect":{"type":"string","enum":["9/16","3/2","16/9"]},"poster_url":{"type":"string"},"preview_url":{"type":"string"},"video_url":{"type":"string"},"prompt":{"anyOf":[{"type":"string"},{"type":"null"}]},"author":{"anyOf":[{"type":"string"},{"type":"null"}]},"likes":{"anyOf":[{"type":"number"},{"type":"null"}]},"recreate_policy":{"type":"string","const":"selected-only"},"source_video":{"type":"object","properties":{"url":{"type":"string"},"poster_url":{"type":"string"},"media_id":{"type":"string"},"media_type":{"type":"string","enum":["video_input","video_job"]},"duration":{"type":"number"}},"required":["url","poster_url"],"additionalProperties":false},"inputs":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"role":{"type":"string"},"media_id":{"type":"string"}},"required":["url","role"],"additionalProperties":false}},"variants":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["source","edit","generation"]},"recreatable":{"type":"boolean"},"poster_url":{"type":"string"},"video_url":{"type":"string"}},"required":["id","kind","poster_url","video_url"],"additionalProperties":false}},"recreate":{"anyOf":[{"type":"object","properties":{"example_id":{"type":"string"},"source":{"type":"string","const":"genjutsu_motion_library"},"title":{"type":"string"},"model":{"type":"string","enum":["hf_mult_motion_control","hf_mult_replace_object"]},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["example_id","source","title","model","params"],"additionalProperties":false},{"type":"null"}]}},"required":["id","title","description","model","mode","aspect","poster_url","preview_url","video_url","prompt","author","likes","source_video","inputs","recreate"],"additionalProperties":false}},"next_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.visual_effects_list","title":"List Visual Effects","description":"Read the website's public visual preset previews and category filters. Does not generate media. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"category":{"default":"all","type":"string","minLength":1,"maxLength":120},"cursor":{"default":0,"type":"integer","minimum":0,"maximum":9007199254740991},"size":{"default":50,"type":"integer","minimum":1,"maximum":50}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.visual_effects_list","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/visual_effects_list","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.sandbox_exec","title":"Sandbox Shell","description":"Execute a shell command in a remote Higgsfield cloud Linux sandbox — NOT your local machine or the client's own shell. Use it for Higgsfield media workflows and website_repo_access checkouts that require the hosted toolchain. Do not use it to inspect a local repository, install desktop software, or control applications on the user's computer. Preinstalled: ffmpeg/ffprobe, ImageMagick, sox, python3 with Pillow and faster-whisper, node/npm/npx, sharp-cli, Playwright with headless Chromium, caption fonts (Metropolis, Montserrat), zip/unzip, git, curl, jq. Use it for media processing (trim, convert, overlay, concat with ffmpeg), image manipulation, and packaging that dedicated Higgsfield tools do not cover. The sandbox is isolated per user. After its running lease expires it pauses with files and process memory preserved; a later call resumes it. Paused state is retained for 24 hours, but is not durable storage: export finished results. A result with sandbox_created:true indicates a new sandbox, so files from earlier calls are not present; re-download missing inputs. It has internet access: bring files in with curl from media URLs (media_import_url or generation results). For an output created here, call media_upload BEFORE starting the producing command, then append `curl -f -X PUT --upload-file <file> '<upload_url>'` to that SAME command so the ephemeral file is uploaded before it exits; call media_confirm only after HTTP 200. Never pass a sandbox path to media_upload_and_confirm: that tool accepts only client attachments. Commands run in /home/user and time out after timeout_seconds (default 60, max 120); for longer work (large renders, installs) set background:true and poll the returned log/status files with later sandbox_exec calls. Background work receives a 15-minute sandbox lease, and shorter poll calls never reduce its remaining lifetime. Set restart:true to discard the sandbox and start clean. For actual visual inspection, pass image_paths (up to 4 PNG/JPEG paths, <=512 KiB total) with a foreground command: images are returned natively to the model, not as text or URLs. With background work, wait for completion then use a foreground poll with image_paths before its lease expires. No upload is needed for inspection. The command limit is 16000 characters including signed URLs; keep upload batches small and use installed scripts. Workflow bundle scripts are already installed in every sandbox under $HF_WORKFLOWS (/home/user/.higgsfield/workflows), laid out as $HF_WORKFLOWS/<workflow>/scripts/... — run them straight from there (they survive restart:true), and never paste script contents into the command. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"command":{"type":"string","minLength":1,"maxLength":16000,"description":"Shell command to run (bash). Runs in the persistent per-user sandbox."},"timeout_seconds":{"description":"Seconds before the command is killed (default 60, max 120). Ignored with background:true.","type":"integer","minimum":1,"maximum":120},"background":{"description":"Run the command detached and return immediately with a pid, log_path, and status_path. Poll with a later sandbox_exec call; stop with kill <pid>.","type":"boolean"},"restart":{"description":"Discard the current sandbox (all files and processes) and start a fresh one before running the command.","type":"boolean"},"image_paths":{"description":"PNG/JPEG files to return as native images after a successful foreground command. All image files together must be <=512 KiB; split larger sets across calls. Relative paths start at /home/user. Inspect the actual images before writing visual review verdicts.","minItems":1,"maxItems":4,"type":"array","items":{"type":"string","minLength":1,"maxLength":1024}}},"required":["command"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.sandbox_exec","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/sandbox_exec","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"stdout":{"type":"string"},"stderr":{"type":"string"},"exit_code":{"type":"number"},"truncated":{"description":"True when stdout/stderr were truncated. Re-run with a narrower command (head, grep, wc) for full data.","type":"boolean"},"pid":{"description":"Background process id (background:true only).","type":"number"},"log_path":{"description":"File collecting the background command's combined output (background:true only).","type":"string"},"status_path":{"description":"File containing the terminal exit code once a background command finishes.","type":"string"},"error":{"type":"string"},"sandbox_created":{"description":"True when this call acquired a new sandbox without files or processes from earlier calls.","type":"boolean"}},"additionalProperties":false}},{"name":"higgsfield.track_generation_download","title":"Track Generation Download","description":"Record a generation download started by the authenticated user in the app. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["job_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.track_generation_download","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/track_generation_download","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.scene_builder_3d_generate_video","title":"3D Jutsu: generate video","description":"Generate a paid Seedance 2.5 video in a 3D Jutsu project. Use a prompt alone (t2v), medias with image/start_image/end_image/video/audio roles (omni_reference), one video for video_edit, or videos plus extensionMode for video_extension. References use data:{id,type} from accessible FNF uploads or prior jobs, never URLs. Supports up to 30 images, 10 videos, 10 audio clips, 50 total. Optionally supply operationId/artifactId together to use a published Blender render as start_image; it counts toward the limits and cannot coexist with another start_image or non-omni mode. Omit mode to infer t2v or omni_reference. Supports bitrateMode, draft (480p) and draftJobId (1080p finalization, mutually exclusive with draft). Worker saves all inputs and shared project history. Preserve requestId and identical arguments on retry; poll scene_builder_3d_get_generation. Never allocate a new ID to recover an uncertain submission. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"artifactId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"prompt":{"type":"string","minLength":1,"maxLength":60000},"resolution":{"default":"720p","type":"string","enum":["480p","720p","1080p"]},"aspectRatio":{"default":"16:9","type":"string","enum":["auto","21:9","16:9","4:3","1:1","3:4","9:16"]},"duration":{"default":5,"type":"integer","minimum":4,"maximum":30},"generateAudio":{"default":true,"type":"boolean"},"mode":{"type":"string","enum":["t2v","omni_reference","video_edit","video_extension"]},"medias":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","enum":["image","start_image","end_image","video","audio"]},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9_]+$"}},"required":["id","type"],"additionalProperties":false}},"required":["role","data"],"additionalProperties":false}},"bitrateMode":{"type":"string","enum":["standard","high"]},"extensionMode":{"type":"string","enum":["backward","forward"]},"draft":{"type":"boolean"},"draftJobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","descr