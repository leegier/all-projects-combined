ins_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.ai_influencer_get_settings","title":"AI Influencer: Get Settings","description":"Read reusable settings from an existing AI Influencer sheet using its job_id. Returns human or animal traits, identity and Style references, body color and saved appearance variants when present. Does not replay the original batch count, quote, save or generate an image. Pass returned params to ai_influencer_prepare with randomize=false to preserve the design. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["job_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.ai_influencer_get_settings","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_get_settings","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.co