},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"new_jobs":{"type":"boolean"},"transport":{"type":"string","enum":["stream","poll"]},"waited_ms":{"type":"number"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.marketing_list_products","title":"List Marketing Products","description":"Read-only list of Marketing Studio products. Does not fetch websites, create products, or modify products. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"limit":{"default":20,"type":"integer","minimum":1,"maximum":100},"offset":{"default":0,"type":"integer","minimum":0,"maximum":9007199254740991}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_products","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_products","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"user_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"preset_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"has_more":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ai_influencer_get_options","title":"AI Influencer: Get Options","description":"List available AI Influencer character traits for human and animal tiers. Optionally filter by tier; returns option IDs and tier constraints for ai_influencer_prepare. Does not randomize, quote, create or save a character. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.ai_influencer_get_options","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_get_options","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"tiers":{"type":"array","items":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]}},"groups":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"},"max":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"options":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"},"tiers":{"type":"array","items":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]}},"slot":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","label","tiers","slot"],"additionalProperties":false}}},"required":["id","label","max","options"],"additionalProperties":false}}},"required":["tiers","groups"],"additionalProperties":false}},{"name":"higgsfield.canvas_read","title":"Read Canvas","description":"Read a canvas board: every node with its id, type, position, size and text, grouped by page, and the arrows between them. Filter by types, text query or node_ids on big boards. Read before adding so new items do not overlap existing ones, and for the node and edge ids that canvas_update and canvas_remove take. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Canvas room_id (UUID) or the canvas URL containing it.","type":"string"},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"types":{"description":"Only these node types (stickyNote, text, shape, subcanvas, media, generate, prompt, …).","maxItems":20,"type":"array","items":{"type":"string","minLength":1}},"query":{"description":"Only nodes whose text contains this (case-insensitive).","type":"string","minLength":1,"maxLength":200},"node_ids":{"description":"Only these nodes.","maxItems":200,"type":"array","items":{"type":"string","minLength":1}},"include_results":{"description":"Attach generation results (image/video URLs) to generation nodes.","type":"boolean"}},"required":["room_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.canvas_read","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_read","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.scene_builder_3d_run_python","title":"3D Jutsu: run python","description":"Commit one coherent Blender scene edit against the exact revision and scene sequence you\ninspected with `scene_builder_3d_get_project` or `scene_builder_3d_query_python`. `bpy` and\n`artifacts` are available; assign JSON-serializable findings to `result`. Keep one mutation\nactive per project, including imports. If this operation remains active, poll\n`scene_builder_3d_get_operation` before editing again. Reuse `operationId` only for the identical\ncode and preconditions. On a stale-state conflict, inspect the scene again and regenerate the\nedit with fresh guards and a new operation ID. A successful mutation advances `revisionAfter`.\n\nThis worker pins Blender 5.2: use `BLENDER_EEVEE`, `BLENDER_WORKBENCH`, or `CYCLES`, not\n`BLENDER_EEVEE_NEXT`. Code is capped at 256 KiB, and execution and checkpoint/export must fit\nthe configured worker deadline; keep renders small and split expensive work into coherent edits.\nDo not invent texture paths or fetch external files from Blender; use\n`scene_builder_3d_import_asset` for models.\n\nSuccessful execution does not establish visual correctness. Render from the delivery camera,\npublish the image through `artifacts`, retrieve it with `scene_builder_3d_get_artifact`, and\ninspect it before claiming completion. If visual inspection is unavailable, state what remains\nunverified. Use `scene_builder_3d_get_glb` or `scene_builder_3d_get_blend` when the user needs\nthe committed files.\n\nBefore building or editing a scene, load get_preset_instructions with { preset: \"/3d-jutsu\" } once for the full workflow, runtime limits and scene-building references.\n\nFinish each completed scene creation, edit, or import task by calling `scene_builder_3d_show_scene` once as the final scene inspection/edit call of that review phase, after mutations have settled and verification is complete. Pass the same `projectId` and the exact committed `revision` of the final result: `revisionAfter` from the final successful mutation, or the settled `project.revision` after an import. Do not guess the revision. Show an unchanged revision only once. Authorized generation and status calls may follow; later feedback or a verified mismatch can reopen scene editing. Verify and show the corrected revision at its next review boundary. This shows the result to the user; a text summary or download link alone does not finish scene delivery. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"code":{"type":"string","minLength":1,"description":"Use bpy and artifacts; assign JSON-serializable findings to result. Files persist only via artifacts.file(name=..., media_type=...), writing to target.path, then target.publish(). At most eight PNG/JPEG/MP4 files, 512 MiB each and 1 GiB total; images at most 16384 pixels per side and 64 MP. Invalid published files fail the operation. Set image_settings.media_type='IMAGE' before PNG/JPEG, or 'VIDEO' before FFMPEG with MPEG4/H264. No network fetches or embedded model bytes; use scene_builder_3d_import_asset."},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Exact committed revision inspected; do not guess."},"expectedSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Exact settled scene sequence inspected by your query."},"waitSeconds":{"default":8,"description":"Seconds to wait, capped at 8; poll scene_builder_3d_get_operation if still active.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["projectId","operationId","code","revision","expectedSceneSequence"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.scene_builder_3d_run_python","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_run_python","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean"},"operation":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"access":{"type":"string","enum":["query","mutation"]},"status":{"type":"string","enum":["queued","hydrating","starting","running","checkpointing","succeeded","failed","timed_out","expired"]},"baseRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"headSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"stale":{"type":"boolean"},"sceneSequenceBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"sceneSequenceAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionBefore":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"revisionAfter":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"createdAt":{"type":"string"},"startedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finishedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"result":{},"output":{"type":"object","properties":{"stdoutTail":{"type":"string"},"stderrTail":{"type":"string"},"truncated":{"type":"boolean"}},"required":["stdoutTail","stderrTail","truncated"],"additionalProperties":false},"error":{"anyOf":[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},{"type":"null"}]},"artifacts":{"anyOf":[{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"blend":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"glb":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"generated":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["projectId","revision","blend","glb","generated"],"additionalProperties":false},{"type":"null"}]},"generatedArtifacts":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["id","projectId","access","status","baseRevision","headRevision","headSceneSequence","stale","sceneSequenceBefore","sceneSequenceAfter","revisionBefore","revisionAfter","createdAt","startedAt","finishedAt","result","output","error","artifacts","generatedArtifacts"],"additionalProperties":false},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"terminal":{"type":"boolean","description":"False while the operation still needs polling; true includes success and failure."},"nextTool":{"type":"string","const":"scene_builder_3d_get_operation"},"nextArguments":{"type":"object","properties":{"projectId":{"type":"string"},"operationId":{"type":"string"}},"required":["projectId","operationId"],"additionalProperties":false}},"required":["ok","operation","projectUrl","terminal"],"additionalProperties":false}},{"name":"higgsfield.open_ads_studio","title":"Ads Studio","icons":[{"src":"https://files.openai.com/content?id=file_00000000bef48230b2e1460fa9919190&cdn=1&cp=pi&ma=30585600&ts=0&p=pi&cid=11&sig=c89c0a8996d0483156d3ef41e4d0b69aaa51a4c7c6eb668c3b9a68db511e1d39&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"light"},{"src":"https://files.openai.com/content?id=file_0000000085f881f5abddb2561787bd9a&cdn=1&cp=pi&ma=32659200&ts=0&p=pi&cid=11&sig=ea90e77f50d17f209950698f70b7c458c0f6484c7a087bb4c58b10ac2a5d22c4&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"dark"}],"description":"Open the Higgsfield Ads Studio page inside the Higgsfield app: brands and ad generations. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-app-v5.html","ui":{"visibility":["model","app"],"resourceUri":"ui://higgsfield/ads-studio-app-v5.html"},"resource_name":"higgsfield.open_ads_studio","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/open_ads_studio","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.canvas_create","title":"Create Canvas","description":"Create a new private canvas board and return its room_id and canvas_url. The board opens for the user and shows later canvas_add, canvas_update and canvas_remove changes and canvas_run results live, so open_canvas is not needed for it. Use the room_id with canvas_read, canvas_add, canvas_update, canvas_remove and canvas_run. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"name":{"description":"Board name, default Canvas.","type":"string","minLength":1,"maxLength":100},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/canvas.html","ui":{"visibility":["model","app"],"resourceUri":"ui://higgsfield/canvas.html"},"resource_name":"higgsfield.canvas_create","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_create","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.participate_in_contest","title":"Enter App Contest","description":"Enter the website in the current Higgsfield app contest, together with the social-media links promoting it. A website not yet PUBLISHED to the community feed is published automatically by the entry — no need to call publish_website first. The website DOES need a live production deploy (deploy_website), else the entry is rejected. BEFORE entering, make sure the page metadata in app/src/app-meta.json is filled with real values (og_title etc.) — the auto-publish lists the website on the feed and an empty og_title makes it INVISIBLE there. Pass one or more urls, each a social-media link (YouTube, X/Twitter, Instagram, or TikTok); any other host is rejected. There is a single active contest, so no contest id is needed. Calling again for the same website OVERWRITES its urls (use it to fix or add links), it does not create a second entry. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","description":"The website's id (returned by create_website)."},"urls":{"minItems":1,"maxItems":10,"type":"array","items":{"type":"string"},"description":"Social-media links promoting the website (YouTube / X-Twitter / Instagram / TikTok). At least one, at most ten."}},"required":["website_id","urls"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.participate_in_contest","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/participate_in_contest","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"submission_id":{"description":"The contest entry id.","type":"string"},"contest_id":{"description":"The contest the website was entered in.","type":"string"},"urls":{"description":"The submitted links.","type":"array","items":{"type":"string"}},"error":{"anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false}},{"name":"higgsfield.open_soul_feed","title":"Soul Feed","description":"Open the generation feed inside the Higgsfield app. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/soul-feed-v2.html","ui":{"visibility":["app"],"resourceUri":"ui://higgsfield/soul-feed-v2.html"},"resource_name":"higgsfield.open_soul_feed","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/open_soul_feed","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.ads_studio_generate","title":"Generate Ads Studio Creatives","description":"Generate ad creatives in Ads Studio: for a brand, for products of any brand or of none, or from a prompt and the user's pictures alone, with or without the brand kit. Ads Studio writes the concepts and renders the pictures. This spends Higgsfield credits, so quote with ads_studio_quote and get explicit approval of the exact allocation and credit cost first. An approval from the Ads Studio app allocation is NOT approval. When allocation is supplied, this tool quotes the whole allocation and requests native MCP form confirmation when supported. Otherwise it returns approval_required and credits: show the exact counts and cost, ask for explicit chat approval and stop. Only after approval, repeat the unchanged allocation with expected_credits. Never split the allocation or bypass a supported native form. Answers as soon as the runs are accepted, with a run id each - report those and stop; read ads_studio_get_run when the user asks, never in a loop. Generation takes a few minutes. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"description":"The brand whose kit (logo, palette, tone) shapes the ads, from ads_studio_list_brands. Leave it out to make ads with no brand kit at all. The kit only reaches this brand's own products: a product of another brand, or of none, is advertised without it, so never promise the user this brand's look on someone else's product.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"brand_kit":{"description":"false to make the ads without the brand kit even though brand_id is set: a plain product or prompt ad. Default true when brand_id is set; always off without one.","type":"boolean"},"product_ids":{"description":"Products to advertise, from ads_studio_list_products - of this brand, another brand or none; each gets its own run. Name at least one product, or set include_brand, or give a prompt - with none of them there is nothing to advertise.","maxItems":24,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"include_brand":{"description":"Also generate a run about the brand itself, not a single product. Needs brand_id and the kit on.","type":"boolean"},"total":{"description":"How many concepts in total across all subjects: the number the user named, or 1 for a singular request. Ads Studio splits it between the subjects, so it must be at least one per subject.","type":"integer","minimum":1,"maximum":100},"prompt":{"description":"What the user asked for in their own words: the angle, the offer, the audience. A prompt alone, with no product and no brand, is an ad about what it describes.","type":"string","maxLength":2000},"images":{"description":"Pictures the user supplied for this generation: inspiration or photos of their product.","maxItems":4,"type":"array","items":{"type":"object","properties":{"url":{"type":"string","format":"uri","description":"A public https link to the picture."},"role":{"description":"style (default): a look to follow. product: a photo of the thing being advertised.","type":"string","enum":["style","product"]}},"required":["url"]}},"objective":{"description":"What the ads are for. Set it only when the user made the goal clear (more sales -> sales; sign-ups, demos, quotes -> leads; visits, clicks -> traffic; a launch or being known -> awareness; comments, shares -> engagement). Left out, the product's own profile decides.","type":"string","enum":["sales","leads","engagement","traffic","awareness"]},"aspect_ratio":{"default":"1:1","description":"The frame for the whole batch: 1:1 square feed, 9:16 stories and reels, 16:9 landscape, 3:4 portrait feed. 4:5 is not available - offer 3:4 as the nearest portrait frame.","type":"string","enum":["1:1","9:16","16:9","3:4"]},"allocation":{"description":"Exact per-product counts from the Ads Studio app. Submit the whole allocation in one call, with brand_id, aspect_ratio and one stable idempotency_key. The first call quotes and requests approval without spending. Do not combine with product_ids, total, prompt, images, objective, include_brand or brand_kit. Chat-approved retries require expected_credits equal to the approved total cost.","minItems":1,"maxItems":24,"type":"array","items":{"type":"object","properties":{"product_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"count":{"type":"integer","minimum":1,"maximum":10},"name":{"description":"Display label only; authorization and allocation use product_id.","type":"string","maxLength":300}},"required":["product_id","count"],"additionalProperties":false}},"expected_credits":{"description":"Exact credit cost explicitly approved by the user in chat. The server requotes before spending and refuses a changed price. For an app allocation on a host without native form support, preserve the exact allocation and key. Omit for native confirmation.","type":"number","minimum":0},"idempotency_key":{"type":"string","minLength":1,"maxLength":128,"description":"A key you choose once for this generation and repeat unchanged if you have to retry. Never invent a new one for a retry: that buys the same batch a second time."}},"required":["idempotency_key"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-run.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-run.html"},"resource_name":"higgsfield.ads_studio_generate","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_generate","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"brand_id":{"description":"The brand supplied for this generation, if any.","type":"string"},"started":{"type":"boolean"},"approval_required":{"type":"boolean"},"credits":{"description":"Total quoted credits for the exact allocation.","type":"number"},"partial":{"description":"True when some runs started and others did not.","type":"boolean"},"runs":{"type":"array","items":{"type":"object","properties":{"run_id":{"type":"string"},"subject":{"type":"string"},"product_id":{"type":"string"},"concepts":{"type":"number"}},"additionalProperties":false}},"run_ids":{"type":"array","items":{"type":"string"}},"selected_products":{"description":"The products this batch advertises.","type":"array","items":{"type":"object","properties":{"product_id":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false}},"not_started":{"description":"On a partial start: the products whose runs did not start. Nothing was charged for them.","type":"array","items":{"type":"object","properties":{"product_id":{"type":"string"},"name":{"type":"string"}},"additionalProperties":false}},"not_started_reason":{"description":"On a partial start: why the rest did not start, when Ads Studio said.","type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"],"additionalProperties":{}},"note":{"type":"string"},"next_step":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_import_asset","title":"3D Jutsu: import asset","description":"Import a confirmed catalog GLB from `scene_builder_3d_search_assets` into the selected project\nas a collaborative scene entity. Supply the catalog's asset ID, not a URL. The tool runtime\nresolves and uploads the bytes, reads the project guards, submits the import, and waits for\nit to appear in the settled scene. Do not import while another mutation is active. After\nimport, inspect dimensions, placement, orientation, contact, and materials with\n`scene_builder_3d_query_python` before further edits. Do not repeat the whole import to poll:\nit can create a duplicate. If an import fails, report the error; never fall back to Python\nnetwork calls or base64-encoded model bytes. Copy catalogSearch from the search result's importArguments. If settled is false, poll scene_builder_3d_get_project until appliedSceneSequence reaches targetSceneSequence. If submissionUnknown is true, inspect the returned entityId before deciding to retry. This version accepts catalog assets only.\n\nFinish each completed scene creation, edit, or import task by calling `scene_builder_3d_show_scene` once as the final scene inspection/edit call of that review phase, after mutations have settled and verification is complete. Pass the same `projectId` and the exact committed `revision` of the final result: `revisionAfter` from the final successful mutation, or the settled `project.revision` after an import. Do not guess the revision. Show an unchanged revision only once. Authorized generation and status calls may follow; later feedback or a verified mismatch can reopen scene editing. Verify and show the corrected revision at its next review boundary. This shows the result to the user; a text summary or download link alone does not finish scene delivery. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"catalogSearch":{"default":"","description":"Copy catalogSearch from the search result's importArguments so the catalog ID can be resolved in the same result set.","type":"string","maxLength":128},"assetId":{"type":"string","minLength":1,"maxLength":128,"description":"Confirmed catalog ID from scene_builder_3d_search_assets. Attachment IDs are not supported by this tool."},"name":{"type":"string","minLength":1,"maxLength":128},"transform":{"type":"object","properties":{"position":{"default":[0,0,0],"type":"array","prefixItems":[{"type":"number","minimum":-1000000,"maximum":1000000},{"type":"number","minimum":-1000000,"maximum":1000000},{"type":"number","minimum":-1000000,"maximum":1000000}],"minItems":3,"maxItems":3},"rotation":{"default":[0,0,0,1],"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],"minItems":4,"maxItems":4},"scale":{"default":[1,1,1],"type":"array","prefixItems":[{"type":"number","minimum":0.000001,"maximum":1000000},{"type":"number","minimum":0.000001,"maximum":1000000},{"type":"number","minimum":0.000001,"maximum":1000000}],"minItems":3,"maxItems":3}},"additionalProperties":false,"description":"Editor/glTF coordinates: metres, Y up, XYZW quaternion. Blender bpy coordinates are Z up; account for that when comparing transforms."},"waitSeconds":{"default":8,"description":"Seconds to wait, capped at 8; poll scene_builder_3d_get_operation if still active.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["projectId","operationId","assetId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.scene_builder_3d_import_asset","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_import_asset","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean"},"projectId":{"type":"string"},"operationId":{"type":"string"},"entityId":{"type":"string"},"name":{"type":"string"},"source":{"type":"string","const":"catalog"},"assetId":{"type":"string"},"settled":{"description":"Whether the accepted import has reached the committed scene.","type":"boolean"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"appliedSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"targetSceneSequence":{"description":"Poll until appliedSceneSequence reaches this value.","type":"integer","minimum":0,"maximum":9007199254740991},"submissionUnknown":{"description":"Inspect entityId before retrying: the import may already have been accepted.","type":"boolean"},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"retryAdvice":{"type":"string"}},"required":["code","message","retryable"],"additionalProperties":false},"nextTool":{"type":"string","const":"scene_builder_3d_get_project"},"nextAction":{"type":"string"},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","projectId","operationId","entityId","name","source","assetId","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.canvas_remove","title":"Remove from Canvas","description":"Delete items and connections from a Higgsfield canvas board in the authenticated user's workspace. Use it only when the user asks to delete something: pass node ids and edge ids from canvas_read or canvas_add. Deletions are saved to the board and appear live for everyone viewing it, including an open_canvas view already shown. Some deletions can be rejected while others apply: inspect applied and rejected. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Canvas room_id (UUID) or the canvas URL containing it.","type":"string"},"workspace_id":{"description":"Workspace UUID of the canvas. Omit to use the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"node_ids":{"description":"Items to delete.","minItems":1,"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"description":"A node id from canvas_read or canvas_add."}},"edge_ids":{"description":"Connections to delete: edge ids from canvas_read or canvas_add.","minItems":1,"maxItems":100,"type":"array","items":{"type":"string","minLength":1}},"final":{"description":"true on your last call that changes this board before you reply to the user (a canvas_run may still follow), so people viewing it see you finish right away. Leave it out while more changes follow.","type":"boolean"}},"required":["room_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.canvas_remove","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/canvas_remove","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.ad_multiplier_submit","title":"Generate Ad Multiplier video","description":"Submit one paid Ad Multiplier v2 video from the app's Generate action. Images are optional; all creative instructions belong in the prompt. Free and unlimited generations are unavailable. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"resolution":{"default":"720p","type":"string","enum":["480p","720p","1080p"]},"mode":{"default":"recreate","type":"string","enum":["recreate","sections"]},"section":{"anyOf":[{"type":"string","enum":["hook","cta","both"]},{"type":"null"}]},"prompt":{"type":"string","minLength":1,"maxLeng