alProperties":false}},"next_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"models":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"},"type":{"type":"string","enum":["image","video","audio","3d"]}},"required":["id","label","type"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.balance","title":"Check Balance","description":"Read-only balance: credits, workspace plan, free generations (free_gens — Genjutsu on generate_video, Viral on execute_preset, and AI Influencer Builder via its Use free gens toggle), and free-trial state (free_trial.unlim_available says whether unlimited generations can be spent). Call it for credits / plan / trial questions or after an out-of-credits error. Report the current balance and entitlement state, and explain any insufficient-credit limitation. Do not provide pricing links, purchase or upgrade directions, or trial-start instructions. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.balance","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/balance","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"credits":{"description":"Available credits in the selected workspace","type":"number"},"subscription_plan_type":{"description":"Current subscription plan for the selected workspace","type":"string"},"free_trial":{"description":"Free-trial and unlimited-generation state. Omitted when it could not be determined.","type":"object","properties":{"status":{"description":"Trial lifecycle state, e.g. 'active'. Null when the account never interacted with the trial.","anyOf":[{"type":"string"},{"type":"null"}]},"eligible":{"description":"True when the caller can still start the free trial.","type":"boolean"},"offered_kind":{"description":"Trial the caller would get by starting now: 'mcp_all_unlim' = unlimited generations for the trial period; any other value (e.g. 'mcp') = a credits trial. Null when not eligible or unknown.","anyOf":[{"type":"string"},{"type":"null"}]},"kind":{"description":"Kind of the trial the caller already has (same values as offered_kind). Null without a trial.","anyOf":[{"type":"string"},{"type":"null"}]},"trial_credits":{"description":"Remaining trial credits for a credits-kind trial. Null when no trial was started; 0 is normal for unlimited kinds.","anyOf":[{"type":"number"},{"type":"null"}]},"ends_at":{"description":"ISO timestamp when the trial ends / auto-charges.","anyOf":[{"type":"string"},{"type":"null"}]},"unlim_available":{"description":"True when free-trial unlimited generations can be spent right now. Only pass use_unlim:true to generate_image / generate_video / generate_audio when this is true.","type":"boolean"},"unlim_remaining":{"description":"Remaining unlimited generations; null means unmetered.","anyOf":[{"type":"number"},{"type":"null"}]},"unlim_expires_at":{"description":"ISO timestamp when the unlimited-generation allowance lapses.","anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false},"free_gens":{"description":"Free generations the caller can spend right now (one entry per counter, with the model ids sharing it). Empty when there are none; omitted when it could not be determined. Spent with use_free_gens:true on generate_video for Genjutsu or execute_preset for Viral; ai_influencer_sheet uses the AI Influencer Builder’s Use free gens toggle.","type":"array","items":{"type":"object","properties":{"job_set_types":{"type":"array","items":{"type":"string"},"description":"Job-set types sharing this counter. viral_hub_video covers all Viral chain presets; one preset execution spends one attempt. ai_influencer_sheet is spent through ai_influencer_generate with use_free_gens:true or the AI Influencer Builder’s Use free gens toggle."},"remaining":{"type":"number","description":"Free generations left on the counter. 0 = granted and spent."},"parameters":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"description":"Allowed values per request parameter for a free run; an absent parameter is uncapped."},"max_duration":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Upper bound in seconds for a free run, or null."}},"required":["job_set_types","remaining","parameters","max_duration"],"additionalProperties":false}},"error":{"description":"Error message if billing status could not be fetched","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.marketing_update_brand_kit","title":"Overwrite Brand Kit","description":"Overwrite an existing brand kit's data with the supplied complete brand kit payload. This replaces the previous brand-kit data wholesale. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_kit_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Brand kit ID to overwrite."},"brand_kit":{"type":"object","properties":{"brand_name":{"anyOf":[{"type":"string"},{"type":