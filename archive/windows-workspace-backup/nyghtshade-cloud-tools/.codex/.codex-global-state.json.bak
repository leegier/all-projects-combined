download","artifact","projectUrl","kind","projectId","revision"],"additionalProperties":false}},{"name":"higgsfield.ai_influencer_builder","title":"AI Influencer Builder","description":"Quote or generate a batch of one to four character sheets from the builder, or check a job. Free generations always submit one sheet. Returns job_id for the first accepted job and job_ids for a batch; track every returned job. Submit only after the user clicks Generate with a displayed price. Free generations require the builder’s explicit Use free gens toggle; never retry a rejected free request on credits automatically. The Motion tab quotes and submits influencer Genjutsu jobs using motion_quote/motion_submit, with the dedicated ai_influencer job types. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"action":{"type":"string","const":"quote"},"params":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]},"selection":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"maxItems":4,"type":"array","items":{"type":"string"}}},"brief":{"type":"string","maxLength":4000},"medias":{"maxItems":1,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}},"item_medias":{"maxItems":3,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":