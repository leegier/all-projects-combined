okens never authorize generation. This tool does not start jobs or spend credits; submit through the widget only after the user clicks Generate with a displayed price. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"workflow_run_ids":{"default":[],"maxItems":32,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"instance_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"origin":{"type":"string","format":"uri"},"resources":{"default":[],"maxItems":50,"type":"array","items":{"type":"string","maxLength":200,"pattern":"^ui:\\/\\/.*"}}},"required":["instance_id","origin"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield._create_ui_stream_token","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/_create_ui_stream_token","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"stream_url":{"type":"string","format":"uri"},"stream_id":{"type":"string"},"expires_at":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"cursor":{"type":"string","pattern":"^\\d{1,20}-\\d{1,20}$"}},"required":["stream_url","stream_id","expires_at","cursor"],"additionalProperties":false}},{"name":"higgsfield.create_or_update_canvas_token","title":"Create or Update Canvas Token","description":"App-only canvas access. Without room_id, create a private FNF project and its canvas using workspace_id and idempotency_key; retain the same workspace, key and name on uncertain retries within 15 minutes. With room_id, check access and issue a fresh token for the same canvas. Tokens last at most 5 minutes and are returned only in _meta.token. Refresh before expires_at (Unix seconds). The token authorizes this room's graph, generation, version and WebSocket-ticket endpoints; it is not a user-wide FNF token. Existing WebSockets stay open; reconnect requires a new single-use ticket. No generation is started by this tool. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"room_id":{"description":"Existing canvas room (FNF folder UUID). Omit only for a new canvas; retain the returned room_id for refresh and reconnect.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"description":"Workspace UUID. Required for creation; keep the same workspace on retries. For refresh, omit to resolve the selected workspace.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"description":"New canvas project name; defaults to Canvas. Creation only.","type":"string","minLength":1,"maxLength":100},"idempotency_key":{"description":"Required for creation: a fresh UUID chosen once by the app and retained with workspace_id and name on retries. Backend creation replay lasts 15 minutes.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.create_or_update_canvas_token","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/create_or_update_canvas_token","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"room_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"canvas_url":{"type":"string","format":"uri"},"websocket_url":{"type":"string","format":"uri","description":"WebSocket endpoint without credentials. Get a one-use ticket from GET /api/flow/{room_id}/auth with the canvas Bearer token, then append ?ticket=... ."},"expires_at":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991,"description":"Canvas token expiration as Unix seconds. Refresh shortly before this time; token is in result _meta.token."}},"required":["room_id","workspace_id","canvas_url","websocket_url","expires_at"],"additionalProperties":false}},{"name":"higgsfield.marketing_create_brand_kit","title":"Create Brand Kit","description":"Create a brand kit from user-provided brand data only. This does not scrape websites, fetch third-party URLs, or create checkout/purchase flows. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_kit":{"type":"object","properties":{"brand_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"website_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"logo":{"anyOf":[{"type":"string"},{"type":"null"}]},"business_overview":{"anyOf":[{"type":"string"},{"type":"null"}]},"short_description":{"anyOf":[{"type":"string"},{"type":"null"}]},"tagline":{"anyOf":[{"type":"string"},{"type":"null"}]},"fonts":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string"},"usage":{"type":"string"}},"additionalProperties":{}}},"colors":{"type":"array","items":{"type":"object","properties":{"hex":{"type":"string"},"rgb":{"type":"string"},"usage":{"type":"string"}},"additionalProperties":{}}},"brand_values":{"type":"array","items":{"type":"string"}},"brand_aesthetics":{"type":"array","items":{"type":"string"}},"tone_of_voice":{"type":"array","items":{"type":"string"}},"products_or_services":{"type":"array","items":{"type":"string"}},"images":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string"},"type":{"type":"string"},"alt":{"type":"string"}},"required":["url"],"additionalProperties":{}}},"social_links":{"type":"object","properties":{"instagram":{"anyOf":[{"type":"string"},{"type":"null"}]},"tiktok":{"anyOf":[{"type":"string"},{"type":"null"}]},"youtube":{"anyOf":[{"type":"string"},{"type":"null"}]},"twitter":{"anyOf":[{"type":"string"},{"type":"null"}]},"linkedin":{"anyOf":[{"type":"string"},{"type":"null"}]},"facebook":{"anyOf":[{"type":"string"},{"type":"null"}]},"pinterest":{"anyOf":[{"type":"string"},{"type":"null"}]}}},"keywords":{"type":"array","items":{"type":"string"}},"industry":{"anyOf":[{"type":"string"},{"type":"null"}]},"company_type":{"anyOf":[{"type":"string"},{"type":"null"}]},"detected_language":{"anyOf":[{"type":"string"},{"type":"null"}]}},"description":"Brand kit data supplied by the user. CDN URLs may be included only when the user provided or uploaded them."}},"required":["brand_kit"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_create_brand_kit","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_create_brand_kit","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"item":{},"success":{"type":"boolean"},"note":{"type":"string"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_result","title":"Show video result","description":"Display a final completed video in its result widget with preview and download. Call after verifying the final export. Include a nonempty action string, optionally include meta as any JSON object, and pass exactly one of media_id (a confirmed owned video UUID) or url (a public HTTPS video URL, up to 50 MB). URL input imports and confirms the video in your media library before displaying it. Prefer media_id for an already uploaded video to avoid duplicate uploads. Never pass a job ID, local path or unfinished render. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"media_id":{"description":"Confirmed owned video UUID; omit when using url.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"url":{"description":"Public HTTPS video URL, up to 50 MB; omit when using media_id.","type":"string","format":"uri"},"action":{"type":"string","minLength":1,"description":"Required action label, such as katana_video, some_gen, or others; other labels are allowed."},"meta":{"description":"Optional arbitrary nested JSON data passed to the widget unchanged.","type":"object","additionalProperties":{}}},"required":["action"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/result.html","ui":{"resourceUri":"ui://higgsfield/result.html"},"resource_name":"higgsfield.show_result","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_result","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"mode":{"type":"string","const":"result"},"media_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"video_url":{"type":"string","format":"uri"},"thumbnail_url":{"type":"string","format":"uri"},"action":{"type":"string","minLength":1},"meta":{"type":"object","additionalProperties":{}}},"required":["mode","media_id","video_url","action"],"additionalProperties":false}},{"name":"higgsfield.reveal_generation","title":"Reveal IP-Detected Generation","description":"Confirm the user has rights to the content of an `ip_detected` generation and flip its status to `completed`. Backend accepts only seedance-family jobs (cs_3_0, seedance_2_0, ms_video, etc) and only while the job is still in `ip_detected` state. Returns the updated generation. Used by the job-list widget's Reveal button after the user accepts the rights confirmation modal. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"jobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Job ID of the `ip_detected` generation to reveal."}},"required":["jobId"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/job-list.html","ui":{"visibility":["app"],"resourceUri":"ui://higgsfield/job-list.html"},"resource_name":"higgsfield.reveal_generation","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/reveal_generation","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"generation":{"description":"Updated generation (status flipped to completed).","type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false},"success":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.get_faceless_channel_presets","title":"Faceless Channel Presets","description":"Show the faceless channel presets (CMS-managed catalog). Returns preset ids, names, and preview media. When the user picks one, resolve it with resolve_faceless_channel_preset to get the style reference media_id for generations. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/explainer-presets.html","ui":{"resourceUri":"ui://higgsfield/explainer-presets.html"},"resource_name":"higgsfield.get_faceless_channel_presets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_faceless_channel_presets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"aspect":{"type":"string","enum":["16:9","9:16"],"description":"Target video orientation: 16:9 landscape or 9:16 vertical (Shorts)."},"image":{"type":"string","description":"Preview image URL for the preset card."},"video_url":{"type":"string","format":"uri","description":"Muted looping preview video URL for the preset card."},"prompt":{"type":"string","description":"Ready-to-use prompt the user drops into their prompt box when the card is picked."}},"required":["id","title","aspect","image","video_url","prompt"],"additionalProperties":false}},"error":{"description":"Set when the preset catalog could not be loaded.","type":"string"}},"required":["items"],"additionalProperties":false}},{"name":"higgsfield.jobs_wait","title":"Wait For Generation Jobs","description":"Long-poll 1-8 generation jobs together without opening a widget. Waits up to timeout_seconds (default 15, max 15) for every job to reach a terminal state, then returns compact indexed statuses and result URLs. Use job IDs returned by generate_image_batch, generate_video_batch, or generate_audio_batch. For larger sets, choose groups of at most 8 and wait for each group. Permanent lookup failures are returned once without blocking the other jobs; transient lookup failures are retried within the timeout. When all_terminal is false, wait poll_after_seconds before calling again. After every wait group in the user's generation set is terminal, collect their indexed jobs and display them with one show_generation_by_ids call when within that tool's limit. Never use show_generations or call job_display once per batch job. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"jobs":{"minItems":1,"maxItems":8,"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Stable index returned by the batch generation tool."},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["index","job_id"],"additionalProperties":false},"description":"OpenAI-profile generation jobs to wait for together."},"timeout_seconds":{"default":15,"description":"Long-poll budget. Use 0 for an immediate snapshot.","type":"integer","minimum":0,"maximum":15}},"required":["jobs"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.jobs_wait","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/jobs_wait","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"jobs":{"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"anyOf":[{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},{"type":"string","const":"lookup_failed"}]},"type":{"type":"string","enum":["image","video","audio","3d"]},"model":{"type":"string"},"result_url":{"type":"string"},"exr_url":{"description":"Original EXR ZIP; result_url is the unchanged input video, not processed HDR.","type":"string"},"thumbnail_url":{"type":"string"},"error":{"type":"string"},"retryable":{"description":"Present for lookup_failed. True means a later jobs_wait call may succeed; false means the lookup failure is permanent.","type":"boolean"}},"required":["index","job_id","status"],"additionalProperties":false}},"summary":{"type":"object","properties":{"total":{"type":"integer","minimum":0,"maximum":9007199254740991},"completed":{"type":"integer","minimum":0,"maximum":9007199254740991},"failed":{"type":"integer","minimum":0,"maximum":9007199254740991},"active":{"type":"integer","minimum":0,"maximum":9007199254740991},"errors":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["total","completed","failed","active","errors"],"additionalProperties":false},"all_terminal":{"type":"boolean","description":"True when every job is terminal or permanently unresolvable, so no further polling is needed."},"timed_out":{"type":"boolean"},"aborted":{"type":"boolean"},"poll_after_seconds":{"type":"number"}},"required":["jobs","summary","all_terminal"],"additionalProperties":false}},{"name":"higgsfield.rename_website","title":"Rename Website Subdomain","description":"Rename the website's SUBDOMAIN (the slug in its public URL). The site is re-deployed under the new subdomain and the OLD subdomain STOPS WORKING — anyone holding the old URL must be given the new one. Storage (database, files, config) and the code repo are KEPT; only the public address changes. Runs a full re-deploy and can take a couple of minutes; returns once the site is live at the new URL. Fails if the new subdomain is already taken or reserved, or if a deploy is already in flight — pick another subdomain and retry. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","description":"The website's id (returned by create_website)."},"new_slug":{"type":"string","minLength":1,"maxLength":64,"description":"The new subdomain (the slug in the public URL). Lowercase letters, digits and hyphens; must be globally unique and not a reserved name."}},"required":["website_id","new_slug"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.rename_website","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/rename_website","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"slug":{"description":"The website's subdomain after the rename.","type":"string"},"old_slug":{"description":"The subdomain it had before (that URL no longer works).","anyOf":[{"type":"string"},{"type":"null"}]},"url":{"description":"Live URL under the new subdomain.","anyOf":[{"type":"string"},{"type":"null"}]}},"additionalProperties":false}},{"name":"higgsfield.update_home_workflow","title":"Update Home Workflow Progress","description":"Report actual activity for a Home workflow using its supplied run_id and an increasing sequence integer starting at 1; reuse sequence only when retrying the same report. Set waiting_for_user immediately before a question or Continue, preparing while planning, generating during media generation, and assembling during editing/export. Report after job submission, a backend check confirming active work, or assembly log progress; keep tracked job waits at most 60 seconds. Never heartbeat while waiting for the user or invent activity. After 2 minutes of silence the UI hides its loader without cancelling work; a new report restores it. Without a supplied run_id do not call this tool. Does not generate or cancel media. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"run_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"phase":{"type":"string","enum":["preparing","waiting_for_user","generating","assembling"]},"sequence":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["run_id","phase","sequence"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.update_home_workflow","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/update_home_workflow","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"run_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"usecase_id":{"type":"string","minLength":1,"maxLength":200},"status":{"type":"string","enum":["running","completed","failed","cancelled"]},"phase":{"type":"string","enum":["preparing","waiting_for_user","generating","assembling"]},"activity_sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"updated_at":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"result_url":{"type":"string","format":"uri"}},"required":["run_id","usecase_id","status","updated_at"],"additionalProperties":false}},{"name":"higgsfield.prepare_generation","title":"Prepare Generation Settings","description":"Read a source generation's original model and complete parameters for the app's Recreate context. Prepares settings for the next user request; does not submit or generate anything. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"type":"object","properties":{"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["job_id"],"additionalProperties":false},{"type":"object","properties":{"job_set_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["job_set_id"],"additionalProperties":false}]},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.prepare_generation","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/prepare_generation","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.get_profile","title":"Get Account Profile","description":"Return the Higgsfield account represented by this connection's authenticated credentials. Reads optional display labels from the configured Clerk OAuth UserInfo service using the caller's token. The opaque id stays the same across token refresh, reconnection, scope upgrades, and changes to email or selected workspace. Does not select or switch accounts. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.get_profile","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_profile","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"id":{"type":"string","minLength":1,"pattern":"\\S","description":"Opaque, immutable account identifier, unique within Higgsfield and never reassigned to another account."},"name":{"description":"Display name for the authenticated profile.","type":"string"},"email":{"description":"Email address for display; not the profile identity.","type":"string"},"nickname":{"description":"Display label distinguishing connected profiles.","type":"string"}},"required":["id"],"additionalProperties":false}},{"name":"runway.list_recent","title":"Runway Assets","icons":[{"src":"https://files.openai.com/content?id=file_00000000abe481f79a9d2116a8f31246&cdn=1&cp=pi&ma=31968000&ts=0&p=pi&cid=11&sig=ccd035275a064d2d24b1af0e55fb71b0007e1cf279db3b249cf887b38a8478ce&v=0","mimeType":"image/svg+xml","sizes":["any"]}],"description":"Lists recent uploaded and generated assets for the authenticated workspace. Returns asset IDs, media types, task IDs when available, and reusable asset URLs. Use this to help the user pick recent images or videos as references. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"limit":{"type":"number","minimum":10,"maximum":50,"description":"Max results (10-50, default 12)."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"openai/ui":{"entrypoints":[{"type":"global"},{"type":"thread"}]},"resource_name":"runway.list_recent","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/list_recent","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Gallery of recent uploaded and generated assets in the connected workspace.","properties":{"kind":{"type":"string","enum":["asset_gallery"]},"title":{"type":"string"},"assets":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["image","video"]},"source":{"type":"string","enum":["upload","generation"]},"name":{"type":"string"},"url":{"type":"string","description":"Reusable Runway-hosted asset URL."},"previewUrl":{"type":"string"},"taskId":{"type":"string","description":"Originating task id, or empty for uploads."},"createdAt":{"type":"string"}},"required":["id","kind","source","url"],"additionalProperties":true}}},"required":["kind","assets"],"additionalProperties":true}},{"name":"runway.get_brand_kit","title":"Get Brand Kit","description":"Gets one visible Brand Kit from the connected workspace, including its curated image, video, and audio assets grouped by category. Call this when a kit has been selected, when there is one clearly applicable kit, or when the user asks what is inside a kit. Image and video asset URLs can be passed unchanged into the existing generation tools as references. Reading Brand Kits is free and non-destructive. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"brand_kit_id":{"type":"string","description":"Brand Kit UUID from list_brand_kits."}},"required":["brand_kit_id"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.get_brand_kit","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/get_brand_kit","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"One Brand Kit with categorized reusable assets.","properties":{"kind":{"type":"string","enum":["brand_kit"]},"id":{"type":"string"},"name":{"type":"string"},"categories":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"description":{"description":"Category description, or null."},"hasMoreAssets":{"type":"boolean","description":"True when the category contains more than the returned 100 assets."},"assets":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image","video","audio"]},"url":{"type":"string","description":"Reusable Runway-hosted asset URL."},"previewUrl":{"type":"string"}},"required":["id","name","mediaType","url","previewUrl"],"additionalProperties":true}}},"required":["id","name","assets","hasMoreAssets"],"additionalProperties":true}}},"required":["kind","id","name","categories"],"additionalProperties":true}},{"name":"runway.generate_music","title":"Generate Music","description":"Generate music from a text description — songs, instrumentals, scores, loops, stings — and return an MP3. Describe genre, mood, instrumentation, tempo, structure, and (for songs) lyrics or vocal style in `promptText`.\n\nCREDIT MODE: Runway account availability is checked against the currently connected workspace.\n\nMODELS (pick with `model`; default `lyria-3-pro`):\n- `lyria-3-pro` (8 credits): Full-length music — songs, scores, instrumentals. Use for a complete track or soundtrack.\n- `lyria-3-clip` (4 credits): Short music clips — stings, loops, background beds, jingles. Use for intros, transitions, or a bed under a short video.\nOutput length is fixed per model — there is no duration parameter. Use `lyria-3-clip` for short beds/stings and `lyria-3-pro` for a full track.\n\nWHEN TO USE:\n- \"make me a song about…\", \"write a lo-fi beat\", \"background music for my video\", \"an orchestral score that builds\", \"a 10-second jingle\".\n- NOT for speech/voiceover, NOT for sound effects, NOT for adding a soundtrack to an existing video (generate the music here, then combine externally).\n\nPAID PLAN REQUIRED: music generation is not available on free Runway workspaces. On a free workspace this tool returns paid_plan_required without creating a task — follow the NEXT line in that result (`show_plans_and_credits` with `gatedCapability`) and do not retry. Tell the user that generating music needs a paid plan rather than naming the model. `whoami` does not list music models; do not treat an empty `availableVideoModels` as a music signal.\n\nAVAILABILITY: some workspaces have this model disabled by an admin. If the result is an account_limitation with reason admin_disabled_model, tell the user and stop — do not retry with the other model.\n\nPROMPTING TIPS: lead with genre and mood, then instrumentation and tempo, then structure (\"intro, verse, chorus, outro\"). For songs with vocals, include the lyrics or the theme and vocal style. For instrumental beds say \"instrumental, no vocals\". Max 5000 characters.\n\nUSER-FACING REPLIES: Talk about the music (genre, mood, what it's for), not the model or task machinery. Do not mention Lyria or Google unless the user asks. The output is an MP3 the viewer plays inline; headless agents get the URL from `get_task`.\n\nParameters:\n- promptText: Required. What the music should sound like. Max 5000 characters.\n- model: Optional. `lyria-3-pro` (default, full track) or `lyria-3-clip` (short clip).\n- name: Optional. Display name for the track in the user's Runway library. Defaults to the prompt. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"promptText":{"type":"string","description":"Description of the music: genre, mood, instrumentation, tempo, structure, lyrics/vocal style. Max 5000 characters.","maxLength":5000},"model":{"type":"string","enum":["lyria-3-pro","lyria-3-clip"],"description":"Music model. 'lyria-3-pro' (default) for a full-length track; 'lyria-3-clip' for a short sting/loop/bed."},"name":{"type":"string","description":"Optional display name for the track in the user's Runway library. Defaults to the prompt.","maxLength":500}},"required":["promptText"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"resource_name":"runway.generate_music","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/generate_music","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Result envelope discriminated by `kind`. `task_pending` / `task_batch_pending` mean the generation task was accepted by Runway and is running in the background (poll get_task or let the inline viewer update); `account_limitation` means the connected workspace cannot run the request; other kinds carry staged results or corrective guidance.","properties":{"kind":{"type":"string","description":"Result discriminator, e.g. 'task_pending', 'task_batch_pending', 'account_limitation'."},"taskId":{"type":"string","description":"Runway task ID for single-task results. Use with get_task."},"taskIds":{"type":"array","items":{"type":"string"},"description":"Runway task IDs for batch results (count > 1)."},"taskType":{"type":"string","description":"Internal Runway task type."},"outputKind":{"type":"string","enum":["image","video","audio"],"description":"Whether the finished asset will be an image, a video, or audio."},"prompt":{"type":"string","description":"Prompt the task was created with."},"status":{"type":"string","description":"Last observed task status for still-running tasks."},"meta":{"type":"object","description":"Viewer metadata: aspect ratio, resolution, duration, audio flags."},"reason":{"type":"string","description":"Limitation reason when kind is 'account_limitation'."},"modelLabel":{"type":"string","description":"Human-readable model label for account-limitation results."},"capability":{"type":"string","description":"What the plan blocked, phrased as the user's own action (e.g. 'Generating video'). Pass it to `show_plans_and_credits` as `gatedCapability` and use it when telling the user what happened."},"upgradeUrl":{"type":"string","description":"Runway pricing/billing page. Present when kind is account_limitation, and on every accepted result from a free-plan workspace (see isFreePlan). The inline viewer renders it; do not repeat it unless lowCredits is true or the user asks about plans."},"isFreePlan":{"type":"boolean","description":"True when the connected workspace is on the Free plan. The inline viewer shows a one-line upgrade nudge under the finished media; you do not need to add anything."},"nextTool":{"type":"string","description":"Tool to call next when kind is account_limitation."},"creditsRemaining":{"type":"number","description":"Approximate workspace credit balance after this submission, when it could be resolved."},"lowCredits":{"type":"boolean","description":"True when the remaining balance may not cover another generation — mention it to the user in one short sentence with topUpUrl."},"topUpUrl":{"type":"string","description":"Runway billing page to buy more credits when lowCredits is true on a paid plan. Free plans cannot top up; they get upgradeUrl instead."}},"required":["kind"],"additionalProperties":true}},{"name":"runway.list_workspaces","title":"List Workspaces","description":"Lists every Runway workspace the authenticated user belongs to, with role and a compact disabled-model summary per workspace. The MCP connection is pinned to ONE workspace (chosen at sign-in); use this tool to confirm which workspace you are currently posting to and to compare options before suggesting a switch. By default this omits full disabled-model arrays to keep the response compact; pass includeDisabledModels=true only when you need the exact policy list. To switch workspaces, the user must disconnect and reconnect the Runway MCP from their client (this is intentional — it keeps account context and audit logs aligned to a single workspace per session). This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"includeDisabledModels":{"type":"boolean","description":"Include full disabledModels arrays for each workspace. Default false to avoid large responses."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.list_workspaces","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/list_workspaces","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"All Runway workspaces the user belongs to, with role and disabled-model summaries.","properties":{"currentTeamId":{"description":"Workspace id this MCP connection is pinned to, or null."},"includeDisabledModels":{"type":"boolean","description":"Whether full disabledModels arrays were included."},"workspaces":{"type":"array","description":"Workspace summaries: {id, name, organization, isPersonal, role, disabledModelCount, disabledModels?, isCurrentlySelected}.","items":{"type":"object","properties":{"id":{"type":"number"},"name":{"type":"string"},"organization":{"description":"{id, name} of the owning organization, or null."},"isPersonal":{"type":"boolean"},"role":{"description":"User's role in this workspace, or null."},"disabledModelCount":{"description":"Number of admin-disabled models, or null if unknown."},"isCurrentlySelected":{"type":"boolean"}},"required":["id","name","isCurrentlySelected"],"additionalProperties":true}},"switchInstructions":{"type":"string","description":"How the user switches the pinned workspace."}},"required":["workspaces"],"additionalProperties":true}},{"name":"runway.run_workflow","title":"Run Workflow","description":"Runs a saved Runway workflow (latest version) in the authenticated workspace. Consumes credits. Returns immediately with a task id — the inline MCP App viewer polls progress when available. Only call `get_task` to poll when no inline viewer is present or the user asks for status. Optional `node_ids` runs only those workflow nodes (upstream must already have succeeded). Optional `node_outputs` overrides constant/asset values for this run without saving a new version. Use `get_workflow` with `include_graph: true` first if you need node ids. Runway account availability is checked against the currently connected workspace. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/examples` for the API shape; `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"workflow_id":{"type":"string","description":"Workflow UUID to run."},"node_ids":{"type":"array","items":{"type":"string"},"description":"Optional workflow-node UUIDs for a partial run. Omit to run all configured nodes."},"node_outputs":{"type":"object","description":"Optional per-node overrides (nodeId → port → value) for this run only. Asset nodes accept a dataset asset id or a hosted media URL."}},"required":["workflow_id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"resource_name":"runway.run_workflow","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/run_workflow","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Result envelope discriminated by `kind`. `task_pending` / `task_batch_pending` mean the generation task was accepted by Runway and is running in the background (poll get_task or let the inline viewer update); `account_limitation` means the connected workspace cannot run the request; other kinds carry staged results or corrective guidance.","properties":{"kind":{"type":"string","description":"Result discriminator, e.g. 'task_pending', 'task_batch_pending', 'account_limitation'."},"taskId":{"type":"string","description":"Runway task ID for single-task results. Use with get_task."},"taskIds":{"type":"array","items":{"type":"string"},"description":"Runway task IDs for batch results (count > 1)."},"taskType":{"type":"string","description":"Internal Runway task type."},"outputKind":{"type":"string","enum":["image","video","audio"],"description":"Whether the finished asset will be an image, a video, or audio."},"prompt":{"type":"string","description":"Prompt the task was created with."},"status":{"type":"string","description":"Last observed task status for still-running tasks."},"meta":{"type":"object","description":"Viewer metadata: aspect ratio, resolution, duration, audio flags."},"reason":{"type":"string","description":"Limitation reason when kind is 'account_limitation'."},"modelLabel":{"type":"string","description":"Human-readable model label for account-limitation results."},"capability":{"type":"string","description":"What the plan blocked, phrased as the user's own action (e.g. 'Generating video'). Pass it to `show_plans_and_credits` as `gatedCapability` and use it when telling the user what happened."},"upgradeUrl":{"type":"string","description":"Runway pricing/billing page. Present when kind is account_limitation, and on every accepted result from a free-plan workspace (see isFreePlan). The inline viewer renders it; do not repeat it unless lowCredits is true or the user asks about plans."},"isFreePlan":{"type":"boolean","description":"True when the connected workspace is on the Free plan. The inline viewer shows a one-line upgrade nudge under the finished media; you do not need to add anything."},"nextTool":{"type":"string","description":"Tool to call next when kind is account_limitation."},"creditsRemaining":{"type":"number","description":"Approximate workspace credit balance after this submission, when it could be resolved."},"lowCredits":{"type":"boolean","description":"True when the remaining balance may not cover another generation — mention it to the user in one short sentence with topUpUrl."},"topUpUrl":{"type":"string","description":"Runway billing page to buy more credits when lowCredits is true on a paid plan. Free plans cannot top up; they get upgradeUrl instead."}},"required":["kind"],"additionalProperties":true}},{"name":"runway.save_workflow_version","title":"Save Workflow Version","description":"Saves a new version of an existing workflow graph. Graph must be API JSON copied from `get_workflow` — not `{ type, config }`. Keep the graph minimal and its `nodeProps.position` layout readable: inputs left, processing center, outputs right, with no overlaps. Optional `expected_version` guards against stale edits (must be within 1 of latest). Response includes an editor URL. Validate first with `validate_workflow_graph`. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/authoring` before composing or changing a graph, `runway://docs/workflows/examples` for the API shape, and `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"workflow_id":{"type":"string","description":"Workflow UUID."},"graph":{"type":"object","description":"API graph JSON `{ version, nodes[], edges[] }` with UUID ids. Preserve or improve a non-overlapping left-to-right `nodeProps.position` layout. Copy from `get_workflow`."},"expected_version":{"type":"number","description":"Version number the client last read; API rejects if more than 1 behind latest."}},"required":["workflow_id","graph"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"runway.save_workflow_version","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/save_workflow_version","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"The newly appended workflow version. Earlier versions are preserved. The graph is saved even when `errorCount` is above zero.","properties":{"kind":{"type":"string","enum":["workflow_version_saved"]},"id":{"type":"string","description":"Workflow UUID. Pass to `run_workflow`."},"name":{"type":"string"},"version":{"type":"number","description":"Version number just created."},"editorUrl":{"type":"string","description":"Runway editor URL for the workflow, safe to show the user."},"errorCount":{"type":"number"},"warningCount":{"type":"number"},"errors":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}},"warnings":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}}},"required":["kind","id","name","version"],"additionalProperties":true}},{"name":"runway.generate_sound_effect","title":"Generate Sound Effect","description":"Generate a sound effect from a text description — foley, ambience, impacts, UI sounds, creature noises, whooshes, loops — and return an MP3. Describe the sound source, texture, environment, and how it evolves in `promptText`.\n\nCREDIT MODE: Runway account availability is checked against the currently connected workspace.\n\nCOST: 1 credit per second of requested `duration` (rounded up); 2 credits when `duration` is omitted and the model picks the length. Durations run 0.5–30 seconds.\n\nWHEN TO USE:\n- \"a door creaking open\", \"rain on a tin roof, 10 seconds\", \"sci-fi laser blast\", \"a looping crackling campfire\", \"footsteps on gravel\", \"a notification chime\".\n- NOT for music (use `generate_music`), NOT for speech or voiceover (use `generate_speech`), NOT for adding sound to an existing video (generate the effect here, then combine externally).\n\nAVAILABILITY: sound effects are behind a workspace feature flag. If the API rejects the task type, tell the user the feature is not enabled on their workspace and stop — do not retry.\n\nPROMPTING TIPS: name the source first (\"heavy wooden door\"), then the action (\"slams shut\"), then the space (\"in a stone hallway, long reverb tail\"). Mention pacing for longer effects (\"starts quiet, builds to a roar\"). Set `loop: true` for ambience or beds meant to repeat seamlessly. Max 450 characters.\n\nUSER-FACING REPLIES: Talk about the sound (what it is, how long, what it's for), not the model or task machinery. Do not mention ElevenLabs unless the user asks. The output is an MP3 the viewer plays inline; headless agents get the URL from `get_task`.\n\nParameters:\n- promptText: Required. What the sound effect should be. Max 450 characters.\n- duration: Optional. Length in seconds, 0.5–30. Omit to let the model choose.\n- loop: Optional. true to design the effect to loop seamlessly (ambience, beds). Default false.\n- name: Optional. Display name for the asset in the user's Runway library. Defaults to the prompt. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"promptText":{"type":"string","description":"Description of the sound effect: source, action, environment, texture, how it evolves. Max 450 characters.","maxLength":450},"duration":{"type":"number","minimum":0.5,"maximum":30,"description":"Length in seconds (0.5–30). Costs 1 credit per second, rounded up. Omit to let the model pick (2 credits)."},"loop":{"type":"boolean","description":"Design the effect to loop seamlessly (ambience, beds, engines). Default false."},"name":{"type":"string","description":"Optional display name for the asset in the user's Runway library. Defaults to the prompt.","maxLength":500}},"required":["promptText"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"resource_name":"runway.generate_sound_effect","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/generate_sound_effect","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Result envelope discriminated by `kind`. `task_pending` / `task_batch_pending` mean the generation task was accepted by Runway and is running in the background (poll get_task or let the inline viewer update); `account_limitation` means the connected workspace cannot run the request; other kinds carry staged results or corrective guidance.","properties":{"kind":{"type":"string","description":"Result discriminator, e.g. 'task_pending', 'task_batch_pending', 'account_limitation'."},"taskId":{"type":"string","description":"Runway task ID for single-task results. Use with get_task."},"taskIds":{"type":"array","items":{"type":"string"},"description":"Runway task IDs for batch results (count > 1)."},"taskType":{"type":"string","description":"Internal Runway task type."},"outputKind":{"type":"string","enum":["image","video","audio"],"description":"Whether the finished asset will be an image, a video, or audio."},"prompt":{"type":"string","description":"Prompt the task was created with."},"status":{"type":"string","description":"Last observed task status for still-running tasks."},"meta":{"type":"object","description":"Viewer metadata: aspect ratio, resolution, duration, audio flags."},"reason":{"type":"string","description":"Limitation reason when kind is 'account_limitation'."},"modelLabel":{"type":"string","description":"Human-readable model label for account-limitation results."},"capability":{"type":"string","description":"What the plan blocked, phrased as the user's own action (e.g. 'Generating video'). Pass it to `show_plans_and_credits` as `gatedCapability` and use it when telling the user what happened."},"upgradeUrl":{"type":"string","description":"Runway pricing/billing page. Present when kind is account_limitation, and on every accepted result from a free-plan workspace (see isFreePlan). The inline viewer renders it; do not repeat it unless lowCredits is true or the user asks about plans."},"isFreePlan":{"type":"boolean","description":"True when the connected workspace is on the Free plan. The inline viewer shows a one-line upgrade nudge under the finished media; you do not need to add anything."},"nextTool":{"type":"string","description":"Tool to call next when kind is account_limitation."},"creditsRemaining":{"type":"number","description":"Approximate workspace credit balance after this submission, when it could be resolved."},"lowCredits":{"type":"boolean","description":"True when the remaining balance may not cover another generation — mention it to the user in one short sentence with topUpUrl."},"topUpUrl":{"type":"string","description":"Runway billing page to buy more credits when lowCredits is true on a paid plan. Free plans cannot top up; they get upgradeUrl instead."}},"required":["kind"],"additionalProperties":true}},{"name":"runway.generate_multishot_video","title":"Generate Multi-Shot Video","description":"Generate a multi-shot video — 3 to 5 connected scenes from a single story or per-shot prompts. Powered by Kling 3.0 (standard at 720p, pro at 1080p). No `model` parameter — resolution selects the engine.\n\nCREDIT MODE: Runway account availability is checked against the currently connected workspace.\n\nUse this when the user wants a short narrative or sequence:\n- \"a 10-second mini-story about a cat finding a friend\"\n- \"a multi-scene product ad: closeup, lifestyle, hero shot\"\n- \"transition through 3 environments: forest -> desert -> beach\"\n\nFor a single continuous shot, use `generate_video` instead. For editing/restyling an existing video, also use `generate_video` (with `referenceVideo`).\n\nREQUIRES A PAID RUNWAY WORKSPACE. On free workspaces this tool returns an account-limitation error without creating a task; do not retry.\n\nMODES:\n1. `auto` (DEFAULT) — Pass a single `storyPrompt` (or `promptText`, accepted as an alias) and the workflow plans the shots for you. Best when the user describes the *story* not the individual scenes. Example: `mode: \"auto\", storyPrompt: \"a barista discovers their cafe has been frozen in time\"`.\n2. `custom` — Pass per-shot prompts as `shots: [{prompt}, ...]` (3-5 shots). Total `duration` is divided evenly across them. Best when the user has specific ideas for each scene. Example: `mode: \"custom\", shots: [{prompt: \"wide shot of cafe\"}, {prompt: \"barista looks up, surprised\"}, {prompt: \"close on a frozen droplet of coffee\"}]`.\n\nOptional `firstSceneImage` anchors the opening frame for either mode.\n\nAvailability is checked against the current Runway workspace. Multi-shot tasks routinely take 5-10 minutes.\n\nUSER-FACING REPLIES: DO NOT mention the underlying engine (Kling 3.0 / Pro) to the user unless they explicitly ask which model was used. Talk about the multi-shot story — the scenes, transitions, and overall narrative — not the engine.\n\nParameters:\n- mode: `'auto'` (default) or `'custom'`.\n- storyPrompt: Required for `mode='auto'`. Full story / overall scene description.\n- shots: Required for `mode='custom'`. Array of `{prompt}`, 3-5 entries.\n- duration: Total seconds — `5` | `10` (default) | `15`. String values `'5'` | `'10'` | `'15'` are also accepted for backwards compatibility.\n- aspectRatio: `'16:9'` (default) | `'1:1'` | `'9:16'`. `ratio` is accepted as an alias.\n- resolution: `'720p'` (default, Kling 3.0 Standard) | `'1080p'` (Kling 3.0 Pro).\n- sound: Boolean, generate audio (default true).\n- firstSceneImage: Optional `{url, assetId?}` to anchor the first frame. If `assetId` is omitted, the URL is imported to a Runway dataset asset before submission because the multi-shot workflow requires a resolvable asset reference. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"mode":{"type":"string","enum":["auto","custom"],"description":"'auto' (default) or 'custom'."},"storyPrompt":{"type":"string","description":"Required for mode='auto'. Full story or scene description. promptText is also accepted as an alias."},"promptText":{"type":"string","description":"Alias for storyPrompt in mode='auto' for consistency with other generation tools."},"shots":{"type":"array","description":"Required for mode='custom'. Per-shot prompts (3-5 shots).","items":{"type":"object","properties":{"prompt":{"type":"string"}},"required":["prompt"],"additionalProperties":false},"minItems":3,"maxItems":5},"duration":{"enum":["5","10","15",5,10,15],"description":"Total duration in seconds: 5, 10 (default), or 15. String values '5', '10', and '15' are accepted for backwards compatibility."},"aspectRatio":{"type":"string","enum":["16:9","1:1","9:16"],"description":"'16:9' (default), '1:1', or '9:16'. ratio is also accepted as an alias."},"ratio":{"type":"string","enum":["16:9","1:1","9:16"],"description":"Alias for aspectRatio for consistency with other generation tools."},"resolution":{"type":"string","enum":["720p","1080p"],"description":"'720p' (default, Kling 3.0 Standard) or '1080p' (Kling 3.0 Pro)."},"sound":{"type":"boolean","description":"Generate audio (default true)."},"firstSceneImage":{"type":"object","description":"Optional first-scene anchor image.","properties":{"url":{"type":"string"},"assetId":{"type":"string","description":"Optional Runway dataset asset ID. If omitted, the MCP server imports the URL to create one before submitting."}},"required":["url"],"additionalProperties":false}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"resource_name":"runway.generate_multishot_video","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/generate_multishot_video","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Result envelope discriminated by `kind`. `task_pending` / `task_batch_pending` mean the generation task was accepted by Runway and is running in the background (poll get_task or let the inline viewer update); `account_limitation` means the connected workspace cannot run the request; other kinds carry staged results or corrective guidance.","properties":{"kind":{"type":"string","description":"Result discriminator, e.g. 'task_pending', 'task_batch_pending', 'account_limitation'."},"taskId":{"type":"string","description":"Runway task ID for single-task results. Use with get_task."},"taskIds":{"type":"array","items":{"type":"string"},"description":"Runway task IDs for batch results (count > 1)."},"taskType":{"type":"string","description":"Internal Runway task type."},"outputKind":{"type":"string","enum":["image","video","audio"],"description":"Whether the finished asset will be an image, a video, or audio."},"prompt":{"type":"string","description":"Prompt the task was created with."},"status":{"type":"string","description":"Last observed task status for still-running tasks."},"meta":{"type":"object","description":"Viewer metadata: aspect ratio, resolution, duration, audio flags."},"reason":{"type":"string","description":"Limitation reason when kind is 'account_limitation'."},"modelLabel":{"type":"string","description":"Human-readable model label for account-limitation results."},"capability":{"type":"string","description":"What the plan blocked, phrased as the user's own action (e.g. 'Generating video'). Pass it to `show_plans_and_credits` as `gatedCapability` and use it when telling the user what happened."},"upgradeUrl":{"type":"string","description":"Runway pricing/billing page. Present when kind is account_limitation, and on every accepted result from a free-plan workspace (see isFreePlan). The inline viewer renders it; do not repeat it unless lowCredits is true or the user asks about plans."},"isFreePlan":{"type":"boolean","description":"True when the connected workspace is on the Free plan. The inline viewer shows a one-line upgrade nudge under the finished media; you do not need to add anything."},"nextTool":{"type":"string","description":"Tool to call next when kind is account_limitation."},"creditsRemaining":{"type":"number","description":"Approximate workspace credit balance after this submission, when it could be resolved."},"lowCredits":{"type":"boolean","description":"True when the remaining balance may not cover another generation — mention it to the user in one short sentence with topUpUrl."},"topUpUrl":{"type":"string","description":"Runway billing page to buy more credits when lowCredits is true on a paid plan. Free plans cannot top up; they get upgradeUrl instead."}},"required":["kind"],"additionalProperties":true}},{"name":"runway.cancel_pro_trial","title":"Cancel Pro Trial","description":"Cancels the free Runway Pro trial so it is not charged. The workspace keeps Pro until the trial end date. Only call this when the user explicitly asks to cancel their trial. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.cancel_pro_trial","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/cancel_pro_trial","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"`kind: 'pro_trial_canceled'` with the date Pro access ends, or `kind: 'pro_trial_unavailable'` when there is no trial to cancel.","properties":{"kind":{"type":"string","enum":["pro_trial_canceled","pro_trial_unavailable"]},"endsAt":{"type":"string","description":"ISO time the trial and Pro access end."},"reason":{"type":"string"}},"required":["kind"],"additionalProperties":true}},{"name":"runway.list_brand_kits","title":"List Brand Kits","description":"Lists the connected workspace's visible Brand Kits with their category names and descriptions, without loading assets. Use this for cheap discovery when the user asks for branded work and no Brand Kit is already in context. Call `get_brand_kit` only after a kit is selected or when there is a single clearly applicable kit. An empty list means this workspace has no visible Brand Kits. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.list_brand_kits","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/list_brand_kits","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Visible Brand Kits in the connected workspace.","properties":{"kind":{"type":"string","enum":["brand_kit_list"]},"brandKits":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"updatedAt":{"description":"Last update time, or null."},"categories":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"description":{"description":"Category description, or null."}},"required":["id","name"],"additionalProperties":true}}},"required":["id","name","categories"],"additionalProperties":true}}},"required":["kind","brandKits"],"additionalProperties":true}},{"name":"runway.list_workflows","title":"List Workflows","description":"Lists Runway editor workflows in the authenticated workspace (name, id, updated time). Does not include the graph — use `get_workflow` with `include_graph: true` to inspect. If a similar workflow already exists, reuse it (`get_workflow` / `save_workflow_version` / `run_workflow`) instead of creating a duplicate. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/authoring` before composing or changing a graph, `runway://docs/workflows/examples` for the API shape, and `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"limit":{"type":"number","minimum":10,"maximum":100,"description":"Max results (10-100, default 12)."},"cursor":{"type":"string","description":"Pagination cursor from a previous list_workflows response."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.list_workflows","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/list_workflows","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Paginated list of saved workflows in the connected workspace.","properties":{"kind":{"type":"string","enum":["workflow_list"]},"workflows":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Workflow UUID for get_workflow / run_workflow."},"name":{"type":"string"},"description":{"description":"Workflow description, or null."},"updatedAt":{"type":"string"},"createdAt":{"type":"string"}},"required":["id","name"],"additionalProperties":true}},"nextCursor":{"description":"Pagination cursor for the next page, or null."}},"required":["kind","workflows"],"additionalProperties":true}},{"name":"runway.track_home_interaction","title":"Track Home Interaction","description":"Records one interaction with the Runway home credits or account controls. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["credits_opened","credit_details_opened","get_credits_clicked","upgrade_clicked","account_opened","manage_account_clicked"],"description":"The home control the user opened or clicked."}},"required":["action"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"openai/widgetAccessible":true,"ui":{"visibility":["app"]},"resource_name":"runway.track_home_interaction","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/track_home_interaction","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","properties":{"kind":{"type":"string","description":"Always 'home_interaction_recorded'."}},"required":["kind"],"additionalProperties":false}},{"name":"runway.whoami","title":"Account & Models","description":"Confirms the Runway connection is authenticated and returns the workspace this MCP connection is pinned to (chosen at sign-in) plus the list of image/video models available in that workspace. It does not return personal account details. Call this first to confirm auth and to pick a model the user can actually run. Also call it after a paid_plan_required result — `availableImageModels` and `availableVideoModels` are the only models you may offer as a fallback. Do not guess from a generate tool schema. Runway account availability is checked against the currently connected workspace. If `upgradeUrl` is present, the connected workspace is on a free plan. When the user asked for something that plan cannot run (every video tool, or an image model missing from `availableImageModels`), call `show_plans_and_credits` with `gatedCapability` set to the blocked action (e.g. \"Generating video\") to render the inline upgrade card — do not stop at describing the limitation. Paste `upgradeUrl` only if that tool is unavailable. If `multipleWorkspacesAvailable` is true, the user belongs to other Runway workspaces — call `list_workspaces` to see them. To switch the active workspace, the user must disconnect and reconnect the MCP from their client. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.whoami","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/whoami","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Connection status, the pinned workspace, and the model ids available in it. Contains no personal account details.","properties":{"authenticated":{"type":"boolean","description":"True when the Runway connection is authenticated."},"team":{"description":"The workspace this MCP connection is pinned to, or null if none: {id, name, organization, isPersonal, wasExplicitlyPicked}."},"multipleWorkspacesAvailable":{"type":"boolean","description":"True when the user belongs to other workspaces (see list_workspaces)."},"disabledModelsKnown":{"type":"boolean","description":"Whether the workspace admin-disabled model list could be resolved."},"availableImageModels":{"type":"array","items":{"type":"string"},"description":"Image model ids usable in the connected workspace."},"availableVideoModels":{"type":"array","items":{"type":"string"},"description":"Video model ids usable in the connected workspace."},"upgradeUrl":{"type":"string","description":"Present on free plans. Fallback link only — prefer calling `nextTool` so the user gets the inline upgrade card."},"nextTool":{"type":"string","description":"Present on free plans: 'show_plans_and_credits'. Call it (with `gatedCapability`) when the user asked for a paid-only capability such as video."},"gatedCapabilities":{"type":"object","description":"Present on free plans. Ready-made `gatedCapability` phrases for show_plans_and_credits, keyed by what the user asked for: {video, editVideo, expandVideo, multishotVideo, upscaleImage}."},"credits":{"type":"object","description":"Credit balance of the connected workspace: {unlimited: false, total, plan, purchased} — plan credits reset monthly, purchased ones do not — or {unlimited: true}. Omitted when the balance could not be resolved. Mention the balance to the user only when they ask or when it is low."}},"required":["authenticated","multipleWorkspacesAvailable","availableImageModels","availableVideoModels"],"additionalProperties":true}},{"name":"runway.get_workflow","title":"Get Workflow","description":"Gets a Runway workflow by id (name, description, updated time). Set `include_graph: true` to also load the saved graph. Optional `version` loads a specific version instead of latest. The graph JSON is for your next tool call — summarize the pipeline for the user; do not dump node IDs or ASCII diagrams unless they ask how it is wired. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/authoring` before composing or changing a graph, `runway://docs/workflows/examples` for the API shape, and `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"workflow_id":{"type":"string","description":"Workflow UUID."},"include_graph":{"type":"boolean","description":"If true, include the saved graph (latest, or `version` if set)."},"version":{"type":"number","description":"Specific version number to load when include_graph is true (default: latest)."}},"required":["workflow_id"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.get_workflow","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/get_workflow","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Workflow metadata. When include_graph is true, the full graph JSON is returned in the text content (second block), not here.","properties":{"kind":{"type":"string","enum":["workflow"]},"id":{"type":"string","description":"Workflow UUID."},"name":{"type":"string"},"version":{"type":"number","description":"Loaded graph version (present when include_graph is true)."}},"required":["kind","id","name"],"additionalProperties":true}},{"name":"runway.create_workflow","title":"Create Workflow","description":"Creates a new Runway workflow with an initial graph (version 1). Do not invent graph JSON — `list_workflows` then `get_workflow` include_graph: true and copy nodes/edges. If a similar workflow already exists in the workspace, update that one instead of creating a duplicate. Use the fewest necessary nodes and set non-overlapping `nodeProps.position` coordinates: inputs left, processing (including system prompt + LLM + JSON Parse) center, outputs right. Never tell the user to implement the graph themselves. Call `validate_workflow_graph` first. Response includes an editor URL and validation errors/warnings even when saved. To run it, call `run_workflow` next. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/authoring` before composing or changing a graph, `runway://docs/workflows/examples` for the API shape, and `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"name":{"type":"string","description":"Workflow display name (max 80 characters)."},"description":{"type":"string","description":"Optional short description."},"graph":{"type":"object","description":"API graph JSON `{ version, nodes[], edges[] }` with UUID node ids and `nodeType`. Every node must have a non-overlapping left-to-right `nodeProps.position`; minimize redundant constants and transforms. Copy from `get_workflow` include_graph. See `runway://docs/workflows/examples`. Not `{ type, config, inputs }` or ids like `input_photo`."}},"required":["name","graph"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"runway.create_workflow","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/create_workflow","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"The created workflow. The graph is saved even when `errorCount` is above zero, so check it before calling `run_workflow`.","properties":{"kind":{"type":"string","enum":["workflow_created"]},"id":{"type":"string","description":"Workflow UUID. Pass to `run_workflow`."},"name":{"type":"string"},"version":{"type":"number","description":"Always 1 for a newly created workflow."},"editorUrl":{"type":"string","description":"Runway editor URL for the workflow, safe to show the user."},"errorCount":{"type":"number"},"warningCount":{"type":"number"},"errors":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}},"warnings":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}}},"required":["kind","id","name","version"],"additionalProperties":true}},{"name":"runway.feedback","title":"Record Tool Feedback","description":"Record a diagnostic report about a Runway tool problem in this MCP server's logs.\n\nExamples of when to call:\n- A generation failed or produced unexpected results\n- You couldn't figure out which tool to use\n- The user said the result wasn't what they wanted\n- The prompting guide didn't have the info you needed\n\nThe Runway team can inspect these logs to investigate tool problems. Be specific about what went wrong. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"summary":{"type":"string","description":"One sentence: what went wrong?"},"attempted":{"type":"string","description":"What did you try?"},"userIntent":{"type":"string","description":"What was the user actually trying to accomplish?"}},"required":["summary","attempted","userIntent"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"runway.feedback","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/feedback","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Acknowledgment that the feedback was recorded.","properties":{"kind":{"type":"string","enum":["feedback_received"]}},"required":["kind"],"additionalProperties":true}},{"name":"runway.search_voices","title":"Search Voices","description":"Search the Eleven v4 voice library (thousands of voices beyond the preset list in `generate_speech`). Returns voices with a `voiceId` to pass to `generate_speech` with `model: \"eleven_v4\"`, either as `voiceId` or as a dialogue line's `voiceId`. Free: does not spend credits.\n\nWHEN TO USE: the user wants a voice the preset list does not cover (\"an old Scottish fisherman\", \"a Brazilian Portuguese news anchor\"), or asks to browse voices. Otherwise use the preset `voice` names.\n\nFilters match the library's lowercase labels exactly; if a filtered search returns nothing, retry with fewer filters or with `query` alone.\n\nAVAILABILITY: not enabled on every workspace yet. If it is not enabled, use preset voices instead. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"query":{"type":"string","maxLength":200,"description":"Free text matched against voice names and descriptions, e.g. 'raspy', 'news anchor', 'scottish'."},"gender":{"type":"string","description":"e.g. 'male', 'female', 'neutral'."},"age":{"type":"string","description":"e.g. 'young', 'middle_aged', 'old'."},"accent":{"type":"string","description":"e.g. 'american', 'british', 'australian'."},"language":{"type":"string","description":"ISO 639-1 code, e.g. 'en', 'es', 'pt'."},"useCase":{"type":"string","description":"e.g. 'narrative_story', 'conversational', 'characters_animation', 'social_media', 'advertisement', 'informative_educational'."},"limit":{"type":"number","minimum":1,"maximum":50,"description":"Results per page. Default 20."},"cursor":{"type":"string","description":"`nextCursor` from a previous call, for the next page."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.search_voices","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/search_voices","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","properties":{"kind":{"type":"string","enum":["voice_list"]},"voices":{"type":"array","items":{"type":"object","properties":{"voiceId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"previewUrl":{"type":"string"}},"required":["voiceId","name"],"additionalProperties":true}},"nextCursor":{"description":"Cursor for the next page, or null."}},"required":["kind","voices"],"additionalProperties":true}},{"name":"runway.show_plans_and_credits","title":"Plans & Credits","description":"Shows the connected workspace's remaining Runway credits plus available plans and top-up options as an inline card. Call it when the user asks about their credits, balance, plans, pricing, or how to buy more credits — and after a generation fails with an out-of-credits or low-credits result. After an out-of-credits failure, pass `creditsNeeded` (the approximate credit cost of that generation, from the failed tool's cost notes) to render a shortfall card. After a generation fails because the plan does not allow it, call it with `gatedCapability` set to the phrase from that error to render an upgrade card. Purchases are completed on runway.com; the card only links out. When the inline card renders, keep your reply to one short sentence — the card already shows the numbers and buttons. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"creditsNeeded":{"type":"number","description":"Approximate credit cost of the generation that just failed with out-of-credits, estimated from the failed tool's stated cost (e.g. 28 credits/second × duration). Renders the card in shortfall mode: a \"needs ~N credits — you have M\" header with top-up framing. Only pass it when a generation actually failed for credits and the cost is stated or clearly estimable."},"gatedCapability":{"type":"string","description":"What the current plan blocked, phrased as the action the user was trying to take, copied verbatim from a paid-plan-required error (e.g. 'Generating video'). Renders the card in upgrade-gate mode: a \"<capability> requires a paid plan\" header, that phrase bolded in each plan's features, and \"Unlock\" buttons. Never pass a bare model name — most users do not know what those mean. Omit for plain balance/plans questions."}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/credits-v1.html"},"resource_name":"runway.show_plans_and_credits","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/show_plans_and_credits","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Credit balance and plan catalog for the connected workspace, rendered by the inline plans & credits card.","properties":{"kind":{"type":"string","description":"Always 'plans_and_credits'."},"planName":{"type":"string","description":"Current plan display name, e.g. 'Free', 'Standard', 'Pro'."},"isFreePlan":{"type":"boolean"},"credits":{"type":"object","description":"Remaining balance: {unlimited: false, total, plan, purchased} or {unlimited: true}. Omitted when it could not be resolved."},"allowance":{"type":"number","description":"Full-cycle credit allowance (for the usage bar)."},"plans":{"type":"array","items":{"type":"object"},"description":"Self-serve plans shown as cards."},"billingUrl":{"type":"string","description":"Runway billing page (change plan)."},"topUp":{"type":"object","description":"One-time credit packs: {available, minCredits, url, packs}. `url` opens the billing page with the buy-credits modal already open; only paid plans can top up."},"pricingUrl":{"type":"string","description":"Public pricing page with the full plan comparison."},"shortfallContext":{"type":"object","description":"Present in shortfall mode: {creditsNeeded} — the approximate cost of the generation that failed for credits."},"gateContext":{"type":"object","description":"Present in upgrade-gate mode: {capability} for what the current plan cannot do. Any paid plan unlocks it — runwayml/api model gating is free-vs-paid only."}},"required":["kind","planName","isFreePlan","billingUrl","pricingUrl"],"additionalProperties":true}},{"name":"runway.generate_speech","title":"Generate Speech","description":"Turn text into spoken audio (text-to-speech) with one of Runway's preset voices and return an MP3. Pass the exact words to speak in `text` and pick a `voice` by name.\n\nCREDIT MODE: Runway account availability is checked against the currently connected workspace.\n\nCOST: 1 credit per 50 characters of `text`, rounded up (minimum 1). Max 5000 characters per call — split longer scripts into several calls.\n\nMODELS (pick with `model`; default `eleven_v3`):\n- `eleven_v3`: Most expressive. Understands inline delivery tags in the text such as [whispers], [laughs], [sighs], [excited]. Best for dialogue, characters, and emotive narration.\n- `eleven_multilingual_v2`: Steadier and more predictable; ignores delivery tags. Best for long neutral narration, product voiceover, and non-English text.\n\nVOICES (pick with `voice`; default `Leslie`). Choose by the user's description (\"deep male narrator\", \"cute cartoon voice\", \"British woman, calm\"); do not ask the user to pick from the full list unless they want to browse:\n- Maya: feminine, young, african american accent, chill (conversational)\n- Arjun: masculine, middle aged, indian accent, intense (narrator)\n- Serene: feminine, young, american accent, calm (narrator)\n- Bernard: masculine, middle aged, american accent, confident (animated)\n- Billy: masculine, middle aged, american accent, hyped (animated)\n- Mark: masculine, middle aged, american accent, excited (animated)\n- Clint: masculine, middle aged, american accent, husky (animated)\n- Mabel: feminine, middle aged, us southern accent, relaxed (narrator)\n- Chad: masculine, young, american accent, excited (animated)\n- Leslie: feminine, middle aged, american accent, professional (narrator)\n- Eleanor: feminine, middle aged, canadian accent, classy (narrator)\n- Elias: masculine, old, american accent, calm (narrator)\n- Elliot: masculine, middle aged, american accent, anxious (animated)\n- Grungle: masculine, middle aged, american accent, raspy (animated)\n- Brodie: masculine, young, american accent, chill (animated)\n- Sandra: feminine, middle aged, american accent, sassy (conversational)\n- Kirk: masculine, middle aged, british accent, rough (animated)\n- Kylie: feminine, young, australian accent, confident (influencer)\n- Lara: feminine, young, american accent, confident (influencer)\n- Lisa: feminine, young, german accent, casual (conversational)\n- Malachi: masculine, middle aged, american accent, confident (animated)\n- Marlene: feminine, middle aged, british accent, classy (narrator)\n- Martin: masculine, middle aged, american accent, rough (animated)\n- Miriam: feminine, middle aged, british accent, calm (narrator)\n- Monster: masculine, old, american accent, deep (animated)\n- Paula: feminine, middle aged, british accent, calm (conversational)\n- Pip: feminine, young, american accent, cute (animated)\n- Rusty: masculine, old, british accent, raspy (animated)\n- Ragnar: masculine, middle aged, american accent, deep (animated)\n- Xylar: neutral, middle aged, american accent, modulated (animated)\n- Maggie: feminine, young, american accent, calm (narration)\n- Jack: masculine, old, irish accent, sailor (video games)\n- Katie: feminine, young, american accent, soft (news)\n- Noah: masculine, young, american accent, calm (meditation)\n- James: masculine, middle aged, australian accent, casual (conversational)\n- Rina: feminine, young, american accent, calm (meditation)\n- Ella: feminine, young, american accent, emotional (narration)\n- Frank: masculine, young, american accent, deep (narration)\n- Claudia: feminine, young, british-swedish accent, seductive (characters)\n- Niki: feminine, middle aged, american accent, friendly (narration)\n- Vincent: masculine, old, australian accent, calm (news)\n- Tom: masculine, middle aged, british accent, authoritative (news)\n- Wanda: feminine, middle aged, american accent, pleasant (interactive)\n- Benjamin: masculine, middle aged, american accent, deep (narration)\n- Kiana: feminine, young, american accent, whisper (audiobook)\n- Rachel: feminine, young, english-swedish accent, childish (animation)\n\nWHEN TO USE:\n- \"read this aloud\", \"voiceover for my video: …\", \"narrate this script in a British accent\", \"say 'welcome back' in a robotic voice\".\n- NOT for music (use `generate_music`), NOT for sound effects (use `generate_sound_effect`), NOT for cloning a specific person's voice, NOT for translating or re-voicing an existing audio/video file.\n\nPROMPTING TIPS: `text` is spoken verbatim — do not include stage directions as plain prose. With `eleven_v3` you may add bracketed delivery tags inline, e.g. \"[whispers] Don't move. [pause] Did you hear that?\"; `eleven_multilingual_v2` ignores tags. Use punctuation and line breaks to control pacing. Set `languageCode` when the text is not English and pronunciation matters.\n\nUSER-FACING REPLIES: Talk about the voiceover (which voice, what it says, how long), not the model or task machinery. Do not mention ElevenLabs unless the user asks. The output is an MP3 the viewer plays inline; headless agents get the URL from `get_task`.\n\nParameters:\n- text: Required. The words to speak, verbatim. Max 5000 characters.\n- voice: Optional. Preset voice name from the list above. Default `Leslie`.\n- model: Optional. `eleven_v3` (default, expressive, supports tags) or `eleven_multilingual_v2` (steady).\n- speed: Optional. 0.7–1.2; 1.0 is normal.\n- languageCode: Optional. ISO 639-1 code (e.g. `es`, `de`, `pt-br`) to enforce pronunciation for non-English text.\n- name: Optional. Display name for the asset in the user's Runway library. Defaults to the text. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"text":{"type":"string","description":"The exact words to speak. Max 5000 characters (1 credit per 50).","maxLength":5000},"voice":{"type":"string","enum":["Maya","Arjun","Serene","Bernard","Billy","Mark","Clint","Mabel","Chad","Leslie","Eleanor","Elias","Elliot","Grungle","Brodie","Sandra","Kirk","Kylie","Lara","Lisa","Malachi","Marlene","Martin","Miriam","Monster","Paula","Pip","Rusty","Ragnar","Xylar","Maggie","Jack","Katie","Noah","James","Rina","Ella","Frank","Claudia","Niki","Vincent","Tom","Wanda","Benjamin","Kiana","Rachel"],"description":"Preset voice name. Default 'Leslie'. Pick from the descriptions in the tool description."},"model":{"type":"string","enum":["eleven_v3","eleven_multilingual_v2"],"description":"Speech model. 'eleven_v3' (default) is most expressive and supports inline [tags]; 'eleven_multilingual_v2' is steadier."},"speed":{"type":"number","minimum":0.7,"maximum":1.2,"description":"Speech speed multiplier, 0.7–1.2. 1.0 is normal."},"languageCode":{"type":"string","description":"ISO 639-1 language code (e.g. 'en', 'es', 'pt-br') to enforce pronunciation for non-English text.","minLength":2,"maxLength":5},"name":{"type":"string","description":"Optional display name for the asset in the user's Runway library. Defaults to the text.","maxLength":500}},"required":["text"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"resourceUri":"ui://runway/media-viewer-v2.html"},"resource_name":"runway.generate_speech","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/generate_speech","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Result envelope discriminated by `kind`. `task_pending` / `task_batch_pending` mean the generation task was accepted by Runway and is running in the background (poll get_task or let the inline viewer update); `account_limitation` means the connected workspace cannot run the request; other kinds carry staged results or corrective guidance.","properties":{"kind":{"type":"string","description":"Result discriminator, e.g. 'task_pending', 'task_batch_pending', 'account_limitation'."},"taskId":{"type":"string","description":"Runway task ID for single-task results. Use with get_task."},"taskIds":{"type":"array","items":{"type":"string"},"description":"Runway task IDs for batch results (count > 1)."},"taskType":{"type":"string","description":"Internal Runway task type."},"outputKind":{"type":"string","enum":["image","video","audio"],"description":"Whether the finished asset will be an image, a video, or audio."},"prompt":{"type":"string","description":"Prompt the task was created with."},"status":{"type":"string","description":"Last observed task status for still-running tasks."},"meta":{"type":"object","description":"Viewer metadata: aspect ratio, resolution, duration, audio flags."},"reason":{"type":"string","description":"Limitation reason when kind is 'account_limitation'."},"modelLabel":{"type":"string","description":"Human-readable model label for account-limitation results."},"capability":{"type":"string","description":"What the plan blocked, phrased as the user's own action (e.g. 'Generating video'). Pass it to `show_plans_and_credits` as `gatedCapability` and use it when telling the user what happened."},"upgradeUrl":{"type":"string","description":"Runway pricing/billing page. Present when kind is account_limitation, and on every accepted result from a free-plan workspace (see isFreePlan). The inline viewer renders it; do not repeat it unless lowCredits is true or the user asks about plans."},"isFreePlan":{"type":"boolean","description":"True when the connected workspace is on the Free plan. The inline viewer shows a one-line upgrade nudge under the finished media; you do not need to add anything."},"nextTool":{"type":"string","description":"Tool to call next when kind is account_limitation."},"creditsRemaining":{"type":"number","description":"Approximate workspace credit balance after this submission, when it could be resolved."},"lowCredits":{"type":"boolean","description":"True when the remaining balance may not cover another generation — mention it to the user in one short sentence with topUpUrl."},"topUpUrl":{"type":"string","description":"Runway billing page to buy more credits when lowCredits is true on a paid plan. Free plans cannot top up; they get upgradeUrl instead."}},"required":["kind"],"additionalProperties":true}},{"name":"runway.get_task","title":"Check Task Status","description":"Gets details for a Runway task by ID — used to check status and retrieve the result of a generation/edit task once it completes. Generation tools (`generate_image`, `generate_video`, `generate_multishot_video`, `run_workflow`) return immediately with a task ID. If an inline viewer rendered, do not poll; the viewer updates itself. If no viewer rendered, poll this tool until SUCCEEDED (wait 60-120s between calls for video/workflow). For `dynamic_workflow` tasks, the text includes overall %, per-step name/status, and output URLs when nodes finish. Parent `dynamic_workflow` SUCCEEDED can have empty artifacts — use the step Outputs, not artifacts[0]. Set `include_workflow_execution: true` only when you need node UUIDs. When status is SUCCEEDED the response includes the asset URL. USER-FACING REPLIES: describe the asset content; the `taskType` in the response encodes the model name and is for debugging only — keep it out of your reply unless the user explicitly asks which model was used. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"id":{"type":"string","description":"Task ID."},"include_workflow_execution":{"type":"boolean","description":"Workflow runs only (`run_workflow`). If true, also include node UUIDs. Ignored for other tasks. Default is named steps + output URLs."}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.get_task","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/get_task","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Task state discriminated by `kind`: 'task_pending' (still running), 'task_failed', 'image'/'video'/'audio' (succeeded, `url` holds the asset), or 'task_succeeded_no_artifact'.","properties":{"kind":{"type":"string","enum":["task_pending","task_failed","image","video","audio","task_succeeded_no_artifact"]},"taskId":{"type":"string"},"taskType":{"type":"string"},"status":{"type":"string","description":"Raw Runway task status."},"url":{"type":"string","description":"Finished asset URL (kinds 'image', 'video', and 'audio')."},"prompt":{"type":"string"},"meta":{"type":"object","description":"Media metadata: model id/label, width, height, duration, audio, ratio, and resolution."},"progressPercent":{"type":"number"},"progressText":{"type":"string"},"queuedSeconds":{"type":"number"},"error":{"type":"string","description":"Error message for failed tasks."},"errorInfo":{"type":"object","description":"Categorized failure: {category, title, hint, reason?, moderationCategory?}."},"workflowExecution":{"type":"object","description":"Per-node status summary for dynamic_workflow tasks."}},"required":["kind","taskId"],"additionalProperties":true}},{"name":"runway.validate_workflow_graph","title":"Validate Workflow Graph","description":"Validates a workflow graph without saving. Use before `create_workflow` or `save_workflow_version`. Returns task deprecations for model steps. Tell the user about upcoming sunsets and ask before switching a retired model. Graph must be API JSON (UUID node ids, `nodeType`, `nodeOutputs`) — copy from `get_workflow` include_graph, do not invent `{ type, config }`. Set `estimate_cost: true` to also fetch a credit estimate for the graph. Do not invent graph JSON. `list_workflows` → `get_workflow` include_graph: true and copy nodes/edges. Read `runway://docs/workflows/authoring` before composing or changing a graph, `runway://docs/workflows/examples` for the API shape, and `runway://docs/workflows/models` before image/video chains. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"graph":{"type":"object","description":"API graph JSON `{ version, nodes[], edges[] }`. Copy from `get_workflow` include_graph. Not `{ type, config, inputs }`."},"estimate_cost":{"type":"boolean","description":"If true, also POST /v1/dynamic_workflows/cost-estimate."}},"required":["graph"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"runway.validate_workflow_graph","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/validate_workflow_graph","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Validation diagnostics for the submitted graph. Nothing is saved or run, and no credits are charged.","properties":{"kind":{"type":"string","enum":["workflow_validation"]},"valid":{"type":"boolean"},"errorCount":{"type":"number"},"warningCount":{"type":"number"},"errors":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}},"warnings":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":true}},"deprecationsKnown":{"type":"boolean","description":"False when task deprecation status could not be checked."},"taskDeprecations":{"type":"array","description":"Deprecated workflow nodes; this does not change the API graph validation result.","items":{"type":"object","properties":{"nodeId":{"type":"string"},"taskType":{"type":"string"},"sunsetAt":{"type":["string","null"]},"reason":{"type":["string","null"]},"retired":{"type":"boolean"},"unavailable":{"type":"boolean"}},"required":["nodeId","taskType","sunsetAt","reason","retired","unavailable"]}},"estimatedCredits":{"type":"number","description":"Credit estimate for one run, present only when `estimate_cost` was true, the graph is valid, and the estimate call succeeded."}},"required":["kind","valid"],"additionalProperties":true}},{"name":"runway.complete_upload","title":"Complete Upload","description":"Finalize a file upload and get the asset URL.\n\nCall this AFTER successfully uploading the file bytes to the temporary upload URL(s) from `init_upload`.\n\nUSER-FACING REPLIES: Do not mention provider-specific storage services. Say \"Runway upload\", \"Runway-hosted asset\", or \"temporary upload URL\" instead.\n\n`parts` is REQUIRED — even for single-part uploads. Each entry corresponds to one PUT response and carries the ETag from that response's `etag` header (strip surrounding quotes if present).\n\nReturns the asset URL to use as `startFrame` / `endFrame` / `referenceImages[].url` in the generation tools, or `referenceVideo.url` in `generate_video` for video-to-video edits. This tool is part of plugin `Runway`.","inputSchema":{"type":"object","properties":{"rationale":{"type":"string","description":"Why are you calling this tool? What is the user actually trying to accomplish? Be specific — e.g., \"user uploaded a vacation photo and asked to animate it as a 5-second clip for Instagram\"."},"uploadId":{"type":"string","description":"The uploadId from init_upload."},"parts":{"type":"array","description":"Array of {partNumber, etag} from each PUT response. Required even for single-part uploads.","items":{"type":"object","properties":{"partNumber":{"type":"number"},"etag":{"type":"string"}},"required":["partNumber","etag"],"additionalProperties":false},"minItems":1}},"required":["uploadId","parts"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"runway.complete_upload","_codex_apps":{"resource_uri":"/asdk_app_6a05e3b201788191be12b590b43e6ce3/link_6aa30dd5f8c4819192abc46f8ff54dcc/complete_upload","contains_mcp_source":true},"connector_id":"asdk_app_6a05e3b201788191be12b590b43e6ce3","connector_name":"Runway","connector_description":"Generate with every AI model","link_id":"link_6aa30dd5f8c4819192abc46f8ff54dcc","link_owner_profile":{}},"outputSchema":{"type":"object","description":"Finalized upload with the reusable Runway-hosted asset URL.","properties":{"kind":{"type":"string","enum":["upload_complete"]},"assetUrl":{"type":"string","description":"Runway-hosted asset URL to pass into generation tools (startFrame.url, referenceImages[].url, referenceVideo.url, ...)."}},"required":["kind","assetUrl"],"additionalProperties":true}}],"entrypoints":[{"toolName":"higgsfield.open_home","title":"Higgsfield","icon":{"logoDarkUrl":"https://files.openai.com/content?id=file_0000000085f881f5abddb2561787bd9a&cdn=1&cp=pi&ma=32659200&ts=0&p=pi&cid=11&sig=ea90e77f50d17f209950698f70b7c458c0f6484c7a087bb4c58b10ac2a5d22c4&v=0","logoUrl":"https://files.openai.com/content?id=file_00000000bef48230b2e1460fa9919190&cdn=1&cp=pi&ma=30585600&ts=0&p=pi&cid=11&sig=c89c0a8996d0483156d3ef41e4d0b69aaa51a4c7c6eb668c3b9a68db511e1d39&v=0"}},{"toolName":"runway.list_recent","title":"Runway Assets","icon":{"logoDarkUrl":"https://files.openai.com/content?id=file_00000000abe481f79a9d2116a8f31246&cdn=1&cp=pi&ma=31968000&ts=0&p=pi&cid=11&sig=ccd035275a064d2d24b1af0e55fb71b0007e1cf279db3b249cf887b38a8478ce&v=0","logoUrl":"https://files.openai.com/content?id=file_00000000abe481f79a9d2116a8f31246&cdn=1&cp=pi&ma=31968000&ts=0&p=pi&cid=11&sig=ccd035275a064d2d24b1af0e55fb71b0007e1cf279db3b249cf887b38a8478ce&v=0"}}]}]},"global-dictation-first-use-nudge-state-v1":"eligible","aeon-last-activity-v1:01a1041d-e46e-740f-a5a6-9737a9ca0014":1791402222000,"sidebar-more-menu-seen-mcp-destination-ids-by-account-id-v1":{"5c6b1126-9e35-469c-bab4-57a93f85a51c":["mcp:[\"mcp-global\",\"asdk_app_6a3293e129088191abf0875820e839da\",\"open_home\",\"global\"]","mcp:[\"mcp-global\",\"asdk_app_6a05e3b201788191be12b590b43e6ce3\",\"list_recent\",\"global\"]"]},"sidebar-usage-snapshot-attempts-v1":{"day":20737,"keys":["chatgpt:5c6b1126-9e35-469c-bab4-57a93f85a51c:user-TIqRuAsoadtV0jKn8WDcZfU1:codex"]},"sidebar-project-expanded-v1-chatgpt:g-p-6ab88ffa500c81919aa5861b398c483e":true,"sidebar-project-expanded-v1-chatgpt:g-p-6aad68eab61481918b18ac7a4e4ba62f":true,"sidebar-project-expanded-v1-chatgpt:g-p-6a9ccc77b204819183dc6209667dd7b8":true,"sidebar-collapsed-sections-v1":{"chats":false,"cloud":false,"pinned":false,"thread