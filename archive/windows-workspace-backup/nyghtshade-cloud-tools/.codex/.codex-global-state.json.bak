search result).","type":"string"}},"required":["query"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.models_search","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/models_search","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"score":{"type":"number"},"match_reason":{"type":"string"},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"}},"required":["id","name","provider_name","description","output_type","parameters","medias","aspect_ratios"],"additionalProperties":false}},"next_page_token":{"type":"string"},"has_more":{"type":"boolean"},"free_gens":{"description":"Free generations the caller can spend right now, one entry per counter with the model ids that share it. Answer \"what free generations do I have\" from this; pass use_free_gens:true to generate_video for Higgsfield Genjutsu or execute_preset for Viral when the user asks to use one. For ai_influencer_sheet, prepare with ai_influencer_prepare, then use ai_influencer_generate with use_free_gens:true and max_credits:0, never generate_image.","type":"array","items":{"type":"object","properties":{"job_set_types":{"type":"array","items":{"type":"string"},"description":"Job-set types sharing this counter. viral_hub_video covers all Viral chain presets; one preset execution spends one attempt. ai_influencer_sheet is spent through ai_influencer_generate with use_free_gens:true or the AI Influencer Builder’s Use free gens toggle."},"remaining":{"type":"number","description":"Free generations left on the counter. 0 = granted and spent."},"parameters":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"description":"Allowed values per request parameter for a free run; an absent parameter is uncapped."},"max_duration":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Upper bound in seconds for a free run, or null."}},"required":["job_set_types","remaining","parameters","max_duration"],"additionalProperties":false}},"related_tools":{"description":"Standalone tools (not catalog models) relevant to the recommend query — e.g. motion_control for recast/puppeteer, upscale_image/upscale_video for enhance, outpaint_image for expand/uncrop, reframe for a video aspect-ratio change, remove_background for cutout. Call the named tool directly; it will not appear in items.","type":"array","items":{"type":"object","properties":{"tool":{"type":"string"},"use_when":{"type":"string"}},"required":["tool","use_when"],"additionalProperties":false}},"error":{"type":"string"},"status":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_create_brand","title":"Create Ads Studio Brand","description":"Research a brand from its website and build its Ads Studio brand profile: products, palette, logo, tone and audience, read from the live site. Pass the website when you have it - with a URL the research starts at once and takes a few minutes; with only a name Ads Studio answers with the site it thinks was meant and starts nothing, so confirm that with the user and call again with the URL. This reads the brand's own public website. It does not design logos or brand assets (that is the brand-asset-creation workflow) and it is not the Marketing Studio brand-kit record (marketing_create_brand_kit). Before the first Ads Studio call in a conversation, load the Ads Studio instructions with get_preset_instructions and preset 'ads-studio'. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"input":{"type":"string","minLength":1,"maxLength":2000,"description":"The brand's website URL, or its name if the user has not given a URL."}},"required":["input"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-v2.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-v2.html"},"resource_name":"higgsfield.ads_studio_create_brand","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_create_brand","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"started":{"description":"True when the research is running; false when a website is still needed.","type":"boolean"},"brand_id":{"type":"string"},"needs_confirmation":{"type":"boolean"},"suggested_website":{"type":"string"},"suggested_brand_name":{"type":"string"},"next_step":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","