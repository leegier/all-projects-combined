ault one) without creating a job or spending credits. Accepts human or animal tiers, traits, brief, seed, at most one confirmed identity image in medias and up to three Style references in item_medias. Preserves animal-v3 look and animal trait choices from saved settings; FNF validates variant IDs against the current catalog. Default randomize=true fills unspecified traits using builder shuffle rules; reference identity traits stay unset unless explicitly selected. randomize=false preserves explicit settings and defaults tier to freak (Bold). Returns exact params, credits and free_gens_remaining when known. For generation, pass these params unchanged to ai_influencer_generate; preview-only requests stop here. Repeating preparation may produce a different random design. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]},"selection":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"maxItems":4,"type":"array","items":{"type":"string"}}},"brief":{"type":"string","maxLength":4000},"seed":{"type":"integer","minimum":1,"maximum":1000000},"medias":{"maxItems":1,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}},"item_medias":{"maxItems":3,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}},"body_color":{"type":"string","pattern":"^#[\\dA-F]{6}$"},"animal_variant":{"oneOf":[{"type":"object","properties":{"version":{"type":"string","const":"animals-v1"},"tier":{"type":"string","enum":["insects","frogs","cats","dogs","capybaras","birds"]},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"look":{"type":"null"}},"required":["version","tier","id"],"additionalProperties":false},{"type":"object","properties":{"version":{"type":"string","const":"animals-v3"},"tier":{"type":"string","enum":["insects","frogs","cats","dogs","capybaras","birds"]},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"look":{"type":"object","properties":{"form":{"type":"string","minLength":1,"maxLength":20000},"hair":{"type":"string","minLength":1,"maxLength":20000},"build":{"type":"string","minLength":1,"maxLength":20000},"height":{"type":"string","minLength":1,"maxLength":20000},"proportions":{"type":"string","minLength":1,"maxLength":20000},"gender":{"type":"string","enum":["male","female","non_binary"]},"aesthetic":{"type":"string","enum":["casual","sporty","streetstyle","y2k","retro","goth","theatrical","suits"]}},"required":["form","hair","build","height","proportions","gender","aesthetic"],"additionalProperties":false}},"required":["version","tier","id","look"],"additionalProperties":false}]},"trait_variants":{"type":"object","properties":{"version":{"type":"string","const":"appearance-v2"},"choices":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string","enum":["original","v1","v2","v3","v4","v5"]},{"type":"string","enum":["v1","v2","v3","v4","v5","v6","v7","v8","v9","v10"]}]}},"animal_choices":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"integer","minimum":0,"maximum":4}},{"type":"null"}]}},"required":["version","choices"],"additionalProperties":false},"batch_size":{"type":"integer","minimum":1,"maximum":4},"randomize":{"type":"boolean"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.ai_influencer_prepare","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_prepare","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"params":{"type":"object","properties":{"tier":{"type":"string","enum":["normal","freak","total","insects","frogs","cats","dogs","capybaras","birds"]},"selection":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"maxItems":4,"type":"array","items":{"type":"string"}}},"brief":{"type":"string","maxLength":4000},"medias":{"maxItems":1,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","const":"image"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"],"additionalProperties":false}},"required":["role","data"],"additionalProperties":false}},"item_