16.html","ui":{"visibility":["model","app"],"resourceUri":"ui://higgsfield/home-v16.html"},"openai/ui":{"entrypoints":[{"type":"global"},{"type":"thread"}]},"resource_name":"higgsfield.open_home","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/open_home","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.marketing_list_settings","title":"List Marketing Settings","description":"Read-only list of existing Marketing Studio setup settings. Use returned ids as setting_id in generate_video. Does not create, update, or delete settings. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"size":{"default":20,"type":"integer","minimum":1,"maximum":100},"cursor":{"type":"number"},"search":{"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.marketing_list_settings","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/marketing_list_settings","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{}},"total_count":{"type":"number"},"cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"user_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"preset_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"has_more":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.media_confirm","title":"Confirm Upload","description":"Confirm file uploads after using media_upload's upload_url method. Call this only after every curl PUT returned HTTP 200. Supports confirming multiple uploads at once via media_ids. OpenAI routing: use this for sandbox-created files uploaded through media_upload + sandbox_exec. Do not call it after media_upload_and_confirm; ChatGPT attachments handled by that tool are already confirmed. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"type":{"type":"string","enum":["image","video","audio","file"],"description":"Media type being confirmed. Use 'file' for general files (documents, archives, code) uploaded with type file."},"media_id":{"description":"Single media ID to confirm","type":"string"},"media_ids":{"description":"1–20 media IDs to confirm in parallel","minItems":1,"maxItems":20,"type":"array","items":{"type":"string"}}},"required":["type"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.media_confirm","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/media_confirm","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"results":{"description":"Confirmed uploads. Pass media_id as the value in the medias array of generation tools.","type":"array","items":{"type":"object","properties":{"media_id":{"type":"string"},"status":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"required":["media_id","status"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.track_skill_activation","title":"Track Skill Activation","description":"Report using a Higgsfield skill for a new user request, once per skill per request. Send only its canonical name. Preserve widget-first and exclusive-tool turns; defer tracking when needed. Do not retry or block the task if unavailable. Returns an acknowledgement, not a delivery guarantee. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"skill_name":{"type":"string","enum":["ad-multiplier","ai-host-video","faceless-video","motion-craft","narration","video-montage","thumbnail-generation","ugc-video","video-editing","website-builder","youtube-script"]}},"required":["skill_name"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.track_skill_activation","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/track_skill_activation","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true}},"required":["ok"],"additionalProperties":false}},{"name":"higgsfield.resolve_faceless_channel_preset","title":"Resolve Faceless Channel Preset","description":"Resolve a faceless channel preset (from get_faceless_channel_presets) into a style reference media_id: the backend imports the preset's style image into the user's media storage. Pass the returned media_id as the style reference image in generation calls for every scene of the explainer. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"preset_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Preset id from get_faceless_channel_presets."}},"required":["preset_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.resolve_faceless_channel_preset","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/resolve_faceless_channel_preset","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"preset_id":{"type":"string"},"name":{"type":"string"},"media_id":{"type":"string","description":"Imported style image — use as the style reference in generations."}},"required":["preset_id","name","media_id"],"additionalProperties":false}},{"name":"higgsfield.deploy_website","title":"Deploy Website","description":"Build and deploy the website via CI, then return its live URL. Every deploy ships the live site at the website's public URL (there is no separate preview stage). IMPORTANT: commit and git push ALL your changes BEFORE calling this — the build runs from the pushed repo. Deploy again after ANY later change: publish_website does NOT deploy (it only lists the already-live build on the community feed), so this tool is the only way changes ship. A failed build returns the log; a still-running build returns status 'pending' — call website_status to check. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","description":"The website's id (returned by create_website)."}},"required":["website_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/website-deploy.html","ui":{"resourceUri":"ui://higgsfield/website-deploy.html"},"resource_name":"higgsfield.deploy_website","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/deploy_website","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"status":{"description":"deployed / failed / pending","type":"string"},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"error":{"description":"Build log when the deploy failed.","anyOf":[{"type":"string"},{"type":"null"}]},"name":{"description":"The deployed site's title (from its og:title / <title>).","anyOf":[{"type":"string"},{"type":"null"}]},"favicon_url":{"description":"The deployed site's favicon URL.","anyOf":[{"type":"string"},{"type":"null"}]},"og_image_url":{"description":"The deployed site's OG banner image URL.","anyOf":[{"type":"string"},{"type":"null"}]},"website_id":{"description":"Echo of the input id — the widget's publish/contest buttons need it.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_get_run","title":"Get Ads Studio Generation","description":"Read one Ads Studio generation run: its status and every concept in it, with the ad copy. Opens the generation card, which shows the pictures - there is no image link in the result and none to ask for. Call it when the user asks about a run - never on your own initiative and never in a loop. A run can read done while its pictures are still rendering, so check still_rendering before telling the user the ads are ready. A queued run carries its place in line; a canceled run stays canceled and is not a failure. Name a creative by its concept_id. These pictures are not ordinary generations: do not pass Ads Studio ids to show_generation_by_ids or jobs_wait. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"run_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Run id from ads_studio_generate or ads_studio_list_runs."}},"required":["run_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/ads-studio-run.html","ui":{"resourceUri":"ui://higgsfield/ads-studio-run.html"},"resource_name":"higgsfield.ads_studio_get_run","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_get_run","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"run_id":{"type":"string"},"status":{"type":"string"},"stage":{"type":"string"},"subject":{"type":"string"},"brand_id":{"type":"string"},"product_id":{"type":"string"},"concepts_requested":{"type":"number"},"aspect_ratio":{"type":"string"},"still_rendering":{"type":"boolean"},"rendered":{"type":"number"},"rendering":{"type":"number"},"waiting":{"type":"number"},"failed":{"type":"number"},"queue":{"type":"object","properties":{"position":{"type":"number"},"plan_cap":{"type":"number"}},"additionalProperties":false},"credits":{"type":"object","properties":{"reserved":{"type":"number"},"settled":{"type":"number"}},"additionalProperties":false},"concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"description":"The id to name this creative by in Ads Studio.","type":"string"},"position":{"type":"number"},"status":{"type":"string"},"render_status":{"type":"string"},"has_picture":{"description":"The picture is ready and shows on the generation card.","type":"boolean"},"headline":{"type":"string"},"primary_text":{"type":"string"},"cta":{"type":"string"},"destination_url":{"type":"string"},"aspect_ratio":{"type":"string"},"render_error":{"type":"string"}},"additionalProperties":false}},"run_error":{"description":"Why the run failed, in ai-cmo's own words.","type":"string"},"created_at":{"type":"string"},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.video_analysis_create","title":"Create Video Analysis","description":"Start a scene-by-scene analysis of a video. Provide EXACTLY ONE of: (a) video_input_id — UUID of a video the user has uploaded via media_upload_and_confirm, or (b) youtube_url — a YouTube link (youtube.com / youtu.be hosts only). Returns immediately with status='queued'; poll video_analysis_status until status='completed'. Processing typically takes 3-5 minutes on average. IMPORTANT: warn the user up front that the longer the video, the less accurate the scene-by-scene analysis becomes — short clips give the most reliable results. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"video_input_id":{"description":"UUID of the uploaded source video (the media_id returned by the upload tool).","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"youtube_url":{"type":"string","pattern":"^https:\\/\\/(?:(?:www\\.|m\\.)?youtube\\.com\\/|youtu\\.be\\/).+","description":"HTTPS YouTube video URL on youtube.com, www.youtube.com, m.youtube.com, or youtu.be."}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"oneOf":[{"required":["video_input_id"]},{"required":["youtube_url"]}]}]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.video_analysis_create","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/video_analysis_create","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"result":{"type":"object","properties":{"id":{"type":"string"},"video_input_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"youtube_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","enum":["queued","in_progress","completed","failed"]},"fail_reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"video_s3_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"scenes":{"anyOf":[{"type":"array","items":{}},{"type":"null"}]}},"required":["id","video_input_id","youtube_url","status","fail_reason","video_s3_url","scenes"],"additionalProperties":false}},"required":["result"],"additionalProperties":false}},{"name":"higgsfield.assets_picker_list","title":"Assets Picker","description":"List existing uploaded, generated, or liked image/video assets for an app picker. Invoked only by the app; never uploads, generates, or modifies assets. Sort applies only to uploads. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"source":{"type":"string","enum":["uploads","generations","liked","influencer","influencer-liked"]},"kind":{"type":"string","enum":["image","video"]},"cursor":{"description":"Continuation cursor returned by this picker for the same source, kind and upload sort.","anyOf":[{"type":"string","minLength":1,"maxLength":2048},{"type":"number"}]},"size":{"default":30,"type":"integer","minimum":1,"maximum":50},"sort":{"default":"newest","description":"Uploads only: newest/oldest creation time or most recently used. Ignored for generations and liked assets.","type":"string","enum":["newest","oldest","last-used"]}},"required":["source","kind"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.assets_picker_list","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/assets_picker_list","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","description":"Confirmed media UUID for uploads, or individual job UUID for generations and favourites. Never a job-set ID."},"kind":{"type":"string","enum":["image","video"]},"url":{"type":"string"},"thumbnailUrl":{"type":"string"},"title":{"type":"string"},"duration":{"type":"number","exclusiveMinimum":0},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},"createdAt":{"anyOf":[{"type":"string","minLength":1},{"type":"number"}]}},"required":["id","kind","url"],"additionalProperties":false}},"next_cursor":{"anyOf":[{"anyOf":[{"type":"string","minLength":1,"maxLength":2048},{"type":"number"}]},{"type":"null"}]}},"required":["items","next_cursor"],"additionalProperties":false}},{"name":"higgsfield.list_project_assets","title":"List Project Assets","description":"List generations and uploaded media/files placed in a Higgsfield media project, newest first. Omit folder_id for all accessible ordinary folders in the project; supply it for exactly that folder without descendants. Filter by source_types or output_kinds. Returns metadata and IDs, not prompts, playable URLs or previews. placement_id identifies the folder placement; item_id identifies the original job or upload. For type=job use item_id with job_status or job_display and pass the item's folder_id as folder context to inspect the generation, including shared folders. This is not the global generation gallery and does not generate media. Continue with cursor and the same original workspace, project, folder and filters; use has_more, not item count, to detect completion. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Authenticated workspace context from workspace discovery. Keep unchanged when paging; accessible shared projects may belong to other workspaces."},"size":{"description":"Page size, default 20; maximum 50.","type":"integer","minimum":1,"maximum":50},"cursor":{"description":"Opaque cursor from the previous response. Retain the original workspace and filters.","type":"string","maxLength":2048},"project_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"folder_id":{"description":"One exact folder, without descendants. Omit to list assets across all accessible ordinary folders in the project.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"source_types":{"minItems":1,"maxItems":5,"type":"array","items":{"type":"string","enum":["job","media_input","video_input","audio_input","file_input"]}},"output_kinds":{"minItems":1,"maxItems":5,"type":"array","items":{"type":"string","enum":["image","video","audio","file","unknown"]}}},"required":["workspace_id","project_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.list_project_assets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_project_assets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"has_more":{"type":"boolean"},"cursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"error":{"type":"string"},"project_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"items":{"type":"array","items":{"type":"object","properties":{"item_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["job","media_input","video_input","audio_input","file_input"]},"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"model_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"output_kind":{"type":"string","enum":["image","video","audio","file","unknown"]},"status":{"type":"string"},"created_at":{"type":"string"},"added_at":{"type":"string"},"liked_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"is_favourite":{"type":"boolean"},"placement_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["item_id","type","folder_id","model_id","output_kind","status","created_at","added_at","liked_at","is_favourite","placement_id","workspace_id"],"additionalProperties":false}}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_quote","title":"Quote an Ads Studio Generation","description":"Get the cost without starting a generation, reserving credits or spending credits. A user request to create ads, including an exact allocation submitted from the Ads Studio app, authorizes this read-only quote: do not ask for separate permission to quote. Takes the same arguments as ads_studio_generate so the quote matches the run. After quoting a requested generation, show the exact allocation and total credits; use ask_user_input (or ask_user_input_v3) only when that exact host tool is available, otherwise ask one concise chat question. Never invent a host tool or generate before explicit approval of this allocation and cost. A price-only request needs only the quote, not a spending-approval question. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"description":"The brand whose kit (logo, palette, tone) shapes the ads, from ads_studio_list_brands. Leave it out to make ads with no brand kit at all. The kit only reaches this brand's own products: a product of another brand, or of none, is advertised without it, so never promise the user this brand's look on someone else's product.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"brand_kit":{"description":"false to make the ads without the brand kit even though brand_id is set: a plain product or prompt ad. Default true when brand_id is set; always off without one.","type":"boolean"},"product_ids":{"description":"Products to advertise, from ads_studio_list_products - of this brand, another brand or none; each gets its own run. Name at least one product, or set include_brand, or give a prompt - with none of them there is nothing to advertise.","maxItems":24,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"include_brand":{"description":"Also generate a run about the brand itself, not a single product. Needs brand_id and the kit on.","type":"boolean"},"total":{"description":"How many concepts in total across all subjects: the number the user named, or 1 for a singular request. Ads Studio splits it between the subjects, so it must be at least one per subject.","type":"integer","minimum":1,"maximum":100},"prompt":{"description":"What the user asked for in their own words: the angle, the offer, the audience. A prompt alone, with no product and no brand, is an ad about what it describes.","type":"string","maxLength":2000},"images":{"description":"Pictures the user supplied for this generation: inspiration or photos of their product.","maxItems":4,"type":"array","items":{"type":"object","properties":{"url":{"type":"string","format":"uri","description":"A public https link to the picture."},"role":{"description":"style (default): a look to follow. product: a photo of the thing being advertised.","type":"string","enum":["style","product"]}},"required":["url"]}},"objective":{"description":"What the ads are for. Set it only when the user made the goal clear (more sales -> sales; sign-ups, demos, quotes -> leads; visits, clicks -> traffic; a launch or being known -> awareness; comments, shares -> engagement). Left out, the product's own profile decides.","type":"string","enum":["sales","leads","engagement","traffic","awareness"]},"aspect_ratio":{"default":"1:1","description":"The frame for the whole batch: 1:1 square feed, 9:16 stories and reels, 16:9 landscape, 3:4 portrait feed. 4:5 is not available - offer 3:4 as the nearest portrait frame.","type":"string","enum":["1:1","9:16","16:9","3:4"]}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.ads_studio_quote","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_quote","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"total_concepts":{"type":"number"},"credits":{"description":"Total Higgsfield credits the generation would reserve.","type":"number"},"credits_per_creative":{"type":"number"},"next_step":{"type":"string"},"runs":{"type":"array","items":{"type":"object","properties":{"subject":{"type":"string"},"product_id":{"type":"string"},"concepts":{"type":"number"}},"additionalProperties":false}},"error":{"type":"string"},"error_code":{"type":"string"},"credits_needed":{"description":"Credits required for the refused request.","type":"number"},"credits_short":{"description":"Credits missing for the refused request.","type":"number"},"credits_have":{"description":"Credits available when the request was refused.","type":"number"},"plan":{"description":"The account's current plan when access was refused.","type":"string"},"allowed_plans":{"description":"Plans supported by Ads Studio.","type":"array","items":{"type":"string"}},"limit":{"description":"The concurrent-generation limit when the queue was full.","type":"number"},"queued":{"description":"The queued generation count when the queue was full.","type":"number"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_delete_product","title":"Delete Ads Studio Product","description":"Delete one product after explicit confirmation in the details window. Requires the fresh, one-use widget token from ads_studio_prepare_delete. UUID-only calls never delete. Does not use chat or generate ads. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"product_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"confirmation_token":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$","description":"Fresh one-use token from the confirmation widget's prepare-delete response."}},"required":["product_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ads_studio_delete_product","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ads_studio_delete_product","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.scene_builder_3d_generate_angles","title":"3D Jutsu: generate angles","description":"Generate an AI image from a rendered 3D Jutsu scene using 3d_jutsu_angles (Seedream V5 Pro pricing). This spends credits. First render and inspect an image with scene_builder_3d_query_python and scene_builder_3d_get_artifact. Supply that operationId/artifactId; optionally include referenceMediaId for an accessible uploaded photo or uploaded first video frame alongside the scene render. The Runner records the immutable references and shared project history. The scene itself is unchanged. After submission, use scene_builder_3d_get_generation. If the response is lost, look up generationId=requestId or repeat exactly the same requestId and arguments, including the reference; never allocate a fresh ID just to retry. Use a new UUID only for an intentional additional generation. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"requestId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Stable UUID for this paid generation. Reuse it only with identical arguments after an uncertain response; a deliberate new generation needs a new UUID."},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","description":"Stable ID for this logical operation. Reuse only for an identical request, including code and guards."},"artifactId":{"type":"string","pattern":"^[a-f0-9]{32}$","description":"Published PNG/JPEG artifact from a successful Blender operation in this project. Render and inspect it first."},"prompt":{"type":"string","minLength":1,"maxLength":20000},"resolution":{"default":"2k","type":"string","enum":["1k","1.5k","2k"]},"referenceMediaId":{"description":"Confirmed uploaded image media ID to include alongside the rendered scene. For a video source, upload its first frame as an image. Keep this ID unchanged when reconciling the same request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"aspectRatio":{"default":"1:1","type":"string","enum":["1:1","4:3","3:4","16:9","9:16","3:2","2:3","21:9"]}},"required":["projectId","requestId","operationId","artifactId","prompt"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.scene_builder_3d_generate_angles","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_generate_angles","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean"},"generation":{"oneOf":[{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"generationSequence":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"actorId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"operationId":{"type":"string"},"artifactId":{"type":"string"},"prompt":{"type":"string"},"aspectRatio":{"type":"string"},"status":{"type":"string","enum":["submitting","running","succeeded","failed","submission_unknown"]},"jobs":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"type":"string"},"result_url":{"anyOf":[{"type":"string","format":"uri"},{"type":"null"}]}},"required":["id","status","result_url"],"additionalProperties":false}},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"jobSetType":{"type":"string","const":"3d_jutsu_angles"},"resolution":{"type":"string","enum":["1k","1.5k","2k"]},"referenceMediaId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["id","projectId","generationSequence","actorId","revision","sceneSequence","operationId","artifactId","prompt","aspectRatio","status","jobs","createdAt","updatedAt","jobSetType","resolution"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"generationSequence":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"actorId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"artifactId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"prompt":{"type":"string","minLength":1,"maxLength":60000},"aspectRatio":{"type":"string"},"status":{"type":"string","enum":["submitting","running","succeeded","failed","submission_unknown"]},"jobs":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"type":"string"},"result_url":{"anyOf":[{"type":"string","format":"uri"},{"type":"null"}]}},"required":["id","status","result_url"],"additionalProperties":false}},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"resolution":{"type":"string","enum":["480p","720p","1080p"]},"duration":{"type":"integer","minimum":4,"maximum":30},"generateAudio":{"type":"boolean"},"mode":{"type":"string","enum":["t2v","omni_reference","video_edit","video_extension"]},"medias":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"role":{"type":"string","enum":["image","start_image","end_image","video","audio"]},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9_]+$"}},"required":["id","type"],"additionalProperties":false}},"required":["role","data"],"additionalProperties":false}},"bitrateMode":{"type":"string","enum":["standard","high"]},"extensionMode":{"type":"string","enum":["backward","forward"]},"draft":{"type":"boolean"},"draftJobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"jobSetType":{"type":"string","const":"seedance_2_5"}},"required":["id","projectId","generationSequence","actorId","revision","sceneSequence","prompt","aspectRatio","status","jobs","createdAt","updatedAt","resolution","duration","generateAudio","jobSetType"],"additionalProperties":false}]},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"terminal":{"type":"boolean"},"nextTool":{"type":"string","const":"scene_builder_3d_get_generation"},"nextArguments":{"type":"object","properties":{"projectId":{"type":"string"},"generationId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["projectId","generationId"],"additionalProperties":false}},"required":["ok","generation","projectUrl","terminal"],"additionalProperties":false}},{"name":"higgsfield.video_analysis_status","title":"Video Analysis Status","description":"Get the status and result of a video analysis. Poll this after video_analysis_create until status='completed' (scenes populated) or 'failed' (fail_reason populated). Analyses typically finish in 3-5 minutes — poll accordingly every 30-60 seconds. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"video_analyze_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"UUID returned by video_analysis_create or video_analysis_jobs."}},"required":["video_analyze_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.video_analysis_status","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/video_analysis_status","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"result":{"type":"object","properties":{"id":{"type":"string"},"video_input_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"youtube_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string","enum":["queued","in_progress","completed","failed"]},"fail_reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"video_s3_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"scenes":{"anyOf":[{"type":"array","items":{}},{"type":"null"}]}},"required":["id","video_input_id","youtube_url","status","fail_reason","video_s3_url","scenes"],"additionalProperties":false}},"required":["result"],"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_search_assets","title":"3D Jutsu: search assets","description":"Search the curated GLB model catalog available to 3D Jutsu. This read is authorized\nagainst `projectId`; the catalog itself is shared. Pass a returned `assetId` to\n`scene_builder_3d_import_asset` for the same selected project. Search results are available\nmodels, not objects already present in the scene. Inspect existing scene objects with\n`scene_builder_3d_query_python` before deciding what to add. Never invent an asset ID or turn\na catalog URL into Python download code. Copy the returned importArguments, including catalogSearch, into scene_builder_3d_import_asset. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"search":{"default":"","type":"string","maxLength":128},"limit":{"default":100,"type":"integer","minimum":1,"maximum":100}},"required":["projectId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_search_assets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_search_assets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."},"total":{"type":"integer","minimum":0,"maximum":9007199254740991},"assets":{"type":"array","items":{"type":"object","properties":{"assetId":{"type":"string"},"name":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"importArguments":{"type":"object","properties":{"projectId":{"type":"string"},"assetId":{"type":"string"},"catalogSearch":{"type":"string"}},"required":["projectId","assetId"],"additionalProperties":false}},"required":["assetId","name","tags","importArguments"],"additionalProperties":false}}},"required":["ok","projectUrl","total","assets"],"additionalProperties":false}},{"name":"higgsfield.list_projects","title":"List Projects","description":"List or find existing accessible Higgsfield media projects before choosing a generation destination. Returns project_id, default_folder_id and each project's actual workspace_id. Includes accessible shared projects across workspaces; workspace_id sets authenticated request context, not a filter. Does not list websites, 3D scenes or local directories and never creates a project. Read one page at a time; pass cursor with the same workspace and search to continue. An empty page with has_more=true is not the end. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Authenticated workspace context from workspace discovery. Keep unchanged when paging; accessible shared projects may belong to other workspaces."},"search":{"description":"Case-insensitive project name search.","type":"string","maxLength":100},"size":{"description":"Page size, default 20; maximum 50.","type":"integer","minimum":1,"maximum":50},"cursor":{"description":"Opaque cursor from the previous response. Retain the original workspace and filters.","type":"string","maxLength":1024}},"required":["workspace_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.list_projects","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_projects","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"has_more":{"type":"boolean"},"cursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"error":{"type":"string"},"items":{"type":"array","items":{"type":"object","properties":{"project_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"default_folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"workspace_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"},"color":{"anyOf":[{"type":"string"},{"type":"null"}]},"preview_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"recent_jobs":{"maxItems":4,"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"media_type":{"type":"string","enum":["image","video"]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"thumbnail_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"width":{"anyOf":[{"type":"number"},{"type":"null"}]},"height":{"anyOf":[{"type":"number"},{"type":"null"}]}},"required":["id","media_type","url","thumbnail_url","width","height"],"additionalProperties":false}}},"required":["project_id","default_folder_id","workspace_id","name","preview_url","recent_jobs"],"additionalProperties":false}}},"additionalProperties":false}},{"name":"higgsfield.generate_image","title":"Generate Image","description":"Generate an image. A successful submission returns job IDs; a choice or rejected request submits no job. For credit preflight use `estimate_image_cost` first; HTTPS image references are imported into your media library. Call this directly as the first tool call of the turn with the default model `gpt_image_2_5` for ordinary generation, photorealistic images, typography, and reference-based editing. Consult `models_recommend`, `models_search`, `models_list`, or `models_get` only when the user asks to pick or compare models, or you need `aspect_ratios`, `parameters`, or `medias[].roles` for reference inputs. Reference media can be uploaded media UUIDs from `media_upload_and_confirm`, completed generation job UUIDs, or authorized HTTPS image URLs such as user-provided file download URLs; the server imports HTTPS images into Higgsfield and confirms them automatically. For character/avatar requests use image generation directly; there is no reusable character-training flow here. All arguments go inside the single `params` object — `params.model` is required, `params.prompt` holds the text description, and model-specific parameters are additional keys of `params`. Server returns `adjustments` for fallbacks; invalid declared-param values return a structured error. This tool already displays its submitted jobs in an auto-updating generation widget, including while pending or in progress. Do not follow it with job_display, show_generations, or show_generation_by_ids merely to show or refresh the same results, before or after completion. To await completion, use jobs_wait with timeout_seconds <= 15; it does not open another widget. Use a separate display only when the user explicitly requests one or the workflow requires a distinct preview or approval. Headless generate_*_batch and execute_preset workflows follow their own display instructions. On a transport timeout the submission outcome may be unknown: do not automatically resubmit. Reuse returned job IDs and retry only after the original outcome is known. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"model":{"type":"string","description":"Model ID from the model catalog (required)."},"prompt":{"description":"Text description of what to generate.","type":"string"},"count":{"default":1,"description":"Number of results (1-4). Ignored with use_unlim: an unlim request is always one generation — count is capped to 1 and the cap comes back in adjustments. Send separate calls for more.","type":"integer","minimum":1,"maximum":4},"aspect_ratio":{"description":"Output aspect ratio: 'auto' or positive width:height, for example '1:1', '9:16', or '16:9'. Omit for the selected model's default. Use models_get to inspect that model's supported values; the server coerces unsupported well-formed ratios when a safe model fallback exists.","type":"string","pattern":"^(?:auto|[1-9]\\d*:[1-9]\\d*)$"},"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"}},"required":["model"],"additionalProperties":{}},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["params"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-v2.html","ui":{"resourceUri":"ui://higgsfield/generation-v2.html"},"resource_name":"higgsfield.generate_image","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_image","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"error":{"type":"string"},"warning":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"avatar_auto_picked":{"description":"Set when the server auto-picked an avatar because product_ids were passed without avatars/avatar_ids (Marketing Studio video).","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string","enum":["preset","custom"]}},"required":["id","type"],"additionalProperties":false},"next_step":{"description":"Suggested follow-up tool call (e.g. show_marketing_studio fetch) attached to some marketing error results.","type":"object","properties":{"tool":{"type":"string"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["tool","params"],"additionalProperties":false},"unlim_choice":{"description":"NO JOB WAS SUBMITTED. The caller has free unlimited generations that cover this model, and nobody has said whether to spend them. Ask the user, then call the same tool again with use_unlim: true (free) or use_unlim: false (credits). Do not pick for them.","type":"object","properties":{"message":{"type":"string","description":"The question to put to the user, verbatim."},"model":{"type":"string","description":"Model the choice applies to."},"remaining":{"description":"Unlimited generations left; null means unmetered.","anyOf":[{"type":"number"},{"type":"null"}]},"expires_at":{"description":"ISO timestamp when the allowance lapses.","anyOf":[{"type":"string"},{"type":"null"}]}},"required":["message","model"],"additionalProperties":false},"brand_kit_status":{"description":"Live brand kit status when a generation was rejected because the kit is not ready yet.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.list_workspaces","title":"List Workspaces","description":"Read-only list of every workspace the user can access. The `is_selected` field marks which workspace MCP operations currently target. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.list_workspaces","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/list_workspaces","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"workspaces":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Workspace UUID"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Workspace name (null for private)"},"type":{"type":"string","enum":["private","shared"],"description":"Workspace type"},"user_role":{"type":"string","enum":["owner","member"],"description":"Caller's role in this workspace"},"is_selected":{"type":"boolean","description":"True if this is the currently selected workspace for MCP operations"},"plan_type":{"type":"string","description":"Subscription plan for this workspace (e.g., free, pro, team)"},"credits":{"type":"number","description":"Available credits in this workspace"}},"required":["id","name","type","user_role","is_selected","plan_type","credits"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_get_project","title":"3D Jutsu: get project","description":"Read a 3D Jutsu project's current revision, scene sequence, active operation, and\ncommitted artifacts. Obtain `projectId` from `scene_builder_3d_list_projects`, `scene_builder_3d_create_project`, or an explicit user\nselection. An authorized project with `exists: false` is a valid empty scene at revision 0.\nUse `scene_builder_3d_query_python` to inspect actual objects, dimensions, materials, cameras,\nand lights before editing. If an operation is active, use `scene_builder_3d_get_operation` to\nsettle it before another mutation. Scene edits use `scene_builder_3d_run_python` with the exact\nrevision and scene sequence inspected; never guess these guards.\n\nBefore building or editing a scene, load get_preset_instructions with { preset: \"/3d-jutsu\" } once for the full workflow, runtime limits and scene-building references. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."}},"required":["projectId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_get_project","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_project","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"exists":{"type":"boolean"},"project":{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"sceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"appliedSceneSequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"activeOperationId":{"anyOf":[{"type":"string"},{"type":"null"}]},"artifacts":{"anyOf":[{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"blend":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"glb":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"}},"required":["size","etag"],"additionalProperties":false},"generated":{"type":"array","items":{"type":"object","properties":{"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["size","etag","id","name","mediaType","width","height"],"additionalProperties":false}}},"required":["projectId","revision","blend","glb","generated"],"additionalProperties":false},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["projectId","revision","sceneSequence","appliedSceneSequence","activeOperationId","artifacts"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","exists","project","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.job_display","title":"Display Result","description":"Show one specific previous generation in a new single-result UI widget by job ID. This opens an additional widget; it does not refresh an existing one. Ordinary generate_image, generate_video, and generate_audio calls already display auto-updating widgets. Do not call this tool as their automatic follow-up, even while pending or in progress or after completion; use jobs_wait with timeout_seconds <= 15 to await completion without another widget. Use when the user wants to inspect or re-display that individual result, including workflows that require separate approval of named candidates or individual previews before finalization. Do not call job_display once per job merely to reproduce an ordinary completed batch; use one show_generation_by_ids call for ordinary batch results instead. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Job ID to display; use item_id from list_project_assets"},"folder_id":{"description":"Folder context from list_project_assets; include it when inspecting a job from a shared folder.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-v2.html","ui":{"resourceUri":"ui://higgsfield/generation-v2.html"},"resource_name":"higgsfield.job_display","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/job_display","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.workspace_clear_selection","title":"Clear Workspace Selection","description":"Clear the active workspace selection so subsequent MCP operations use the user's default private workspace. This changes selection only; it does not delete any workspace. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.workspace_clear_selection","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/workspace_clear_selection","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"success":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.get_presets","title":"Browse Media Presets","icons":[{"src":"https://files.openai.com/content?id=file_00000000bef48230b2e1460fa9919190&cdn=1&cp=pi&ma=30585600&ts=0&p=pi&cid=11&sig=c89c0a8996d0483156d3ef41e4d0b69aaa51a4c7c6eb668c3b9a68db511e1d39&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"light"},{"src":"https://files.openai.com/content?id=file_0000000085f881f5abddb2561787bd9a&cdn=1&cp=pi&ma=32659200&ts=0&p=pi&cid=11&sig=ea90e77f50d17f209950698f70b7c458c0f6484c7a087bb4c58b10ac2a5d22c4&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"dark"}],"description":"Search and browse reusable image and video generation presets from Higgsfield's Viral, Marketing Studio, Genjutsu and Katana galleries, or retrieve a preset's inputs and preview without starting a generation. For sources other than Katana: A bare preset slash command or a request to open, preview, or browse a preset only opens its widget. For supplied attachments, use input_schema from get_preset_instructions to map and upload the relevant files before opening any widget. Call get_presets exactly once with source, preset_id and initial_inputs in the exact schema fields. Do not call get_presets just to inspect the schema. Leave omitted settings to schema defaults; never reopen the detail merely to repeat default selections. Never assume one photo satisfies all requirements or guess ambiguous slot assignments. Leave missing fields in the prefilled widget for the user. Stop after opening the detail and let the user interact with it. Do not call execute_preset unless the user explicitly asks to generate, or submits with Recreate in the widget. Check execution.readiness for the supplied inputs before execution; collect missing or invalid fields instead of submitting. execution.available indicates capability, not permission; optional inputs and built-in media do not authorize generation. Readiness checks input structure, not media ownership or upload confirmation; use only confirmed media IDs. If the widget reports submitted job IDs, display and wait for those jobs without executing again. For sources other than Katana, pass query to search preset names, descriptions and types before pagination. All query words must match; omit source to search Viral and Marketing Studio. Pass preset_id to open a published preset detail preview directly. Omit source to browse Viral and Marketing Studio; limit applies to the complete page. source='genjutsu' lists Genjutsu motion presets, with category='genjutsu', 'genjutsu-trending' or 'genjutsu-new'; a bare /genjutsu opens this gallery. To choose motion for an existing AI Influencer, pass initial_inputs:{character_sheet:[{id:\"<confirmed sheet job UUID>\",type:\"image_job\"}]} — character_sheet must be a one-item array, not a single object; legacy source='marketing_studio' still accepts these categories and genjutsu: IDs. source='viral' lists Viral Hub chain presets for /effects requests; source='marketing_studio' lists Marketing Studio templates: for /product use category='product-shot', for /motion use category='motion'. source='katana' is a user-facing catalog, not headless search: query and initial_inputs are unsupported. preset_id:'<slug>' opens one Katana preset's input form directly; use it only as the loaded /katana/slug instructions direct, when the user asked to run that preset and its inputs are missing. To find or choose a Katana preset for a task, call get_preset_instructions with preset omitted, match the returned titles/descriptions, then load its exact /katana/slug. Do not open this gallery merely to choose a preset for supplied media. Explicit catalog browsing opens the Katana catalog without default filters; category supports aura_farming, motion and clipping, katana_source supports community or higgsfield. Katana uses opaque string cursors and backend-default page sizes (explicit limit maximum 20). Recreate selections resolve exact /katana/slug instructions with get_preset_instructions. Katana browsing does not execute a preset. Use category slugs returned by this tool and pass next_cursor only when the user asks for another page. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"initial_inputs":{"description":"Prefill a selected preset using execution.input_schema. Use confirmed media UUIDs in the correct slots, never local paths. Partial inputs are allowed; inspect execution.readiness. Requires preset_id, except category=genjutsu, genjutsu-trending or genjutsu-new accepts character_sheet to prefill the motion gallery. For Genjutsu use character_sheet:[{id:<confirmed UUID>,type:image_job}] for an existing character sheet, or type:media_input for an uploaded image. The field is always a one-item array, never a single object. Does not submit.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"source":{"description":"Gallery source. Omit for the combined feed.","type":"string","enum":["viral","marketing_studio","genjutsu","katana"]},"katana_source":{"description":"Katana catalog filter. Only valid with source=katana.","type":"string","enum":["higgsfield","community"]},"preset_id":{"description":"Published preset ID (or its catalog slug / exact name) to open directly in the detail preview. Source is optional if the ID is unique. Use category='all' and omit cursor (or pass 0) for a detail lookup.","type":"string","minLength":1,"maxLength":120},"category":{"description":"Category slug. Optional for Katana, which defaults to the Community source; defaults to 'all' for other galleries. Other categories require source.","type":"string","minLength":1},"query":{"description":"Not supported for source=katana; use get_preset_instructions with preset omitted for Katana discovery. Search original CMS names, descriptions and preset types. Case-insensitive; words may match different fields. Empty means browse. Cannot be combined with preset_id.","type":"string","maxLength":200},"cursor":{"description":"Pass next_cursor with the same filters. Katana uses an opaque string cursor; other galleries use numeric offsets. Omit when changing filters.","anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"string","minLength":1,"maxLength":2048}]},"limit":{"description":"Number of presets across the complete page, 1–50. Defaults to 12; Katana defaults to 4 and allows 1–20.","type":"integer","minimum":1,"maximum":50}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/viral.html","ui":{"visibility":["model","app"],"resourceUri":"ui://higgsfield/viral.html"},"resource_name":"higgsfield.get_presets","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_presets","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"source":{"type":"string","enum":["viral","marketing_studio","all"]},"category":{"type":"string"},"categories":{"type":"array","items":{"type":"object","properties":{"slug":{"type":"string"},"name":{"type":"string"}},"required":["slug","name"],"additionalProperties":false}},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"kind":{"type":"string"},"type":{"type":"string"},"thumbnail_url":{"type":"string"},"preview_url":{"type":"string"},"preview_type":{"type":"string","enum":["image","video"]}},"required":["id","name"],"additionalProperties":false}},"next_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"total":{"type":"number"},"sections":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","enum":["viral","marketing_studio"]},"category":{"type":"string"},"categories":{"type":"array","items":{"type":"object","properties":{"slug":{"type":"string"},"name":{"type":"string"}},"required":["slug","name"],"additionalProperties":false}},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"kind":{"type":"string"},"type":{"type":"string"},"thumbnail_url":{"type":"string"},"preview_url":{"type":"string"},"preview_type":{"type":"string","enum":["image","video"]}},"required":["id","name"],"additionalProperties":false}},"next_cursor":{"anyOf":[{"type":"number"},{"type":"null"}]},"total":{"type":"number"}},"required":["source","category","categories","items","next_cursor","total"],"additionalProperties":false}},"selected_preset":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"kind":{"type":"string"},"type":{"type":"string"},"thumbnail_url":{"type":"string"},"preview_url":{"type":"string"},"preview_type":{"type":"string","enum":["image","video"]}},"required":["id","name"],"additionalProperties":false},"execution":{"type":"object","properties":{"available":{"type":"boolean"},"tool":{"type":"string","const":"execute_preset"},"reason":{"type":"string"},"input_schema":{"description":"JSON Schema defining per-preset execution inputs. Availability is reported separately.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["available","tool"],"additionalProperties":false},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.media_upload","title":"Upload Media","description":"Upload media for use in generation, or general files (documents, archives, code) for sharing. Returns presigned URLs for clients that can upload bytes themselves; run the generated curl commands or PUT the bytes to each upload_url, then call media_confirm. The media type is inferred from the filename extension: image/video/audio extensions become generation inputs; other whitelisted extensions (pdf, zip, tar, docx, csv, code files, …) are uploaded as general files and return a permanent URL, but cannot be used as generation inputs. General files are the agent's own upload path — the widget does not accept them, so upload the bytes to upload_url yourself (e.g. from a code execution environment). Supports batch uploads via files[]. OpenAI routing: use this only for files created inside sandbox_exec. Call media_upload BEFORE the sandbox command that creates the file, then append `curl -f -X PUT --upload-file <sandbox-path> '<upload_url>'` to that SAME command so the ephemeral file is uploaded before it exits; call media_confirm only after HTTP 200. For a user-provided ChatGPT attachment call media_upload_and_confirm instead. Never pass a sandbox path to media_upload_and_confirm. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"surface":{"description":"Optional image/video library surface. Use 3d_justu only for that page; omit elsewhere to keep the existing mcp default.","type":"string","enum":["mcp","3d_justu"]},"method":{"description":"Only supported method. Omit this or set it to 'upload_url'.","type":"string","const":"upload_url"},"filename":{"description":"Single filename for upload","type":"string"},"files":{"description":"1–20 files for parallel presigned URL generation","minItems":1,"maxItems":20,"type":"array","items":{"type":"object","properties":{"filename":{"type":"string","description":"Filename for the upload"},"content_type":{"description":"MIME type, e.g. 'image/jpeg' or 'video/mp4'. Inferred from filename when omitted.","type":"string"}},"required":["filename"]}},"content_type":{"description":"MIME type for single file upload, e.g. 'image/jpeg', 'image/png', or 'video/mp4'. Inferred from filename when omitted.","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.media_upload","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/media_upload","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"uploads":{"description":"Presigned upload URLs. Run the curl command, then call media_confirm.","type":"array","items":{"type":"object","properties":{"upload_url":{"type":"string"},"media_id":{"type":"string"},"url":{"description":"Backend media URL when available. Pass this to tools that need to render the uploaded media immediately.","type":"string"},"expires_in_seconds":{"type":"number"},"method":{"type":"string"},"content_type":{"type":"string"},"instructions":{"type":"string"}},"required":["upload_url","media_id","expires_in_seconds","method","content_type","instructions"],"additionalProperties":false}},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.website_repo_access","title":"Website Repository","description":"Prepare a credential-free checkout in sandbox_exec (operation checkout), or push committed changes (operation push). Use the returned checkout_path to edit and commit with sandbox_exec; then call this tool with push before deploy_website. Each call reserves the user's sandbox for 15 minutes. Checkout reuses existing files; it never resets work. Push rejects uncommitted files and non-fast-forward updates. No Git credentials are returned or installed in the editing sandbox. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"website_id":{"type":"string","minLength":1},"operation":{"default":"checkout","type":"string","enum":["checkout","push"]}},"required":["website_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.website_repo_access","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/website_repo_access","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"checkout_path":{"type":"string"},"branch":{"type":"string"},"status":{"type":"string"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_upload_catalog_asset","title":"3D Jutsu: upload catalog asset","description":"Upload a confirmed catalog GLB into the authorized project's current settled revision. Widget-only. sha256 must match the bytes displayed by the editor. Returns only the uploaded scene asset ID, which the editor references in one object.create.from_glb operation through scene_builder_3d_apply_scene_operations. This does not create a scene object. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"assetId":{"type":"string","minLength":1,"maxLength":256},"catalogSearch":{"type":"string","maxLength":128},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["projectId","assetId","catalogSearch","sha256"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.scene_builder_3d_upload_catalog_asset","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_upload_catalog_asset","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"assetId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","projectId","assetId","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.scene_builder_3d_get_glb","title":"3D Jutsu: get glb","description":"For an interactive scene preview use `scene_builder_3d_show_scene`. Resolve a short-lived download for the current committed GLB, or a specified historical\nrevision. This retrieves an existing export; it does not run Blender, render, or create a new\nexport. Settle any active mutation with `scene_builder_3d_get_operation` first if you need its\nresult. Use GLB for portable scene delivery, and `scene_builder_3d_get_blend` for the editable\nBlender source. Procedural shading, world lighting, and some Blender features may differ in\nGLB. A successful download does not establish that the exported scene looks correct. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Project ID from scene_builder_3d_list_projects, scene_builder_3d_create_project, or the user's explicit selection. Required on every project-scoped tool."},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Exact committed revision inspected; do not guess."}},"required":["projectId"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.scene_builder_3d_get_glb","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/scene_builder_3d_get_glb","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"type":"boolean","const":true},"download":{"type":"object","properties":{"method":{"type":"string","enum":["GET","PUT"]},"url":{"type":"string","format":"uri"},"headers":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"expiresAt":{"type":"string"}},"required":["method","url","headers","expiresAt"],"additionalProperties":false},"artifact":{"type":"object","properties":{"projectId":{"type":"string"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"size":{"type":"integer","minimum":0,"maximum":9007199254740991},"etag":{"type":"string"},"type":{"type":"string","enum":["glb","blend"]},"id":{"type":"string"},"name":{"type":"string"},"mediaType":{"type":"string","enum":["image/png","image/jpeg","video/mp4"]},"operationId":{"type":"string"},"width":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}},"required":["projectId","revision","size","etag"],"additionalProperties":false},"projectUrl":{"type":"string","format":"uri","description":"Open this project in 3D Jutsu."}},"required":["ok","download","artifact","projectUrl"],"additionalProperties":false}},{"name":"higgsfield.models_get","title":"Get Model","description":"Read-only fetch of one generation model's constraints, parameters, media roles, aspect ratios, and durations. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"model_id":{"type":"string","description":"Model ID from models_list, models_search, or models_recommend."}},"required":["model_id"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"resource_name":"higgsfield.models_get","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/models_get","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"provider_name":{"type":"string"},"description":{"type":"string"},"output_type":{"type":"string","enum":["image","video","audio","3d"]},"parameters":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"required":{"type":"string","enum":["required","optional"]},"type":{"type":"string","enum":["string","number","bool","string_array"]},"description":{"type":"string"},"default":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"options":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"min":{"type":"number"},"max":{"type":"number"},"nullable":{"type":"boolean"},"format":{"description":"Format constraint for scalar string parameters, e.g. hex_color.","type":"string"},"pattern":{"description":"Regex source for scalar string parameters.","type":"string"},"item_format":{"description":"Format constraint for string_array items, e.g. hex_color.","type":"string"},"item_pattern":{"description":"Regex source for string_array items.","type":"string"}},"required":["name","required","type"],"additionalProperties":false}},"medias":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","const":"image"},"description":{"type":"string"},"max":{"type":"number"},"required":{"type":"boolean"},"roles":{"type":"array","items":{"type":"string"}}},"required":["name","type"],"additionalProperties":false}},"aspect_ratios":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"score":{"type":"number"},"match_reason":{"type":"string"},"durations":{"type":"array","items":{"type":"number"}},"duration_range":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false},"credits_per_unit":{"type":"number"},"credit_unit":{"type":"string","enum":["per_image","per_second"]},"supports_unlim":{"type":"boolean"},"supports_free_gens":{"type":"boolean"}},"required":["id","name","provider_name","description","output_type","parameters","medias","aspect_ratios"],"additionalProperties":false}},"next_page_token":{"type":"string"},"has_more":{"type":"boolean"},"free_gens":{"description":"Free generations the caller can spend right now, one entry per counter with the model ids that share it. Answer \"what free generations do I have\" from this; pass use_free_gens:true to generate_video for Higgsfield Genjutsu or execute_preset for Viral when the user asks to use one. For ai_influencer_sheet, prepare with ai_influencer_prepare, then use ai_influencer_generate with use_free_gens:true and max_credits:0, never generate_image.","type":"array","items":{"type":"object","properties":{"job_set_types":{"type":"array","items":{"type":"string"},"description":"Job-set types sharing this counter. viral_hub_video covers all Viral chain presets; one preset execution spends one attempt. ai_influencer_sheet is spent through ai_influencer_generate with use_free_gens:true or the AI Influencer Builder’s Use free gens toggle."},"remaining":{"type":"number","description":"Free generations left on the counter. 0 = granted and spent."},"parameters":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"number"}]}},"description":"Allowed values per request parameter for a free run; an absent parameter is uncapped."},"max_duration":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Upper bound in seconds for a free run, or null."}},"required":["job_set_types","remaining","parameters","max_duration"],"additionalProperties":false}},"related_tools":{"description":"Standalone tools (not catalog models) relevant to the recommend query — e.g. motion_control for recast/puppeteer, upscale_image/upscale_video for enhance, outpaint_image for expand/uncrop, reframe for a video aspect-ratio change, remove_background for cutout. Call the named tool directly; it will not appear in items.","type":"array","items":{"type":"object","properties":{"tool":{"type":"string"},"use_when":{"type":"string"}},"required":["tool","use_when"],"additionalProperties":false}},"error":{"type":"string"},"status":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ads_studio_save_brand","title":"Save Ads Studio Brand Kit","description":"Save user-edited brand kit fields from the app, or create a manual brand kit. Never researches or generates ads. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"brand_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"profile":{"type":"object","properties":{"brand-name":{"type":"string","minLength":1,"maxLength":200},"website":{"anyOf":[{"type":"string","maxLength":2000,"format":"uri"},{"type":"null"}]},"tagline":{"anyOf":[{"type":"string","maxLength":10000},{"type":"null"}]},"business-overview":{"anyOf":[{"type":"string","maxLength":10000},{"type":"null"}]},"brand-aesthetics":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":10000}},"brand-values":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":10000}},"key-selling-points":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":10000}},"target-audience":{"anyOf":[{"type":"string","maxLength":10000},{"type":"null"}]},"logo":{"anyOf":[{"type":"string","maxLength":2000,"format":"uri"},{"type":"null"}]},"competitors":{"maxItems":20,"type":"array","items":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"website":{"type":"string","maxLength":2000},"note":{"anyOf":[{"type":"string","maxLength":10000},{"type":"null"}]}},"required":["name","website","note"],"additionalProperties":false}},"tone-of-voice":{"anyOf":[{"type":"object","properties":{"summary":{"type":"string","maxLength":10000},"tags":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":10000}}},"required":["summary","tags"],"additionalProperties":false},{"type":"null"}]},"color-palette":{"maxItems":12,"type":"array","items":{"type":"object","properties":{"hex":{"type":"string","pattern":"^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"},"role":{"type":"string","enum":["primary","secondary","accent","background","text"]}},"required":["hex","role"],"additionalProperties":false}}},"additionalProperties":false}},"required":["profile"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ads_studio_save_brand","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc8191861