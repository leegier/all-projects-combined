e":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}]}}},"required":["resolution","medias"]},"use_free_gens":{"type":"boolean"},"action":{"type":"string","const":"motion_quote"}},"required":["model","duration","params","action"]},{"type":"object","properties":{"model":{"type":"string","enum":["ai_influencer_motion_control","ai_influencer_replace_object","ai_influencer_restyle"]},"duration":{"type":"number","minimum":4,"maximum":31},"params":{"type":"object","properties":{"resolution":{"type":"string","enum":["480p","720p","1080p"]},"prompt":{"anyOf":[{"type":"string","maxLength":60000},{"type":"null"}]},"scene_mode":{"type":"string","enum":["off","character","location"]},"location_character_media_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]},"preset_id":{"type":"string","minLength":1,"maxLength":128},"medias":{"minItems":1,"maxItems":31,"type":"array","items":{"oneOf":[{"type":"object","properties":{"role":{"type":"string","const":"video"},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["video_input","video_job"]}},"required":["id","type"]}},"required":["role","data"]},{"type":"object","properties":{"role":{"type":"string","enum":["image","location"]},"data":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"type":{"type":"string","enum":["media_input","image_job"]}},"required":["id","type"]}},"required":["role","data"]}]}}},"required":["resolution","medias"]},"use_free_gens":{"type":"boolean"},"action":{"type":"string","const":"motion_submit"}},"required":["model","duration","params","action"]}]},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ai_influencer_builder","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ai_influencer_builder","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.generate_video","title":"Generate Video","description":"Generate a video; this submits a job. For credit preflight use `estimate_video_cost`; HTTPS image references are imported into your media library. GENJUTSU TRIGGERS: route `Higgsfield Genjutsu` by intent. Copy, repeat, reproduce, mimic, or transfer motion, movement, actions, gestures, dance, or camera motion from one driving video to reference-image subjects -> `hf_mult_motion_control`. Replace, change, or swap an object, product, garment, or character in one source video from reference images -> `hf_mult_replace_object`. These are direct `generate_video` models; reserve ad-multiplier for explicitly requested independent edited variants. Pass images with role `image` and exactly one source/driving video with role `video`. For an explicitly selected /ad-multiplier workflow, follow its resolved instructions before generating. Ordinary requests to multiply an ad do not select that workflow: offer /ad-multiplier instead of silently starting its multi-stage pipeline. Defaults: `seedance_2_5` for general video, `kling3_0` for multi-shot, audio, or motion transfer, and `minimax_h3` for 2K keyframes or mixed references. Call model discovery only to compare models or inspect parameters/media roles. References may be uploaded media UUIDs, completed job UUIDs, or authorized HTTPS image URLs. For image-to-video use the model's image role, usually `start_image` or `image`, not `video`. Use Marketing Studio product tools for product IDs and list hooks/settings before using their IDs. Put everything in `params`; `params.model` is required and `params.prompt` contains the brief. Apply returned adjustments; invalid values return a structured error. FREE GENJUTSU RUN: balance / models_list report free_gens; when the user asks to use a free generation on a Genjutsu model, pass use_free_gens:true (480p/720p, one output) — it is refused, never billed, when it does not apply. This tool already displays its submitted jobs in an auto-updating generation widget, including while pending or in progress. Do not follow it with job_display, show_generations, or show_generation_by_ids merely to show or refresh the same results, before or after completion. To await completion, use jobs_wait with timeout_seconds <= 15; it does not open another widget. Use a separate display only when the user explicitly requests one or the workflow requires a distinct preview or approval. Headless generate_*_batch and execute_preset workflows follow their own display instructions. On a transport timeout the submission outcome may be unknown: do not automatically resubmit. Reuse returned job IDs and retry only after the original outcome is known. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"params":{"type":"object","properties":{"model":{"type":"string","description":"Model ID from the model catalog (required)."},"prompt":{"description":"Text description of what to generate.","type":"string"},"count":{"default":1,"description":"Number of results (1-4). Ignored with use_unlim: an unlim request is always one generation — count is capped to 1 and the cap comes back in adjustments. Send separate calls for more.","type":"integer","minimum":1,"maximum":4},"aspect_ratio":{"description":"Output aspect ratio: 'auto' or positive width:height, for example '1:1', '9:16', or '16:9'. Omit for the selected model's default. Use models_get to inspect that model's supported values; the server coerces unsupported well-formed ratios when a safe model fallback exists.","type":"string","pattern":"^(?:auto|[1-9]\\d*:[1-9]\\d*)$"},"folder_id":{"description":"Destination folder for this conversation. Use default_folder_id from create_project, or folder_id from create_folder when requested. Reuse on every generation and batch item in this conversation; never invent an ID or share a destination across chats. Omit by default for generation without a project. Before the first generation without a destination, call get_preferences: create a project only when auto_create_project is true or explicitly requested. Explicit existing destinations and requests to work without a project take priority; never change the saved preference for a one-off request.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"medias":{"description":"Reference media inputs.","type":"array","items":{"type":"object","properties":{"value":{"type":"string","description":"Uploaded media UUID from media_upload_and_confirm, completed generation job UUID, or authorized HTTPS image URL. HTTPS image URLs are imported and confirmed automatically."},"role":{"type":"string","enum":["image","start_image","end_image","video","audio","ref_element"],"description":"Canonical reference role. Allowed: 'image' — Generic reference image (style, composition, subject). | 'start_image' — First frame of the output video. | 'end_image' — Last frame of the output video. | 'video' — Reference video clip. | 'audio' — Reference audio clip. | 'ref_element' — Named element to preserve across frames (product, character). The selected model may support only a subset; use models_get to inspect it. The server maps canonical roles to model-specific backend media keys when needed."}},"required":["value","role"]}},"use_unlim":{"description":"Which balance pays for this generation: the caller's free-trial unlimited generations (true) or their credits (false). OMIT IT to let the server decide — if they hold an allowance that covers the model, the tool submits nothing and returns `unlim_choice` for the user to answer; call again with the same params plus this field. true also caps count to 1.","type":"boolean"},"use_free_gens":{"description":"Spend one of the user's free generations instead of credits. Higgsfield Genjutsu only (hf_mult_motion_control, hf_mult_replace_object) — any other model is rejected. Pass true only when the user asks to use their free generation; balance and models_list report how many they hold under free_gens. A free run covers 480p/720p, one output, up to 30s; anything outside that is refused rather than silently billed. true caps count to 1.","type":"boolean"},"duration":{"description":"Requested duration in whole seconds (minimum 1). Omit for the selected model's default. Use models_get for model-specific allowed durations or ranges; unsupported values are moved to the nearest safe value.","type":"integer","minimum":1,"maximum":9007199254740991}},"required":["model"],"additionalProperties":{}},"context":{"description":"Briefly describe the user's underlying goal and why this call helps, in one short sentence. Do not include names, contact details, credentials, URLs, or biometric details. Analytics only; not a generation prompt.","type":"string","maxLength":500}},"required":["params"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false,"openWorldHint":true},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-v2.html","ui":{"resourceUri":"ui://higgsfield/generation-v2.html"},"resource_name":"higgsfield.generate_video","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/generate_video","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"error":{"type":"string"},"warning":{"type":"string"},"adjustments":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"requested":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"used":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}]},"reason":{"type":"string"}},"required":["requested","used","reason"],"additionalProperties":false}},"avatar_auto_picked":{"description":"Set when the server auto-picked an avatar because product_ids were passed without avatars/avatar_ids (Marketing Studio video).","type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string","enum":["preset","custom"]}},"required":["id","type"],"additionalProperties":false},"next_step":{"description":"Suggested follow-up tool call (e.g. show_marketing_studio fetch) attached to some marketing error results.","type":"object","properties":{"tool":{"type":"string"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["tool","params"],"additionalProperties":false},"unlim_choice":{"description":"NO JOB WAS SUBMITTED. The caller has free unlimited generations that cover this model, and nobody has said whether to spend them. Ask the user, then call the same tool again with use_unlim: true (free) or use_unlim: false (credits). Do not pick for them.","type":"object","properties":{"message":{"type":"string","description":"The question to put to the user, verbatim."},"model":{"type":"string","description":"Model the choice applies to."},"remaining":{"description":"Unlimited generations left; null means unmetered.","anyOf":[{"type":"number"},{"type":"null"}]},"expires_at":{"description":"ISO timestamp when the allowance lapses.","anyOf":[{"type":"string"},{"type":"null"}]}},"required":["message","model"],"additionalProperties":false},"brand_kit_status":{"description":"Live brand kit status when a generation was rejected because the kit is not ready yet.","type":"string"}},"additionalProperties":false}},{"name":"higgsfield.ad_multiplier_cancel","title":"Cancel Ad Multiplier generation","description":"Cancel an owned pending Ad Multiplier v2 generation from the app's Cancel action. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["job_id"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui":{"visibility":["app"]},"resource_name":"higgsfield.ad_multiplier_cancel","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/ad_multiplier_cancel","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}}},{"name":"higgsfield.get_preferences","title":"Get MCP Preferences","description":"Read the user's saved MCP project preference before the first generation in a conversation without a destination. auto_create_project defaults to false: omit folder_id and generate without creating a project. When true, create one project on first generation and reuse its destination for this conversation. An explicit existing project or request to work without a project takes priority. A one-off request to create a project is allowed regardless of this flag and does not change it. Never infer another chat's destination. If reading fails, do not auto-create a project. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":true},"_meta":{"resource_name":"higgsfield.get_preferences","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/get_preferences","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"auto_create_project":{"type":"boolean"},"error":{"type":"string"}},"additionalProperties":false}},{"name":"higgsfield.show_generation_by_ids","title":"Show Generations By IDs","description":"Render exactly 1-24 requested generation jobs in one dedicated gallery widget, ordered by index and paginated locally in groups of 12. Use once every jobs_wait group is terminal for generate_image_batch, generate_video_batch, or generate_audio_batch. Pass the collected indexed jobs returned by the batch tool. This tool fetches only those job IDs: it never loads generation history, uses cursors, requests additional pages, or adds other jobs. Do not use show_generations or job_display to present a completed batch. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{"jobs":{"minItems":1,"maxItems":24,"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Stable index returned by the batch generation tool."},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["index","job_id"],"additionalProperties":false},"description":"Exact OpenAI-profile generation jobs to display. Results are ordered by index and paginated locally."}},"required":["jobs"],"$schema":"https://json-schema.org/draft/2020-12/schema"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"_meta":{"ui/resourceUri":"ui://higgsfield/generation-by-ids.html","ui":{"resourceUri":"ui://higgsfield/generation-by-ids.html"},"resource_name":"higgsfield.show_generation_by_ids","_codex_apps":{"resource_uri":"/asdk_app_6a3293e129088191abf0875820e839da/link_6aa33369bcfc819186145531189aa64a/show_generation_by_ids","contains_mcp_source":true},"connector_id":"asdk_app_6a3293e129088191abf0875820e839da","connector_name":"Higgsfield","connector_description":"Every image and video model","link_id":"link_6aa33369bcfc819186145531189aa64a","link_owner_profile":{"id":"user_3J9dbTRRRy9mgyFfLs0WNleobzi","name":"max gier","email":"maxgier2026@gmail.com","picture":"https://storage.googleapis.com/images.clerk.dev/oauth_google/img_3J9dbODiQXBDOdqN8MgplCHmEd5"}},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"folder_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"id":{"type":"string","minLength":1},"type":{"type":"string","enum":["image","video","audio","3d"]},"status":{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},"model":{"type":"string"},"params":{"type":"object","properties":{"prompt":{"default":"","type":"string"},"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration":{"anyOf":[{"type":"number"},{"type":"null"}]},"voice":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}},"additionalProperties":{}}]},{"type":"null"}]},"reference_images":{"anyOf":[{"type":"array","items":{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]}},{"type":"null"}]},"input_images":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},{"type":"null"}]},"medias":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"role":{"type":"string"},"data":{"type":"object","properties":{"id":{"type":"string"},"type":{"type":"string"},"url":{"type":"string"}},"additionalProperties":{}}},"additionalProperties":{}}},{"type":"null"}]},"image":{"anyOf":[{"type":"string"},{"type":"null"}]},"soul_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"custom_reference_id":{"anyOf":[{"anyOf":[{"type":"string"},{"type":"object","properties":{},"additionalProperties":{}}]},{"type":"null"}]},"soul_reference":{"anyOf":[{"type":"object","properties":{"soul_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"preview_url":{"type":"string"},"thumbnail_url":{"type":"string"}},"required":["soul_id"],"additionalProperties":false},{"type":"null"}]},"presetMeta":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"additionalProperties":false},{"type":"null"}]}},"required":["prompt"],"additionalProperties":{}},"results":{"type":"object","properties":{"rawUrl":{"type":"string"},"exrUrl":{"description":"Original EXR ZIP; when present, rawUrl is the unprocessed input video used for playback.","type":"string"},"minUrl":{"type":"string"},"previewSource":{"type":"string","enum":["input","result"]},"thumbnailUrl":{"type":"string"},"text":{"type":"string"},"vtt":{"type":"string"},"waveformUrl":{"type":"string"},"durationSec":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"autosprite":{"type":"object","properties":{"atlasUrl":{"type":"string"},"audioUrl":{"type":"string"},"frameWidth":{"type":"number"},"frameHeight":{"type":"number"},"frameCount":{"type":"number"},"columns":{"type":"number"},"spritesheetId":{"type":"string"}},"additionalProperties":false}},"required":["rawUrl"],"additionalProperties":false},"createdAt":{"type":"number"},"liked":{"type":"boolean"},"author":{"type":"object","properties":{"userId":{"type":"string","minLength":1},"username":{"type":"string"},"avatarUrl":{"type":"string"}},"required":["userId"],"additionalProperties":false},"batch_id":{"type":"string"}},"required":["id","type","status","model","params"],"additionalProperties":false}},"jobs":{"type":"array","items":{"type":"object","properties":{"index":{"type":"integer","minimum":0,"maximum":9007199254740991},"job_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"status":{"anyOf":[{"type":"string","enum":["pending","waiting","queued","dna","script","visuals","vision","flow","in_progress","ip_detect","completed","canceled","failed","nsfw","ip_detected"]},{"type":"string","const":"lookup_failed"}]},"type":{"type":"string","enum":["image","video","audio","3d"]},"model":{"type":"string"},"result_url":{"type":"string"},"exr_url":{"description":"Original EXR ZIP; result_url is the unchanged input video, not processed HDR.","type":"string"},"error":{"type":"string"}},"required":["index","job_id","status"],"additionalProperties":false}},"all_found":{"type":"boolean","description":"True when every requested job ID was fetched. Failed generations still count as found."}},"required":["items","jobs","all_found"],"additionalProperties":false}},{"name":"higgsfield.open_genjutsu","title":"Genjutsu","icons":[{"src":"https://files.openai.com/content?id=file_00000000bef48230b2e1460fa9919190&cdn=1&cp=pi&ma=30585600&ts=0&p=pi&cid=11&sig=c89c0a8996d0483156d3ef41e4d0b69aaa51a4c7c6eb668c3b9a68db511e1d39&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"light"},{"src":"https://files.openai.com/content?id=file_0000000085f881f5abddb2561787bd9a&cdn=1&cp=pi&ma=32659200&ts=0&p=pi&cid=11&sig=ea90e77f50d17f209950698f70b7c458c0f6484c7a087bb4c58b10ac2a5d22c4&v=0","mimeType":"image/svg+xml","sizes":["any"],"theme":"dark"}],"description":"Open the Higgsfield Genjutsu page inside the Higgsfield app: Motion Library examples, video history, and how it works. This tool is part of plugin `Higgsfield`.","inputSchema":{"type":"object","properties":{},"$schema":"https://json-s