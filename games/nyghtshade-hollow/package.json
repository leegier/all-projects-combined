{
  "name": "nyghtshade-hollow-the-intake",
  "version": "0.2.0",
  "description": "Nyghtshade Hollow \u2014 The Intake: playable vertical slice (WebGL / Three.js)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --no-min",
    "serve": "node tools/serve.mjs",
    "test": "node tests/unit.mjs && node tests/run-tests.mjs all && node tests/integration.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:bot": "node tests/run-tests.mjs all",
    "test:integration": "node tests/integration.mjs",
    "capture": "node tools/capture.mjs",
    "video": "bash tools/make-video.sh",
    "look": "node tools/look.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.50.0"
  }
}
