Operation 1: Optimize the 11k Mesh Cluster (Python)
With 11,269 objects and only 16GB of RAM, your editor will crash without Nanite. This script iterates through your prefab folder and automatically enables Nanite and builds the data for every mesh in the allpre.fbx library.

Instructions: Run this in the Unreal Python Terminal.

Python
import unreal

# PATH TO YOUR PREFABS
PREFAB_PATH = "/Game/Assets/PrisonSet/Prefabs/"

def optimize_for_braxtig():
    # Get all static meshes in the folder
    asset_registry = unreal.AssetRegistryHelpers.get_asset_registry()
    asset_data_list = asset_registry.get_assets_by_path(PREFAB_PATH, recursive=True)
    
    optimized_count = 0
    
    for asset_data in asset_data_list:
        asset = asset_data.get_asset()
        if isinstance(asset, unreal.StaticMesh):
            # 1. Enable Nanite (CRITICAL for 16GB RAM systems)
            asset.set_editor_property("nanite_settings", unreal.MeshNaniteSettings(enabled=True))
            
            # 2. Configure for Lumen (Distance Fields)
            asset.set_editor_property("generate_mesh_distance_field", True)
            
            # 3. Save changes
            unreal.EditorAssetLibrary.save_asset(asset.get_path_name())
            optimized_count += 1
            
    unreal.log(f"BraxtigConfig: {optimized_count} meshes converted to Nanite. System Stable.")

optimize_for_braxtig()
