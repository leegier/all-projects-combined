    {"PrisonElectricalPanel_2", 100.0f}, // Instant Lockdown
    {"HospitalLamp", 15.0f},            // Minor Suspicion
    {"CanteenTableSet", 5.0f}           // Social Heat
};

void UBraxtigInfractionSystem::CheckProximityInfraction(AActor* PlayerActor, FString AssetName) {
    if (InfractionMap.Contains(AssetName)) {
        float HeatToApply = InfractionMap[AssetName];
        
        // If caught at Panel 2 (49.99, 237.39, 784.90)
        if (HeatToApply >= 100.0f) {
            TriggerLockdown(PlayerActor->GetActorLocation());
        } else {
            BraxtigSubsystem->AddHeat(HeatToApply);
        }
    }
}
