Write-Host "BraxtigConfig: Syncing Nyghtshade Hollow to GitHub..." -ForegroundColor Cyan

git add .
git commit -m "BraxtigConfig Update: Post-Process Visor and SpinFan Logic Initialized [UE 5.3.2]"
git push origin main

Write-Host "SUCCESS: Project safely backed up." -ForegroundColor Green
