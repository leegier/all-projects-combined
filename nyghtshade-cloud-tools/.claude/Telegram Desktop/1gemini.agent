The Nyghtshade Hollow protocol is entering its operational phase. I am deploying the specialized C++ controllers and AI logic required for the "Nightshade" stealth and Warden perception systems, followed by the final repository sync script.

1. The "Nightshade" PlayerController (C++ / UE 5.3.2)
This controller manages the player's physical footprint in the world. It dynamically calculates movement speed and noise levels based on your visor's "Mjolnir Gaze" state and the local lighting conditions (Lumen integration).

C++
// NightshadePlayerController.cpp
#include "NightshadePlayerController.h"
#include "GameFramework/CharacterMovementComponent.h"

void ANightshadePlayerController::Tick(float DeltaTime) {
    Super::Tick(DeltaTime);

    // 1. Calculate Light Exposure (Lumen Integration)
    float CurrentLightLevel = GetLocalLightingIntensity();
    
    // 2. Nightshade Stealth Logic: Faster in shadows, silent during Fan RPM spikes
    if (bIsMjolnirGazeActive) {
        // Slow down for precision scanning (Gaze Mode)
        GetCharacter()->GetCharacterMovement()->MaxWalkSpeed = 300.0f;
        SetPostProcessIntensity(1.0f); // Activate Purple/Green HLSL
    } else {
        // Shadow Stealth: If in darkness (< 0.1 lux), noise is reduced by 50%
        float NoiseModifier = (CurrentLightLevel < 0.1f) ? 0.5f : 1.0f;
        ReportNoiseEvent(GetCharacter()->GetActorLocation(), 1.0f * NoiseModifier);
    }
}
2. Warden Arianna Gier: "The Gaze" Perception (C++ / AI)
This logic defines how the Warden perceives the world. Unlike standard guards, her "Gaze" can detect the player's Heat Signature through certain meshes if the player's Heat level is above 70%.

C++
// WardenAIController.cpp
#include "Perception/AIPerceptionComponent.h"
#include "Perception/AISense_Sight.h"

void AWardenAIController::ConfigureGazePerception() {
    UAIPerceptionComponent* GazePerception = GetPerceptionComponent();
    FAISenseConfig_Sight* SightConfig = CreateDefaultSubobject<FAISenseConfig_Sight>(TEXT("GazeSight"));

    // The Warden's "Gaze" range matches the Sector 1 Overlook dimensions
    SightConfig->SightRadius = 5000.0f; 
    SightConfig->LoseSightRadius = 5500.0f;
    SightConfig->PeripheralVisionAngleDegrees = 120.0f; // Wide-angle security

    GazePerception->ConfigureSense(*SightConfig);
}

void AWardenAIController::OnTargetDetected(AActor* Actor, FAIStimulus Stimulus) {
    if (Actor->ActorHasTag("Player")) {
        float PlayerHeat = UBraxtigSubsystem::Get()->GetHeatValue();
        
        // The "Gaze" Mechanic: Detect high-heat players even if partially occluded
        if (PlayerHeat > 70.0f || Stimulus.WasSuccessfullySensed()) {
            SetAlertState(EAlertState::Lockdown);
            TriggerSpinFans(4.0f); // Max RPM at coords (400, 283, 204)
        }
    }
}
