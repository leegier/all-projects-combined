Python
import unreal

# Define the Cinematic keyframes based on your coordinates
shots = [
    {"name": "Kitchen_Drip", "pos": [3695, -5, 813], "rot": [0, 0, 0]},
    {"name": "Street_Flicker", "pos": [853, -339, 2478], "rot": [0, -90, 0]},
    {"name": "Security_Scan", "pos": [398, 21, 710], "rot": [0, 45, 0]},
    {"name": "Warden_Overlook", "pos": [0, 130, 155], "rot": [-20, 0, 0]}
]

def generate_braxtig_trailer():
    # Create the Sequence
    sequence_path = "/Game/Cinematics/Nyghtshade_Trailer"
    level_sequence = unreal.AssetToolsHelpers.get_asset_tools().create_asset("Nyghtshade_Trailer", "/Game/Cinematics/", unreal.LevelSequence, unreal.LevelSequenceFactoryNew())
    
    for shot in shots:
        loc = unreal.Vector(shot["pos"][0], shot["pos"][1], shot["pos"][2])
        rot = unreal.Rotator(shot["rot"][0], shot["rot"][1], shot["rot"][2])
        
        # Spawn Camera
        cam = unreal.EditorLevelLibrary.spawn_actor_from_class(unreal.CineCameraActor, loc, rot)
        cam.set_actor_label(f"Shot_{shot['name']}")
        
    unreal.log("BraxtigConfig: Cinematic Sequence Initialized at identified coordinates.")

generate_braxtig_trailer()
