1. Spawn the Prefabs (UE 5.7 Automation Script)
Because you have over 11,000 objects in pickels.blend, manual placement is impossible. This Python script for the Unreal Editor reads your coordinate list and spawns the correct meshes from your allpre.fbx library.

How to run: Paste this into the Unreal Python Terminal (Window -> Python Terminal).

Python
import unreal

# PATH SETTINGS
COORD_FILE = r"C:\Users\FRANK\Desktop\scene_assets_detail.txt"
PREFAB_PATH = "/Game/Assets/PrisonSet/Prefabs/" # Change to your actual content folder

def spawn_prison_assets():
    with open(COORD_FILE, 'r') as f:
        data = f.read()

    # Split into object blocks
    blocks = data.split("----------------------------------------")
    
    for block in blocks:
        if "NAME:" not in block: continue
        
        # Parse data lines
        lines = block.strip().split('\n')
        name = lines[0].split(': ')[1]
        pos_raw = lines[3].split(': ')[1].split(', ')
        rot_raw = lines[4].split(': ')[1].split(', ')
        scale_raw = lines[5].split(': ')[1].split(', ')

        # Convert to Unreal Vectors (Z-Up conversion)
        location = unreal.Vector(float(pos_raw[0]), float(pos_raw[1]), float(pos_raw[2]))
        rotation = unreal.Rotator(float(rot_raw[0]), float(rot_raw[1]), float(rot_raw[2]))
        scale = unreal.Vector(float(scale_raw[0]), float(scale_raw[1]), float(scale_raw[2]))

        # Find the matching asset in your UE Content Browser
        asset_name = name.split('_')[0] # Strips instance numbers (e.g. Aircon_1 -> Aircon)
        full_asset_path = PREFAB_PATH + asset_name
        
        # Spawn Actor
        unreal.EditorLevelLibrary.spawn_actor_from_path(full_asset_path, location, rotation)

print("BraxtigConfig: 11,269 Assets synchronized to UE 5.7 World Space.")
