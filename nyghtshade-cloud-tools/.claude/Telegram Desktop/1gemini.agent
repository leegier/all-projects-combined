LogPython: import unreal

# PATH SETTINGS

COORD_FILE = r"C:\Users\FRANK\Desktop\scene_assets_detail.txt"

PREFAB_PATH = "/Game/Assets/PrisonSet/Prefabs/" # Change to your actual content folder

def spawn_prison_assets():

    with open(COORD_FILE, 'r') as f:

        data = f.read()

    # Split into object blocks

    blocks = data.split("----------------------------------------")

    

    for block in blocks:

        if "NAME:" not in block: continue

        

        # Parse data lines

        lines = block.strip().split('\n')

        name = lines[0].split(': ')[1]

        pos_raw = lines[3].split(': ')[1].split(', ')

        rot_raw = lines[4].split(': ')[1].split(', ')

        scale_raw = lines[5].split(': ')[1].split(', ')

        # Convert to Unreal Vectors (Z-Up conversion)

        location = unreal.Vector(float(pos_raw[0]), float(pos_raw[1]), float(pos_raw[2]))

        rotation = unreal.Rotator(float(rot_raw[0]), float(rot_raw[1]), float(rot_raw[2]))

        scale = unreal.Vector(float(scale_raw[0]), float(scale_raw[1]), float(scale_raw[2]))

        # Find the matching asset in your UE Content Browser

        asset_name = name.split('_')[0] # Strips instance numbers (e.g. Aircon_1 -> Aircon)

        full_asset_path = PREFAB_PATH + asset_name

        

        # Spawn Actor

        unreal.EditorLevelLibrary.spawn_actor_from_path(full_asset_path, location, rotation)

print("BraxtigConfig: 11,269 Assets synchronized to UE 5.7 World Space.") // ABraxtigSecurityHub.cpp (UE 5.7)

void ABraxtigSecurityHub::OnPlayerOverlapDetector(AActor* OverlappedActor, AActor* OtherActor) {

    if (OtherActor->IsA(APlayerCharacter::StaticClass())) {

        // Access BraxtigConfig Heat Logic

        float HeatMultiplier = BraxtigConfig::GetGlobalHeatModifier();

        

        // Trigger Metal Detector (Bright Green/Purple Pulse)

        MetalDetectorMesh->SetVectorParameterValueOnMaterials("EmissiveColor", FLinearColor(0.5f, 0.0f, 1.0f)); // Purple

        

        // Spike suspicion in Sector 1

        BraxtigSubsystem->AddHeat(50.0f * HeatMultiplier);

        

        if (BraxtigSubsystem->GetHeat() > 75.0f) {

            WardenAI->SetAlertState(EAlertState::Lockdown);

        }

    }

}

void ABraxtigSecurityHub::TriggerPanelFlicker() {

    // Electrical Panel 2 Logic at (49.99, 237.39, 784.90)

    // Controls local sector lights

    SectorLights->StartFlicker(0.1f, 0.5f); // Fluorescent flicker

} 

