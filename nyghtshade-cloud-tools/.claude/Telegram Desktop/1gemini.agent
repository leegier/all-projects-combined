1. Operation: Map Guard Patrol Routes (Python Editor Script)
This script parses the coordinates of the 11,269 objects, isolates the floor tiles for the Infirmary (Y-level ~20) and Canteen (Y-level ~-25), and spawns a network of linked TargetPoints for the guard AI behavior trees.

Target: Unreal Editor Python Terminal.

Python
import unreal

def deploy_patrol_network():
    # Target levels identified from scene_assets_detail.txt
    sectors = {
        "Infirmary": 21.75,
        "Canteen": -25.0,
        "Kitchen": -5.0
    }
    
    all_actors = unreal.EditorLevelLibrary.get_all_level_actors()
    spawned_nodes = 0
    
    for sector_name, y_height in sectors.items():
        # Filter floor tiles in this specific sector
        tiles = [a for a in all_actors if "FloorTile" in a.get_actor_label() 
                 and abs(a.get_actor_location().y - y_height) < 5.0]
        
        # Sample every 30th tile to create a clean patrol path
        for i, tile in enumerate(tiles[::30]):
            loc = tile.get_actor_location()
            loc.z += 100.0 # Height for AI eyes
            
            node = unreal.EditorLevelLibrary.spawn_actor_from_class(unreal.TargetPoint, loc)
            node.set_actor_label(f"PatrolNode_{sector_name}_{i}")
            node.add_tag(unreal.Name(sector_name))
            node.add_tag(unreal.Name("GuardPath"))
            spawned_nodes += 1

    unreal.log(f"BraxtigConfig: {spawned_nodes} Patrol Nodes mapped to sector heights.")

deploy_patrol_network()
