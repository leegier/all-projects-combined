3. Nightshade Stealth Mechanic (Character Logic)
This component handles the "Shadow Stealth." It calculates your visibility based on local lights (Lumen) and reduces your footstep noise if the SpinFans are at high RPM.

C++
// NightshadeStealthComponent.cpp
void UNightshadeStealthComponent::CalculateVisibility() {
    float LightLevel = GetOwner()->GetWorld()->GetParameterCollectionInstance(LightingCollection)->GetScalarParameter("GlobalLux");
    
    // Industrial Fan Occlusion Logic
    // Coordinates: (400, 283, 204) - PrisonVentOne_70
    if (AreFansAtMaxRPM()) {
        OwnerCharacter->SetNoiseModifier(0.1f); // Footsteps are 90% quieter
    } else {
        OwnerCharacter->SetNoiseModifier(1.0f);
    }
}
