$IgnoreContent = @"
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
*.sln
*.xcworkspace
"@
$IgnoreContent | Out-File -FilePath ".gitignore" -Encoding utf8 -Force

