1. Operation: Optimize the 11k Mesh Cluster (Python)
Because you have over 11,000 objects and 16GB of RAM, your editor will crash during the build process if they are standard meshes. This script forces Nanite and Lumen compatibility across your entire library.

Target: Paste this into the Unreal Python Terminal.

Python
import unreal

# PATH TO YOUR PREFABS
PREFAB_FOLDER = "/Game/Assets/PrisonSet/Prefabs/"

def stabilize_dev_boxx():
    asset_registry = unreal.AssetRegistryHelpers.get_asset_registry()
    asset_list = asset_registry.get_assets_by_path(PREFAB_FOLDER, recursive=True)
    
    mesh_count = 0
    for asset_data in asset_list:
        asset = asset_data.get_asset()
        if isinstance(asset, unreal.StaticMesh):
            # Enable Nanite (Vital for 16GB RAM)
            nanite_settings = unreal.MeshNaniteSettings(enabled=True)
            asset.set_editor_property("nanite_settings", nanite_settings)
            
            # Enable Distance Fields for Lumen Lighting
            asset.set_editor_property("generate_mesh_distance_field", True)
            
            unreal.EditorAssetLibrary.save_asset(asset.get_path_name())
            mesh_count += 1
            
    unreal.log(f"BraxtigConfig: {mesh_count} meshes stabilized with Nanite. Frame rate secured.")

stabilize_dev_boxx()
