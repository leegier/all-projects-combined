# BRAXTIG BUILD PROTOCOL V1
$UEPath = "C:\Program Files\Epic Games\UE_5.3\Engine\Build\BatchFiles\RunUAT.bat"
$ProjPath = "C:\Users\FRANK\Documents\Unreal Projects\pickelsmodin\pickelsmodin.uproject"
$OutDir = "C:\Users\FRANK\Desktop\Nyghtshade_Build_V1"

Write-Host "BraxtigConfig: Compiling Nyghtshade Hollow Level 1..." -ForegroundColor Cyan

# Force Nanite Build for all prefabs in allpre.fbx
& "$($UEPath.Replace('RunUAT.bat', '..\Binaries\Win64\UnrealEditor-Cmd.exe'))" $ProjPath -run=DerivedDataCache -fill

# Execute Full Standalone Package
& $UEPath BuildCookRun `
    -project=$ProjPath -noP4 -platform=Win64 -clientconfig=Shipping `
    -cook -allmaps -build -stage -pak -archive -archivedirectory=$OutDir

Write-Host "SUCCESS: Nyghtshade_Build_V1.exe generated on Desktop." -ForegroundColor Green
