PS C:\Users\FRANK>

PS C:\Users\FRANK> # 2. Set the path to your .blend file

PS C:\Users\FRANK> $blendFile = ".\pickels.blend"

PS C:\Users\FRANK>

PS C:\Users\FRANK> # 3. Define the Python code that Blender will run internally

PS C:\Users\FRANK> $pythonScript = @"

>> import bpy

>> print('\n' + '='*50)

>> print('DETAILED ASSET LISTING')

