$PROJECT = "C:\Users\FRANK\Documents\Unreal Projects\pickelsmodin\pickelsmodin.uproject"

Write-Host "BraxtigConfig: Preparing Final Build for Nyghtshade Hollow..." -ForegroundColor Cyan

# 1. Clean previous build artifacts
Remove-Item -Recurse -Force "Saved/StagedBuilds", "Binaries/Win64"

# 2. Force Build Nanite Data
& "$UE_ROOT\Engine\Binaries\Win64\UnrealEditor-Cmd.exe" $PROJECT -run=DerivedDataCache -fill

# 3. Package the Project
& "$UE_ROOT\Engine\Build\BatchFiles\RunUAT.bat" BuildCookRun `
    -project=$PROJECT -noP4 -platform=Win64 -clientconfig=Development `
    -cook -allmaps -build -stage -pak -archive -archivedirectory="C:\Users\FRANK\Desktop\Nyghtshade_Build_V1"

