import unreal

def execute_lockdown_protocol():
    # 1. Trigger Panel Flicker
    panel = unreal.EditorLevelLibrary.get_all_level_actors_relevancy_filter("PrisonElectricalPanel_2")
    
    # 2. Force Close All Doors (Braxtig Protocol .2.txt)
    doors = [d for d in unreal.EditorLevelLibrary.get_all_level_actors() if "Door" in d.get_actor_label()]
    for door in doors:
        door.set_editor_property("DoorState", "FORCED_CLOSED")
        door.set_actor_enable_collision(True) # Block all movement
        
    unreal.log("BraxtigConfig: Sector 1 Panel Triggered. LOCKDOWN ACTIVE.")

execute_lockdown_protocol()
