// HospitalLamp: (-941.0, 20.0, -2237.0)

void UBraxtigSecuritySubsystem::RegisterInfractionZone(FString AssetName, float HeatSpike) {
    InfractionRegistry.Add(AssetName, HeatSpike);
}

void UBraxtigSecuritySubsystem::ReportTampering(FString AssetName) {
    if (InfractionRegistry.Contains(AssetName)) {
        float Spike = InfractionRegistry[AssetName];
        GlobalHeatLevel += Spike;
        
        if (GlobalHeatLevel > 75.0f) {
            // Trigger Warden Arianna Gier's lockdown sequence
            ExecuteLockdownProtocol();
        }
    }
}
