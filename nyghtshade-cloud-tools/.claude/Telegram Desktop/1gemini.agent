import unreal
import os

# CONFIGURATION
COORD_FILE = r"C:\Users\FRANK\Desktop\scene_assets_detail.txt"
# IMPORTANT: Ensure this folder exists in your Content Browser first!
PREFAB_PATH = "/Game/Assets/PrisonSet/Prefabs/" 

def spawn_prison_assets():
    if not os.path.exists(COORD_FILE):
        unreal.log_error(f"BraxtigConfig: Coordinate file not found at {COORD_FILE}")
        return

    with open(COORD_FILE, 'r') as f:
        data = f.read()

    # Split into object blocks
    blocks = data.split("----------------------------------------")
    spawn_count = 0
    
    for block in blocks:
        if "NAME:" not in block: 
            continue
        
        try:
            # Parse data lines
            lines = [l.strip() for l in block.strip().split('\n') if l.strip()]
            name = lines[0].split(': ')[1]
            pos_raw = lines[2].split(': ')[1].split(', ')
            rot_raw = lines[3].split(': ')[1].split(', ')
            
            # Unreal uses Centimeters. Convert coordinates if they seem too small.
            location = unreal.Vector(float(pos_raw[0]), float(pos_raw[1]), float(pos_raw[2]))
            rotation = unreal.Rotator(float(rot_raw[0]), float(rot_raw[1]), float(rot_raw[2]))

            # Logic: Strips instance numbers (e.g. Aircon_1 -> Aircon)
            asset_name = name.split('_')[0].split('.')[0] 
            full_asset_path = f"{PREFAB_PATH}{asset_name}.{asset_name}"
            
            # Spawn the Actor
            spawned_actor = unreal.EditorLevelLibrary.spawn_actor_from_path(full_asset_path, location, rotation)
            if spawned_actor:
                spawn_count += 1
        except Exception as e:
            unreal.log_warning(f"Failed to spawn {name}: {str(e)}")

    unreal.log(f"BraxtigConfig: {spawn_count} Assets synchronized to World Space.")

# EXECUTE THE SPAWNER
spawn_prison_assets()
