PINIKO_RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
"https://api.piniko.com/v1/projects/${PINIKO_PROJECT_ID}/uploads" \
-H "Authorization: Bearer $PINIKO_API_KEY" \
-F "file=@../$ZIP_FILE" \
-F "version=$VERSION" \
-F "notes=Release ${VERSION} of ${PROJECT_NAME}")

