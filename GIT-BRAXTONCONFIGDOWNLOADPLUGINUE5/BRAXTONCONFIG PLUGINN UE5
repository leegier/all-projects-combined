FJsonSerializer::Serialize(Obj.ToSharedRef(), Writer);
PostJson(TEXT("parse"), Payload, [Callback](bool bOk, const FString& Resp) {
if (Callback) Callback(bOk, Resp);
if (bOk) UE_LOG(LogTemp, Log, TEXT("ParseFile response: %s"), *Resp);
});
}

