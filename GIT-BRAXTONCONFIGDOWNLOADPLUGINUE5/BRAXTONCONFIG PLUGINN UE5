# ============================================
# Smart Deploy with Test Reporting + Auto-Rollback
# Nyghtshade-BraxtonConfig v1.0.0
# ============================================

PROJECT_NAME="Nyghtshade-BraxtonConfig"
VERSION="v1.0.0"
