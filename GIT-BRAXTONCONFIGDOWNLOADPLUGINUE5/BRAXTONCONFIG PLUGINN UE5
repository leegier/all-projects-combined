{
TSharedPtr<FJsonObject> Obj = MakeShareable(new FJsonObject);
Obj->SetStringField(TEXT("event"), TEXT("parse_file"));
Obj->SetStringField(TEXT("path"), RelativePath);
Obj->SetStringField(TEXT("content"), Content);

FString Payload;
